{
  "schema": "archeaxis.authority-routes/v1",
  "scope": "Public repository document routing; not new business authority or global software configuration",
  "authority": "AUTHORITY.md",
  "active_pointer": "docs/current/AAOS-ACTIVE-EXECUTION.json",
  "decision_order": [
    "platform instructions",
    "current explicit Owner decision",
    "applicable AGENTS.md",
    "approved concern-specific normative contracts and supersession",
    "selected TaskPack within its explicit scope",
    "dated receipts and historical source inputs"
  ],
  "resolution_order": [
    "reject private/outside/traversal/reparse targets",
    "exact entry",
    "first matching rule",
    "UNCLASSIFIED_REFERENCE: no authority inferred"
  ],
