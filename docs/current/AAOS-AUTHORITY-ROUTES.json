  "rules": [
    {
      "pattern": "docs/history/conversation-summary-20261010/**",
      "role": "FROZEN_SOURCE_INPUT"
    },
    {
      "pattern": "docs/history/**",
      "role": "HISTORICAL_SOURCE_OR_RECEIPT"
    },
    {
      "pattern": "docs/authority/**",
      "role": "INHERITED_OR_FROZEN_CONTRACT_NOT_ACTIVE_QUEUE"
    },
    {
      "pattern": "docs/taskpacks/aaos-ui-first-20261009/**",
      "role": "SELECTED_IMMUTABLE_TASK_SOURCE_NOT_LIVE_STATE"
    },
    {
      "pattern": "docs/taskpacks/**",
      "role": "HISTORICAL_TASK_SOURCE_NOT_ACTIVE_QUEUE"
    },
    {
      "pattern": "docs/current/receipts/**",
      "role": "VERSION_BOUND_SCOPED_RECEIPT"
    },
    {
      "pattern": "docs/current/**",
      "role": "DATED_SCOPED_RECORD_NOT_AUTOMATIC_AUTHORITY"
    },
    {
      "pattern": "docs/architecture/imported-designs/**",
      "role": "IMPORTED_REFERENCE_NOT_AUTHORITY"
    },
    {
      "pattern": "docs/truth/**",
      "role": "CONCERN_RULE_REQUIRES_INDEX_AND_SUPERSESSION"
    },
    {
      "pattern": "docs/vnext-seed/**",
      "role": "INHERITED_SPEC_REQUIRES_CURRENT_CONTRACT"
    },
    {
      "pattern": "*.md",
      "role": "REFERENCE_REQUIRES_CONCERN_AUTHORITY"
    },
    {
      "pattern": "*.txt",
      "role": "SOURCE_INPUT_NOT_EXECUTION_GRANT"
    },
    {
      "pattern": "docs/**",
      "role": "REFERENCE_REQUIRES_CONCERN_AUTHORITY"
    }
  ],
  "aliases": [
    {
      "old_path": "docs/operations/digest-canonicalization.md",
      "canonical_path": "docs/vnext-seed/operations/digest-canonicalization.md",
      "policy": "locator migration only; never recreate duplicate normative text"
    }
  ],
  "consumer_policy": {
    "search_hit": "classify path before accepting rules/status/authorization",
    "old_branch_or_export": "require fresh repository snapshot or mark stale/unverified; no promise of rewriting immutable third-party copies",
    "local_absolute_path": "machine-local locator only; cloud consumers use repository-relative public paths",
    "unknown_reference": "AUTHORITY_REFERENCE_MISSING or UNVERIFIED; do not invent authority",
    "frozen_source": "never auto-activate",
    "product_execution": "resolve active_pointer.execution_control; selected_tasks alone never resumes"
  },
  "software_adapters": {
    "AGENTS.md": "Codex/Qoder/AGENTS-compatible tools",
    "CLAUDE.md": "Claude Code project instructions",
    "GEMINI.md": "Gemini CLI project context",
    ".github/copilot-instructions.md": "GitHub Copilot repository instructions",
    "qualification": "Files wired and checked; actual per-software context load/runtime not tested"
  }
