@echo off
REM Project-local environment boundary for Cognitive-Loop-OS.
set "PROJECT_ROOT=%~dp0.."
for %%I in ("%PROJECT_ROOT%") do set "PROJECT_ROOT=%%~fI"
set "RUNTIME_ROOT=%PROJECT_ROOT%\.hermes\task-runtime"
set "CACHE_ROOT=%RUNTIME_ROOT%\cache"
set "TMP_ROOT=%RUNTIME_ROOT%\tmp"

if not exist "%RUNTIME_ROOT%" mkdir "%RUNTIME_ROOT%"
if not exist "%CACHE_ROOT%" mkdir "%CACHE_ROOT%"
if not exist "%TMP_ROOT%" mkdir "%TMP_ROOT%"
if not exist "%RUNTIME_ROOT%\runtime" mkdir "%RUNTIME_ROOT%\runtime"
if not exist "%RUNTIME_ROOT%\logs" mkdir "%RUNTIME_ROOT%\logs"
if not exist "%RUNTIME_ROOT%\pycache" mkdir "%RUNTIME_ROOT%\pycache"
if not exist "%CACHE_ROOT%\uv" mkdir "%CACHE_ROOT%\uv"
if not exist "%CACHE_ROOT%\pip" mkdir "%CACHE_ROOT%\pip"
if not exist "%CACHE_ROOT%\npm" mkdir "%CACHE_ROOT%\npm"
if not exist "%CACHE_ROOT%\playwright-browsers" mkdir "%CACHE_ROOT%\playwright-browsers"
if not exist "%CACHE_ROOT%\cargo-home" mkdir "%CACHE_ROOT%\cargo-home"

set "COGNITIVE_DATA_DIR=%RUNTIME_ROOT%\runtime"
set "TMP=%TMP_ROOT%"
set "TEMP=%TMP_ROOT%"
set "TMPDIR=%TMP_ROOT%"
set "PYTHONPYCACHEPREFIX=%RUNTIME_ROOT%\pycache"
set "UV_CACHE_DIR=%CACHE_ROOT%\uv"
set "PIP_CACHE_DIR=%CACHE_ROOT%\pip"
set "NPM_CONFIG_CACHE=%CACHE_ROOT%\npm"
set "PLAYWRIGHT_BROWSERS_PATH=%CACHE_ROOT%\playwright-browsers"
set "CARGO_HOME=%CACHE_ROOT%\cargo-home"
set "HERMES_PROJECT_ROOT=%PROJECT_ROOT%"
set "HERMES_PROJECT_RUNTIME_ROOT=%RUNTIME_ROOT%"
set "HERMES_PROJECT_ARTIFACTS=%PROJECT_ROOT%\.hermes\task-artifacts"
set "HERMES_PROJECT_LOGS=%RUNTIME_ROOT%\logs"
