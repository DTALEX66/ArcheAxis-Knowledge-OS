+    assert_eq!(archeaxis_domain::learning::item_display_title(&read_only, "fixed-card").unwrap(),
+               "固定 摘要 内容");
+    drop(read_only);
+    drop(conn);
+    drop(router);
+    let reopened = app(db.to_str().unwrap()).unwrap();
