+                "null"
+              ]
+            }
+          },
+          "required": [
+            "kind",
+            "document_id",
+            "version",
+            "content_sha256",
+            "block_id"
+          ]
+        },
+        {
+          "type": "object",
+          "additionalProperties": false,
+          "properties": {
+            "kind": {
+              "const": "transform"
+            },
+            "source_id": {
