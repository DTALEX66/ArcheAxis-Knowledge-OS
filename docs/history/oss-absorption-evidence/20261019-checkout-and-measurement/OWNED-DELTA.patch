+            "raw_sha256": {
+              "type": "string",
+              "pattern": "^[a-f0-9]{64}$"
+            },
+            "job_id": {
+              "type": "string",
+              "minLength": 1,
+              "maxLength": 200
+            },
+            "transform_id": {
+              "type": "integer",
+              "minimum": 1
+            },
+            "transform_sha256": {
+              "type": "string",
+              "pattern": "^[a-f0-9]{64}$"
+            }
+          },
+          "required": [
+            "kind",
+            "source_id",
+            "raw_sha256",
+            "job_id",
+            "transform_id",
+            "transform_sha256"
+          ]
+        }
+      ]
+    },
+    "MaterialSelectionDto": {
+      "type": "object",
