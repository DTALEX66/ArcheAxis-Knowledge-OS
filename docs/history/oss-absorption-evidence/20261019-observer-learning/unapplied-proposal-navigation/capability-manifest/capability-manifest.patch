+// Generated from capability-package.schema.json; declaration only, no runtime authority.
+// schema_sha256=248b38fbaf6ce16b87e7acdd4395f4515ba082977da0d6538fe8c14f9ac02d2f
+export type CapabilityPackageId = string;
+export type CapabilityPackageVersion = string;
+export type CapabilityContributionPoint = "format_conversion" | "template" | "learning_activity" | "graph_visual" | "model_service" | "tool_protocol";
+export type CapabilityManifestIdentity = { schema: "archeaxis.capability-package/v1"; package_id: CapabilityPackageId; version: CapabilityPackageVersion; sha256: string };
+export type CapabilityPublicSourceReference = { path: string; sha256: string };
+export type CapabilityVersionRange = { minimum: CapabilityPackageVersion; maximum_exclusive: CapabilityPackageVersion };
+export type CapabilityPackageDependency = { resource_key: string; requirement: "required" | "optional"; version_range: CapabilityVersionRange | null };
+export type CapabilityDataContract = { kind: "raw_asset_reference" | "document_reference" | "source_anchor" | "text" | "learning_candidate" | "graph_projection" | "model_context" | "tool_request" | "receipt"; contract: CapabilityPublicSourceReference; max_bytes: number };
+export type CapabilityPackagePermissions = { requested: Array<"selected_source.read" | "derived_artifact.propose" | "learning_activity.propose" | "graph_projection.propose" | "model.local.invoke" | "model.remote.invoke" | "tool.protocol.connect">; data_scope: "explicit_selected_objects_only"; network: "none" | "loopback" | "explicit_remote"; cost: "none" | "may_charge"; explicit_grant_required: true; canonical_writer: "rust_core_only"; credential_handling: "host_reference_only"; local_to_cloud_fallback: "explicit_grant_only"; grants_execution: false; grants_knowledge_acceptance: false };
+export type CapabilityPackageLifecycle = { cancellation: "host_propagated" | "not_applicable"; exit: "bounded_cleanup" | "not_applicable"; timeout_ms: number; unknown_result: "preserve_unknown_no_auto_retry"; cleanup_evidence: "required_before_confirmed_exit" };
+export type CapabilityPackageFallback = { mode: "unavailable" | "degraded"; losses: Array<"structure" | "layout" | "source_anchors" | "fidelity" | "capability_subset">; automatic: false };
+export type CapabilityPackageUpdatePolicy = { strategy: "reviewed_replacement_only"; rollback: "preserve_previous_identity_and_originals"; canonical_data_migration: false };
+export type CapabilityPackageLicense = { expression: string | null; review: "UNVERIFIED" | "DECLARED_ONLY"; notice_refs: Array<CapabilityPublicSourceReference> };
+export type CapabilityPackageManifest = { schema: "archeaxis.capability-package/v1"; declaration: "DECLARATION_ONLY"; package_id: CapabilityPackageId; version: CapabilityPackageVersion; capability_ids: Array<"CAP-0010" | "CAP-0020" | "CAP-0030" | "CAP-0040" | "CAP-0050" | "CAP-0060" | "CAP-0070" | "CAP-0080" | "CAP-0090" | "CAP-0100" | "CAP-0110" | "CAP-0120" | "CAP-0130" | "CAP-0140" | "CAP-0150" | "CAP-0160">; resource_keys: Array<string>; contribution_points: Array<CapabilityContributionPoint>; compatibility: { host_versions: CapabilityVersionRange; contract_refs: Array<CapabilityPublicSourceReference> }; runtime_capabilities: Array<string>; permissions: CapabilityPackagePermissions; dependencies: Array<CapabilityPackageDependency>; license: CapabilityPackageLicense; inputs: Array<CapabilityDataContract>; outputs: Array<CapabilityDataContract>; lifecycle: CapabilityPackageLifecycle; fallback: CapabilityPackageFallback; update: CapabilityPackageUpdatePolicy };
