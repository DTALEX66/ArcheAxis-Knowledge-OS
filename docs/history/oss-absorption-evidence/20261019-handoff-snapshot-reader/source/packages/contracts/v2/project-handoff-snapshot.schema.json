{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archeaxis.project-handoff-snapshot/v1",
  "type": "object", "additionalProperties": false,
  "properties": {
    "schema": {"const": "archeaxis.project-handoff-snapshot/v1"},
    "checked_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "expires_at_ms": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "producer": {"$ref": "project-handoff.schema.json#/$defs/ProducerIdentity"},
    "reference": {"$ref": "project-handoff.schema.json#/$defs/ObjectReference"},
    "reference_state": {"enum": ["CURRENT", "STALE"]},
    "source_authentication": {"const": "UNVERIFIED"},
    "selection_qualification": {"const": "UNVERIFIED"},
    "scope": {"const": "LOCAL_HUMAN_READ_ONLY"},
    "editor_json": {"type": "object", "properties": {"type": {"const": "doc"}}, "required": ["type"]},
    "grants_execution": {"const": false}, "grants_knowledge_acceptance": {"const": false}
  },
  "required": ["schema", "checked_at_ms", "expires_at_ms", "proposal_sha256", "producer", "reference", "reference_state", "source_authentication", "selection_qualification", "scope", "editor_json", "grants_execution", "grants_knowledge_acceptance"]
}
