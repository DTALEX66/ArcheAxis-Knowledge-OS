+export function canonicalSurface(spaceId: SpaceId, desktop: boolean): CanonicalSurface {
+  void desktop;
+  switch (spaceId) {
+    case "workspace": return "canonical_workspace";
+    case "settings":
+      return "canonical_capabilities";
+    case "library":
+    case "intake":
+    case "exchange":
+      return "canonical_library";
