+        assert_eq!(
+            decoded.require_runtime_dependency("pdf.extract").err(),
+            reason
+        );
+    }
+    for dependency in [
+        Value::Null,
+        json!({"name":"pymupdf","status":"AVAILABLE","version":null}),
+        json!({"name":"pymupdf","status":"AVAILABLE","version":"pymupdf"}),
