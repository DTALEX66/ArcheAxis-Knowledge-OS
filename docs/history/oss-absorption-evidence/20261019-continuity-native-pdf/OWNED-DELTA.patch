+    let session = journal["session_id"].clone();
+    journal["events"].as_array_mut().ok_or_else(||error("events_invalid"))?.push(json!({"session_id":session,"request_id":request,"sequence":sequence,"kind":kind,"data":data,"delivery":"BUFFERED"}));
