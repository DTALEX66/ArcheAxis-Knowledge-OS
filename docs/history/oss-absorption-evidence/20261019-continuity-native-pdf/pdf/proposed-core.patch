+async fn static_unknown_pdf_can_execute_with_live_version_and_qualify_its_file() {
+    let d = tempfile::tempdir().unwrap();
+    let repo = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../..");
+    let python = PathBuf::from(std::env::var_os("ARCHEAXIS_PYTHON").expect("declared Python"));
+    let generated = std::process::Command::new(&python).args(["-B","-c",
+        "import pymupdf,sys;d=pymupdf.open();d.new_page().insert_text((72,100),'PDF qualification 6371 km');sys.stdout.buffer.write(d.tobytes())"]).output().unwrap();
+    assert!(generated.status.success(),"required project PDF dependency missing");
+    let e = archeaxis_application::executor::Executor::open_routes(&d.path().join("db"),&d.path().join("staging"),&python,
+        &repo.join("services/python-workers/transport/text_ndjson.py"),&[("pdf.extract",repo.join("services/python-workers/document/worker_pdf.py"))]).await.unwrap();
+    let app = archeaxis_api::runtime::router(e.clone());
+    let (_,static_read) = call(&app,"POST","/api/v1/operation-readiness",json!({"scope":"pdf-before-run","operations":["pdf.extract"]})).await;
+    assert_eq!(static_read["operations"][0]["dependencies"],"UNKNOWN");
+    archeaxis_api::runtime::readiness::require_execution_dependencies(&e,"pdf.extract").await.unwrap();
+    let (status,import) = call(&app,"POST","/api/v1/imports",json!({"name":"controlled.pdf","content_base64":base64::engine::general_purpose::STANDARD.encode(generated.stdout)})).await;
+    assert_eq!(status,StatusCode::ACCEPTED,"{import}");
+    let source = import["source_id"].as_str().unwrap();
+    let (status,_) = call(&app,"POST","/api/v1/jobs",json!({"job_id":"pdf-current","kind":"pdf","input_ref":source})).await;
+    assert_eq!(status,StatusCode::ACCEPTED);
+    let (status,started) = call(&app,"POST","/api/v1/jobs/pdf-current/executions",json!({"deadline_ms":30000})).await;
+    assert_eq!(status,StatusCode::ACCEPTED,"{started}");
+    tokio::time::timeout(Duration::from_secs(30),async {
+        loop {
+            let (_,job) = call(&app,"GET","/api/v1/jobs/pdf-current",Value::Null).await;
+            if job["state"] == "succeeded" || job["state"] == "failed" { assert_eq!(job["state"],"succeeded","{job}");break; }
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    }).await.unwrap();
+    let (status,qualified) = call(&app,"GET",&format!("/api/v1/sources/{source}/jobs/pdf-current/format-qualification"),Value::Null).await;
+    assert_eq!(status,StatusCode::OK);
+    assert_eq!(qualified["operations"]["extract"]["status"],"QUALIFIED","{qualified}");
