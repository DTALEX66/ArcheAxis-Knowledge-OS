+    let saved: String = e.store().submit_wait(|c|c.query_row("SELECT content FROM job_outputs WHERE job_id='pdf-current' AND kind='loss_report'",[],|r|r.get(0))).await.unwrap().unwrap();
+    let loss: Value = serde_json::from_str(&saved).unwrap();
+    assert_eq!(loss["engine_version"],qualified["engine_version"]);
+    assert_eq!(loss["params"]["runtime_dependency"]["version"],qualified["engine_version"]);
+    assert_eq!(qualified["operations"]["roundtrip"]["status"],"UNVERIFIED");
+}
