{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archeaxis.local/project/schemas/authority-grant.schema.json",
  "title": "ArcheAxis Remote-Verifiable Authority Grant",
  "description": "CI-verifiable authorization. This is distinct from the Git-common-dir coordination lock.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "state", "grant_id", "plan_id", "program_task_id",
    "task_id", "issuance_id", "envelope_sha256", "subject_base_sha", "holder",
    "issuer", "protected_resources", "issued_at", "expires_at", "revoked_at"
  ],
  "$defs": {
    "taskId": {"type": "string", "pattern": "^PR-[0-9]{2,3}[A-Z]?(?:-S[0-9]{2})?$"},
    "programTaskId": {"type": "string", "pattern": "^PR-[0-9]{2,3}[A-Z]?$"},
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "properties": {
    "schema": {"const": "archeaxis.authority-grant/v1"},
    "schema_version": {"const": 1},
    "state": {"const": "issued"},
    "grant_id": {"type": "string", "pattern": "^GRANT-[A-Za-z0-9._-]{8,80}$"},
    "plan_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,80}$"},
    "program_task_id": {"$ref": "#/$defs/programTaskId"},
    "task_id": {"$ref": "#/$defs/taskId"},
    "issuance_id": {"type": "string", "pattern": "^ISS-[A-Za-z0-9._-]{8,80}$"},
    "envelope_sha256": {"$ref": "#/$defs/sha256"},
    "subject_base_sha": {"$ref": "#/$defs/sha40"},
    "holder": {"type": "string", "minLength": 1, "maxLength": 200},
    "issuer": {"type": "string", "minLength": 1, "maxLength": 200},
    "protected_resources": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "revoked_at": {"const": null, "description": "Issued grants are immutable; a later authority-revocation/v1 record performs revocation."},
    "reason": {"type": "string", "maxLength": 1000}
  }
}
