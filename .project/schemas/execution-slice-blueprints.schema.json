{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archeaxis.local/project/schemas/execution-slice-blueprints.schema.json",
  "title": "ArcheAxis JIT Execution Slice Blueprints",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "plan_id", "program_graph_path",
    "non_authorizing", "limits", "materialization_rules",
    "default_execution_mode", "qualification_no_diff", "task_trains",
    "single_slice_candidates"
  ],
  "$defs": {
    "programTaskId": {"type": "string", "pattern": "^PR-[0-9]{2,3}[A-Z]?$"},
    "sliceRef": {"type": "string", "pattern": "^PR-[0-9]{2,3}[A-Z]?:(?:single|[a-z0-9][a-z0-9-]{2,80})$"},
    "lane": {"enum": ["owner", "contract", "rust-core", "rust-store", "avalonia-ui", "python-worker", "journey", "migration", "ci", "release"]},
    "manifestExpansion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "policy_id", "manifest_path", "manifest_digest_profile",
        "selector_field", "required_decision", "required_status",
        "source_paths_requirement", "expansion_base", "issued_scope_paths",
        "partition_order", "max_paths_per_slice", "pseudo_paths_forbidden"
      ],
      "properties": {
        "mode": {"const": "digest-bound-manifest-expansion"},
        "policy_id": {"const": "PR-32-legacy-retirement-v1"},
        "manifest_path": {"const": "LEGACY_MANIFEST.yaml"},
        "manifest_digest_profile": {"const": "AAK-JCS-1"},
        "selector_field": {"const": "asset_id"},
        "required_decision": {"const": "retire"},
        "required_status": {"const": "approved"},
        "source_paths_requirement": {"const": "census-expanded-exact-paths-no-globs"},
        "expansion_base": {"const": "issued-subject-base"},
        "issued_scope_paths": {"const": "exact-expanded-paths-only"},
        "partition_order": {"const": "normalized-path-byte-order"},
        "max_paths_per_slice": {"const": 25},
        "pseudo_paths_forbidden": {"const": true}
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slice_key", "execution_lane", "goal"],
      "properties": {
        "slice_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"},
        "execution_lane": {"$ref": "#/$defs/lane"},
        "goal": {"type": "string", "minLength": 8},
        "manifest_expansion": {"$ref": "#/$defs/manifestExpansion"},
        "resource_gate_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["clean_windows_11", "isolated_legacy_copy", "explicit_network_and_credentials", "rights_and_license_approval"]}
        },
        "resource_hint": {"type": "string", "minLength": 2}
      },
      "allOf": [
        {
          "if": {
            "properties": {"slice_key": {"const": "aggregate-retirement"}},
            "required": ["slice_key"]
          },
          "then": {"required": ["manifest_expansion"]}
        }
      ]
    },
    "train": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/slice"}
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_lane", "goal", "promote_to_train_when"],
      "properties": {
        "execution_lane": {"$ref": "#/$defs/lane"},
        "goal": {"type": "string", "minLength": 8},
        "promote_to_train_when": {"type": "string", "minLength": 8}
      }
    }
  },
  "properties": {
    "schema": {"const": "archeaxis.execution-slice-blueprints/v1"},
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "minLength": 3},
    "program_graph_path": {"const": ".project/TASK-GRAPH.yaml"},
    "non_authorizing": {"const": true},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_files", "max_effort_hours", "max_elapsed_hours", "max_execution_lanes", "max_serial_resource_families"],
      "properties": {
        "max_files": {"const": 25},
        "max_effort_hours": {"const": 16},
        "max_elapsed_hours": {"const": 48},
        "max_execution_lanes": {"const": 1},
        "max_serial_resource_families": {"const": 1}
      }
    },
    "materialization_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "default_execution_mode": {"const": "implementation"},
    "qualification_no_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_mode", "repository_diff", "repository_access", "outputs", "defect_handling", "slice_refs"],
      "properties": {
        "execution_mode": {"const": "qualification-no-diff"},
        "repository_diff": {"const": "zero-from-activation-to-subject-head"},
        "repository_access": {"const": "read-only"},
        "outputs": {"const": "job-scratch-or-external-attestation-only"},
        "defect_handling": {"const": "fail-or-block-and-issue-new-owning-lane-implementation-slice"},
        "slice_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/sliceRef"}
        }
      }
    },
    "task_trains": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/programTaskId"},
      "additionalProperties": {"$ref": "#/$defs/train"}
    },
    "single_slice_candidates": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/programTaskId"},
      "additionalProperties": {"$ref": "#/$defs/candidate"}
    }
  }
}
