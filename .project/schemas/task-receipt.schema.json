{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archeaxis.local/project/schemas/task-receipt.schema.json",
  "title": "ArcheAxis Exact-SHA External Task Receipt",
  "description": "CI attestation over a subject head. It is not committed into the head it attests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "plan_id", "program_task_id", "task_id",
    "issuance_id", "status", "attestor", "envelope_sha256", "envelope_blob_oid",
    "activation_sha", "subject_base_sha", "evaluated_base_sha", "subject_head_sha",
    "subject_tree_sha", "program_graph_sha256", "program_acceptance_refs",
    "program_evidence_refs", "authority_manifest_sha256", "consumed_interfaces_sha256",
    "gate_registry_sha256", "gate_plan_sha256", "authority_grant_ids", "agent",
    "execution", "changed_paths", "gates", "impact", "artifacts", "evidence",
    "risks", "known_uncertainties", "rollback", "rollback_verification",
    "attested_at", "receipt_payload_sha256"
  ],
  "$defs": {
    "taskId": {"type": "string", "pattern": "^PR-[0-9]{2,3}[A-Z]?(?:-S[0-9]{2})?$"},
    "programTaskId": {"type": "string", "pattern": "^PR-[0-9]{2,3}[A-Z]?$"},
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "oid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_EXECUTED"]}
  },
  "properties": {
    "schema": {"const": "archeaxis.task-receipt/v1"},
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "minLength": 3},
    "program_task_id": {"$ref": "#/$defs/programTaskId"},
    "task_id": {"$ref": "#/$defs/taskId"},
    "issuance_id": {"type": "string", "pattern": "^ISS-[A-Za-z0-9._-]{8,80}$"},
    "status": {"$ref": "#/$defs/status"},
    "attestor": {"type": "string", "minLength": 1, "maxLength": 300},
    "envelope_sha256": {"$ref": "#/$defs/sha256"},
    "envelope_blob_oid": {"$ref": "#/$defs/oid"},
    "activation_sha": {"$ref": "#/$defs/sha40"},
    "subject_base_sha": {"$ref": "#/$defs/sha40"},
    "evaluated_base_sha": {"$ref": "#/$defs/sha40"},
    "subject_head_sha": {"$ref": "#/$defs/sha40"},
    "subject_tree_sha": {"$ref": "#/$defs/sha40"},
    "program_graph_sha256": {"$ref": "#/$defs/sha256"},
    "program_acceptance_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^PR-[0-9]{2,3}[A-Z]?:A[0-9]{2}$"}
    },
    "program_evidence_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^PR-[0-9]{2,3}[A-Z]?:E[0-9]{2}$"}
    },
    "authority_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "consumed_interfaces_sha256": {"$ref": "#/$defs/sha256"},
    "gate_registry_sha256": {"$ref": "#/$defs/sha256"},
    "gate_plan_sha256": {"$ref": "#/$defs/sha256"},
    "authority_grant_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^GRANT-[A-Za-z0-9._-]{8,80}$"}
    },
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "executor", "version", "run_id"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "executor": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["branch", "worktree_id", "started_at", "finished_at", "tool_versions", "lockfile_digests", "fixture_digests", "runtime_tree_sha256"],
      "properties": {
        "branch": {"type": "string", "minLength": 1},
        "worktree_id": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "tool_versions": {"type": "object", "additionalProperties": {"type": "string"}},
        "lockfile_digests": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "fixture_digests": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "runtime_tree_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "changed_paths": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "operation", "before_blob", "after_blob"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "operation": {"enum": ["create", "modify", "delete", "rename", "chmod"]},
          "old_path": {"type": ["string", "null"]},
          "before_blob": {"oneOf": [{"$ref": "#/$defs/oid"}, {"type": "null"}]},
          "after_blob": {"oneOf": [{"$ref": "#/$defs/oid"}, {"type": "null"}]}
        }
      }
    },
    "gates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["gate_id", "required", "status", "command", "exit_code", "duration_ms", "artifact_sha256"],
        "properties": {
          "gate_id": {"type": "string", "minLength": 1},
          "required": {"const": true},
          "status": {"$ref": "#/$defs/status"},
          "command": {"type": ["string", "null"]},
          "exit_code": {"type": ["integer", "null"]},
          "duration_ms": {"type": "integer", "minimum": 0},
          "artifact_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
          "reason": {"type": ["string", "null"]}
        }
      }
    },
    "impact": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "migration", "packaging", "license", "data_writer", "user_data", "external_write"],
      "properties": {
        "contract": {"type": "boolean"},
        "migration": {"type": "boolean"},
        "packaging": {"type": "boolean"},
        "license": {"type": "boolean"},
        "data_writer": {"type": "boolean"},
        "user_data": {"type": "boolean"},
        "external_write": {"type": "boolean"}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "uri", "sha256", "media_type"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "uri": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "media_type": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "known_uncertainties": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "rollback": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rollback_verification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "attested_at": {"type": "string", "format": "date-time"},
    "receipt_payload_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 of RFC 8785 canonical JSON after removing this field; never a self-hash of bytes containing itself."
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
      "then": {
        "properties": {
          "gates": {
            "items": {
              "if": {"properties": {"required": {"const": true}}, "required": ["required"]},
              "then": {"properties": {"status": {"const": "PASS"}}}
            }
          }
        }
      }
    }
  ]
}
