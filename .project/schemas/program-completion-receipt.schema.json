{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archeaxis.local/project/schemas/program-completion-receipt.schema.json",
  "title": "ArcheAxis Program Completion Receipt",
  "description": "External aggregation attestation. Only PASS unlocks downstream Program nodes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "plan_id", "program_task_id", "status",
    "program_graph_sha256", "aggregated_main_sha", "aggregated_main_tree",
    "slice_receipts", "acceptance_coverage", "evidence_coverage",
    "unresolved_failures", "unresolved_superseded_issuances", "attestor", "attested_at",
    "receipt_payload_sha256"
  ],
  "$defs": {
    "programTaskId": {"type": "string", "pattern": "^PR-[0-9]{2,3}[A-Z]?$"},
    "taskId": {"type": "string", "pattern": "^PR-[0-9]{2,3}[A-Z]?(?:-S[0-9]{2})?$"},
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "properties": {
    "schema": {"const": "archeaxis.program-completion-receipt/v1"},
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "minLength": 3},
    "program_task_id": {"$ref": "#/$defs/programTaskId"},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "program_graph_sha256": {"$ref": "#/$defs/sha256"},
    "aggregated_main_sha": {"$ref": "#/$defs/sha40"},
    "aggregated_main_tree": {"$ref": "#/$defs/sha40"},
    "slice_receipts": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["task_id", "issuance_id", "subject_head_sha", "receipt_payload_sha256"],
        "properties": {
          "task_id": {"$ref": "#/$defs/taskId"},
          "issuance_id": {"type": "string", "pattern": "^ISS-[A-Za-z0-9._-]{8,80}$"},
          "subject_head_sha": {"$ref": "#/$defs/sha40"},
          "receipt_payload_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "acceptance_coverage": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^PR-[0-9]{2,3}[A-Z]?:A[0-9]{2}$"}
    },
    "evidence_coverage": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^PR-[0-9]{2,3}[A-Z]?:E[0-9]{2}$"}
    },
    "unresolved_failures": {"type": "array", "items": {"type": "string"}},
    "unresolved_superseded_issuances": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "attestor": {"type": "string", "minLength": 1},
    "attested_at": {"type": "string", "format": "date-time"},
    "receipt_payload_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 of RFC 8785 canonical JSON after removing this field."
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
      "then": {
        "properties": {
          "unresolved_failures": {"maxItems": 0},
          "unresolved_superseded_issuances": {"maxItems": 0}
        }
      }
    }
  ]
}
