{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archeaxis.local/project/schemas/task-template.schema.json",
  "title": "ArcheAxis Non-Authorizing Task Template",
  "description": "Validates a template only. Scope Gate must reject this schema as E001_TASK_NOT_ISSUED.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "state", "template_role", "plan_id", "program_task_id",
    "task_id", "slice_key", "issuance_id", "issuer", "assignee", "not_before", "issued_at", "expires_at",
    "subject_base_sha", "subject_base_tree", "execution_mode", "execution_lane", "task_kind",
    "priority", "risk", "objective", "depends_on", "dependency_program_receipts",
    "program_graph_sha256", "program_acceptance_refs", "program_evidence_refs",
    "preconditions", "machine_requirements", "artifact_inputs",
    "authority_manifest_sha256", "consumed_interfaces", "scope",
    "required_gate_ids", "gate_registry_sha256", "authority_grant_ids",
    "acceptance", "evidence_required", "rollback", "work_base_policy",
    "receipt_policy"
  ],
  "$defs": {
    "taskId": {"type": "string", "pattern": "^PR-[0-9]{2,3}[A-Z]?(?:-S[0-9]{2})?$"},
    "programTaskId": {"type": "string", "pattern": "^PR-[0-9]{2,3}[A-Z]?$"},
    "placeholderOrValue": {"type": "string", "minLength": 1}
  },
  "properties": {
    "schema": {"const": "archeaxis.task-template/v1"},
    "schema_version": {"const": 1},
    "state": {"const": "template"},
    "template_role": {"const": "program-blueprint"},
    "plan_id": {"type": "string", "minLength": 3},
    "program_task_id": {"$ref": "#/$defs/programTaskId"},
    "task_id": {"$ref": "#/$defs/taskId"},
    "slice_key": {"$ref": "#/$defs/placeholderOrValue"},
    "issuance_id": {"$ref": "#/$defs/placeholderOrValue"},
    "issuer": {"$ref": "#/$defs/placeholderOrValue"},
    "assignee": {"$ref": "#/$defs/placeholderOrValue"},
    "not_before": {"$ref": "#/$defs/placeholderOrValue"},
    "issued_at": {"$ref": "#/$defs/placeholderOrValue"},
    "expires_at": {"$ref": "#/$defs/placeholderOrValue"},
    "subject_base_sha": {"$ref": "#/$defs/placeholderOrValue"},
    "subject_base_tree": {"$ref": "#/$defs/placeholderOrValue"},
    "execution_mode": {
      "oneOf": [
        {"$ref": "task-envelope.schema.json#/properties/execution_mode"},
        {"const": "derive-from-slice-blueprint"}
      ]
    },
    "execution_lane": {
      "oneOf": [
        {"$ref": "task-envelope.schema.json#/properties/execution_lane"},
        {"const": "derive-from-slice-blueprint"}
      ]
    },
    "task_kind": {"$ref": "task-envelope.schema.json#/properties/task_kind"},
    "priority": {"$ref": "task-envelope.schema.json#/properties/priority"},
    "risk": {"$ref": "task-envelope.schema.json#/properties/risk"},
    "objective": {"type": "string", "minLength": 10},
    "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/taskId"}},
    "dependency_program_receipts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["program_task_id", "program_graph_sha256", "aggregated_main_sha", "aggregated_main_tree", "receipt_payload_sha256", "status"],
        "properties": {
          "program_task_id": {"$ref": "#/$defs/programTaskId"},
          "program_graph_sha256": {"$ref": "#/$defs/placeholderOrValue"},
          "aggregated_main_sha": {"$ref": "#/$defs/placeholderOrValue"},
          "aggregated_main_tree": {"$ref": "#/$defs/placeholderOrValue"},
          "receipt_payload_sha256": {"$ref": "#/$defs/placeholderOrValue"},
          "status": {"const": "PASS"}
        }
      }
    },
    "program_graph_sha256": {"$ref": "#/$defs/placeholderOrValue"},
    "program_acceptance_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^PR-[0-9]{2,3}[A-Z]?:A[0-9]{2}$"}},
    "program_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^PR-[0-9]{2,3}[A-Z]?:E[0-9]{2}$"}},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "machine_requirements": {"type": "object"},
    "artifact_inputs": {"type": "array"},
    "authority_manifest_sha256": {"$ref": "#/$defs/placeholderOrValue"},
    "consumed_interfaces": {
      "type": "object", "additionalProperties": false,
      "required": ["entries", "digest_sha256"],
      "properties": {
        "entries": {"type": "array"},
        "digest_sha256": {"$ref": "#/$defs/placeholderOrValue"}
      }
    },
    "manifest_scope": {"$ref": "task-envelope.schema.json#/properties/manifest_scope"},
    "scope": {"$ref": "task-envelope.schema.json#/properties/scope"},
    "required_gate_ids": {"$ref": "task-envelope.schema.json#/properties/required_gate_ids"},
    "gate_registry_sha256": {"$ref": "#/$defs/placeholderOrValue"},
    "authority_grant_ids": {"type": "array", "items": {"$ref": "#/$defs/placeholderOrValue"}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_required": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rollback": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "work_base_policy": {"const": "activation-commit-or-disjoint-descendant"},
    "receipt_policy": {"const": "external-exact-sha-ci-attestation"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"execution_mode": {"const": "qualification-no-diff"}},
        "required": ["execution_mode"]
      },
      "then": {
        "properties": {
          "authority_grant_ids": {"maxItems": 0},
          "scope": {
            "properties": {
              "allowed_operations": {"maxItems": 0},
              "allowed_paths": {"maxItems": 0},
              "limits": {
                "properties": {
                  "max_files": {"const": 0},
                  "max_added_lines": {"const": 0},
                  "max_deleted_lines": {"const": 0},
                  "max_binary_bytes": {"const": 0}
                }
              }
            }
          }
        }
      },
      "else": {
        "if": {
          "properties": {"execution_mode": {"const": "implementation"}},
          "required": ["execution_mode"]
        },
        "then": {
          "properties": {
            "scope": {
              "properties": {
                "allowed_operations": {"minItems": 1},
                "allowed_paths": {"minItems": 1},
                "limits": {"properties": {"max_files": {"minimum": 1}}}
              }
            }
          }
        }
      }
    }
  ]
}
