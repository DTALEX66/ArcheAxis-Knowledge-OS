{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archeaxis.local/project/schemas/authority-grant-template.schema.json",
  "title": "ArcheAxis Non-Authorizing Authority Grant Template",
  "description": "A template only; never a remote-verifiable grant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "state", "grant_id", "plan_id",
    "program_task_id", "task_id", "issuance_id", "envelope_sha256",
    "subject_base_sha", "holder", "issuer", "protected_resources",
    "issued_at", "expires_at", "revoked_at"
  ],
  "properties": {
    "schema": {"const": "archeaxis.authority-grant-template/v1"},
    "schema_version": {"const": 1},
    "state": {"const": "template"},
    "grant_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 3},
    "program_task_id": {"type": "string", "pattern": "^PR-[0-9]{2,3}[A-Z]?$"},
    "task_id": {"type": "string", "pattern": "^PR-[0-9]{2,3}[A-Z]?(?:-S[0-9]{2})?$"},
    "issuance_id": {"type": "string", "minLength": 1},
    "envelope_sha256": {"type": "string", "minLength": 1},
    "subject_base_sha": {"type": "string", "minLength": 1},
    "holder": {"type": "string", "minLength": 1},
    "issuer": {"type": "string", "minLength": 1},
    "protected_resources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "issued_at": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "minLength": 1},
    "revoked_at": {"type": "null"},
    "reason": {"type": "string"}
  }
}
