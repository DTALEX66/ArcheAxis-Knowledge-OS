# Copy to .env.container and replace every placeholder before starting Compose.
# .env.container is intentionally ignored and must not be committed.

COGNITIVE_API_KEY=
COGNITIVE_JWT_SECRET=
COGNITIVE_CORS_ORIGINS=https://cognitive.example.com
COGNITIVE_CORS_METHODS=GET,POST,DELETE,OPTIONS
COGNITIVE_CORS_HEADERS=Authorization,Content-Type,X-API-Key

COGNITIVE_DOMAIN=cognitive.example.com
CADDY_TLS_EMAIL=ops@example.com
CADDY_INTERNAL_HTTP_PORT=8080
CADDY_INTERNAL_HTTPS_PORT=8443

# Optional local overrides for CI or private test hosts.
COGNITIVE_IMAGE_TAG=local
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
