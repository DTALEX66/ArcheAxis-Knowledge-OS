ARG PYTHON_IMAGE=python:3.11.15-slim-bookworm@sha256:b18992999dbe963a45a8a4da40ac2b1975be1a776d939d098c647482bcad5cba
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.28@sha256:0f36cb9361a3346885ca3677e3767016687b5a170c1a6b88465ec14aefec90aa

FROM ${UV_IMAGE} AS uv-bin
FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_NO_PROGRESS=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update \
    && apt-get install --yes --no-install-recommends git openssh-client ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 cognitive \
    && useradd --uid 1000 --gid cognitive --create-home --home-dir /home/cognitive cognitive \
    && mkdir -p /opt/venv /workspace \
    && chown -R cognitive:cognitive /opt/venv /workspace /home/cognitive

COPY --from=uv-bin /uv /usr/local/bin/uv

WORKDIR /opt/dependencies
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --extra dev --no-install-project

WORKDIR /workspace
USER cognitive

CMD ["sleep", "infinity"]
