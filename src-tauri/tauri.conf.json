{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArcheAxis Knowledge",
  "version": "0.6.0",
  "identifier": "com.archeaxis.workspace",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:*; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "capabilities": [
        {
          "identifier": "main-window",
          "description": "Local workspace shell with no direct filesystem or shell access.",
          "windows": ["main"],
          "permissions": ["core:default", "core:event:default", "core:window:default"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../.hermes/rt/runtime": "runtime"
    }
  }
}
