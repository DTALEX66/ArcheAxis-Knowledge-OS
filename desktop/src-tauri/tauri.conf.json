{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArcheAxis Knowledge",
  "version": "0.5.0",
  "identifier": "com.archeaxis.workspace",
  "build": {
    "frontendDist": "../bootstrap"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../.hermes/rt/runtime": "runtime"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
