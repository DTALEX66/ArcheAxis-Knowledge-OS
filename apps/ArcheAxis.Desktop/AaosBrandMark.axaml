<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ArcheAxis.Desktop.AaosBrandMark"
             Width="48" Height="48"
             AutomationProperties.Name="ArcheAxis 星环标志">
  <Grid Width="48" Height="48" IsHitTestVisible="False">
    <Ellipse Width="37" Height="37" Stroke="{DynamicResource AaosGoldBrush}" StrokeThickness="1.2" Opacity="0.9" />
    <Ellipse Width="27" Height="27" Stroke="{DynamicResource AaosPrimaryBrush}" StrokeThickness="1" Opacity="0.8" />
    <Ellipse Width="45" Height="17" Stroke="{DynamicResource AaosGoldBrush}" StrokeThickness="1" Opacity="0.85">
      <Ellipse.RenderTransform><RotateTransform Angle="-16" /></Ellipse.RenderTransform>
    </Ellipse>
    <Path Data="M24,1 L24,47 M1,24 L47,24" Stroke="{DynamicResource AaosGoldBrush}" StrokeThickness="1.1" />
    <Path Data="M24,12 L26.1,21.9 L36,24 L26.1,26.1 L24,36 L21.9,26.1 L12,24 L21.9,21.9 Z"
          Fill="{DynamicResource AaosIvoryBrush}" Stroke="{DynamicResource AaosGoldBrush}" StrokeThickness="0.8" />
    <Ellipse Width="6" Height="6" Fill="{DynamicResource AaosGoldBrush}" Opacity="0.75">
      <Ellipse.Effect><BlurEffect Radius="5" /></Ellipse.Effect>
    </Ellipse>
  </Grid>
</UserControl>
