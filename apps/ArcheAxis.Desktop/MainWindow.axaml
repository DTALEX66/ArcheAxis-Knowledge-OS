<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="using:ArcheAxis.Desktop" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:views="using:ArcheAxis.Desktop.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080" Width="1440" Height="900" MinWidth="720" MinHeight="560" WindowStartupLocation="CenterScreen" TransparencyLevelHint="AcrylicBlur" Background="Transparent" x:Class="ArcheAxis.Desktop.MainWindow" Title="ArcheAxis Knowledge" AutomationProperties.Name="星环知识平台（ArcheAxis Knowledge）" Icon="/Assets/aaos-app-icon.ico" KeyDown="OnWindowKeyDown">
  <Grid x:Name="MainFrameGrid" RowDefinitions="Auto,*,Auto,Auto" ColumnDefinitions="84,0,*,0" Background="Transparent" SizeChanged="OnMainFrameSizeChanged">
    <local:AaosBackdrop Grid.Row="0" Grid.RowSpan="4" Grid.Column="0" Grid.ColumnSpan="4" IsHitTestVisible="False" />
    <Border x:Name="TopbarShell" Classes="aaos-glass shell-topbar" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" MinHeight="78" Padding="24,12" Background="{DynamicResource AaosGlassBrush}" BorderBrush="{DynamicResource AaosGlassRimBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
        <StackPanel x:Name="TopbarBrand" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{ReflectionBinding IsVisible, ElementName=MobileRail}" AutomationProperties.Name="ArcheAxis Knowledge">
          <local:AaosBrandMark Width="48" Height="48" VerticalAlignment="Center" />
        </StackPanel>
        <Button x:Name="TopbarCommandButton" Grid.Column="1" Margin="0" MaxWidth="620" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="12" Padding="14,9" Click="OnOpenCommandPaletteClick" AutomationProperties.Name="搜索页面与操作，Ctrl+K">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <local:AaosIcon Grid.Column="0" Width="18" Height="18" IconName="Search" Foreground="{DynamicResource AaosMutedBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="TopbarCommandText" Grid.Column="1" Text="Ctrl+K　搜索页面 / 命令 / 资源" Foreground="{DynamicResource AaosMutedBrush}" VerticalAlignment="Center" />
            <Border Grid.Column="2" Padding="7,3" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource AaosBorderBrush}" IsVisible="False">
              <TextBlock Text="Ctrl K" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
            </Border>
          </Grid>
        </Button>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="TopbarNotificationsButton" Classes="rail-button" Padding="12,8" Click="OnMenuToggleActivityDockClick" ToolTip.Tip="活动回执与导入任务状态" AutomationProperties.Name="展开或收起活动回执">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <local:AaosIcon Width="16" Height="16" IconName="Notifications" />
              <TextBlock x:Name="TopbarNotificationsLabel" Text="通知" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="TopbarWorkspaceButton" Classes="rail-button" Padding="12,8" Click="OnToggleInspectorDrawerClick" ToolTip.Tip="显示当前页面、选择项的来源与状态上下文" AutomationProperties.Name="打开工作区上下文">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <local:AaosIcon Width="16" Height="16" IconName="Workspace" />
              <TextBlock x:Name="TopbarWorkspaceLabel" Text="工作区" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel IsVisible="False">
            <Border x:Name="CoreStatusBorder" Padding="9,6" CornerRadius="8" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
              <TextBlock x:Name="CoreStatusText" Text="核心状态：正在连接…" Foreground="{DynamicResource AaosIvoryBrush}" AutomationProperties.Name="核心状态" />
            </Border>
            <Menu x:Name="ApplicationMenu" IsVisible="False" Background="Transparent" VerticalAlignment="Center" AutomationProperties.Name="应用程序菜单">
              <MenuItem Header="文件(_F)" AutomationProperties.Name="文件菜单">
                <MenuItem Header="导入资料…" Click="OnImportClick" AutomationProperties.Name="导入资料" />
                <Separator />
                <MenuItem Header="退出" Click="OnExitMenuClick" AutomationProperties.Name="退出应用" />
              </MenuItem>
              <MenuItem Header="导航(_N)" AutomationProperties.Name="导航菜单">
                <MenuItem x:Name="NavigateHomeMenuItem" Header="工作台" Click="OnHomeClick" AutomationProperties.Name="导航到工作台" />
                <MenuItem x:Name="NavigateCaptureMenuItem" Header="捕获" Click="OnCaptureClick" AutomationProperties.Name="导航到捕获" />
                <MenuItem x:Name="NavigateLibraryMenuItem" Header="资料库" Click="OnLibraryClick" AutomationProperties.Name="导航到资料库" />
                <MenuItem x:Name="NavigateSearchMenuItem" Header="搜索" Click="OnSearchClick" AutomationProperties.Name="导航到搜索" />
                <MenuItem x:Name="NavigateReaderMenuItem" Header="原件阅读" Click="OnSourceReaderClick" AutomationProperties.Name="导航到原件阅读" />
                <MenuItem x:Name="NavigateKnowledgeMenuItem" Header="知识库" Click="OnKnowledgeClick" AutomationProperties.Name="导航到知识库" />
                <MenuItem x:Name="NavigateEditorMenuItem" Header="原件编辑" Click="OnOriginalEditorClick" AutomationProperties.Name="导航到原件编辑" />
                <MenuItem x:Name="NavigateMemoryMapMenuItem" Header="记忆地图" Click="OnMemoryMapClick" AutomationProperties.Name="导航到记忆地图" />
                <MenuItem x:Name="NavigateLearningMenuItem" Header="学习" Click="OnLearningNavigationClick" AutomationProperties.Name="导航到学习" />
                <MenuItem x:Name="NavigateReviewMenuItem" Header="复习 / FSRS" Click="OnReviewClick" AutomationProperties.Name="导航到复习与 FSRS" />
                <MenuItem x:Name="NavigateEvidenceMenuItem" Header="证据中心" Click="OnEvidenceClick" AutomationProperties.Name="导航到证据中心" />
                <MenuItem x:Name="NavigateResearchMenuItem" Header="研究" Click="OnResearchClick" AutomationProperties.Name="导航到研究" />
                <MenuItem x:Name="NavigateMachineMenuItem" Header="机器学习" Click="OnMachineGrowthClick" AutomationProperties.Name="导航到机器学习" />
                <MenuItem x:Name="NavigateJobsMenuItem" Header="任务" Click="OnJobsClick" AutomationProperties.Name="导航到任务" />
                <MenuItem x:Name="NavigatePluginsMenuItem" Header="插件" Click="OnPluginsClick" AutomationProperties.Name="导航到插件" />
                <MenuItem x:Name="NavigateModelsMenuItem" Header="模型" Click="OnModelsClick" AutomationProperties.Name="导航到模型" />
                <MenuItem x:Name="NavigateRecoveryMenuItem" Header="恢复" Click="OnRecoveryClick" AutomationProperties.Name="导航到恢复" />
                <MenuItem x:Name="NavigateSettingsMenuItem" Header="系统设置" Click="OnSettingsClick" AutomationProperties.Name="导航到系统设置" />
              </MenuItem>
              <MenuItem Header="视图(_V)" AutomationProperties.Name="视图菜单">
                <MenuItem Header="命令面板　Ctrl+K" Click="OnOpenCommandPaletteClick" AutomationProperties.Name="打开命令面板" />
                <MenuItem Header="切换证据检查器　Ctrl+Alt+I" Click="OnMenuToggleInspectorClick" AutomationProperties.Name="切换证据检查器" />
                <MenuItem Header="展开/收起活动回执　Ctrl+Alt+J" Click="OnMenuToggleActivityDockClick" AutomationProperties.Name="切换活动回执" />
              </MenuItem>
            </Menu>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="PrimaryRail" Grid.Row="0" Grid.RowSpan="4" Grid.Column="0" Width="84" Padding="8,14" Background="{DynamicResource AaosSidebarBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <Border x:Name="PrimaryRailBrand" Grid.Row="0" Padding="8,8,10,22" Margin="0,0,0,4" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="0,0,0,1" AutomationProperties.Name="ArcheAxis Knowledge">
          <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <local:AaosBrandMark x:Name="SidebarBrandMark" Width="48" Height="48" VerticalAlignment="Center" />
            <StackPanel Width="164" Spacing="3" VerticalAlignment="Center" IsVisible="False">
              <TextBlock Text="ArcheAxis" FontSize="17" TextTrimming="CharacterEllipsis" ToolTip.Tip="ArcheAxis Knowledge" AutomationProperties.Name="ArcheAxis Knowledge" FontWeight="Bold" Foreground="{DynamicResource AaosIvoryBrush}" />
              <TextBlock Text="EVIDENCE · MEMORY · HUMAN + AI" TextWrapping="Wrap" FontSize="9" LetterSpacing="1.0" Foreground="{DynamicResource AaosPrimaryBrush}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <ScrollViewer x:Name="PrimaryRailScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="一级空间导航">
          <StackPanel Spacing="7">
            <Button x:Name="RailWorkspaceButton" Classes="rail-button master-nav-button active" MinHeight="44" Padding="14,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnHomeClick" ToolTip.Tip="首页" AutomationProperties.Name="打开首页">
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <local:AaosIcon Width="20" Height="20" IconName="Home" Foreground="{DynamicResource AaosPrimaryBrush}" />
                <TextBlock Text="首页" VerticalAlignment="Center" IsVisible="False" />
              </StackPanel>
            </Button>
            <Button x:Name="RailCaptureButton" Classes="rail-button master-nav-button" MinHeight="44" Padding="14,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnCaptureClick" ToolTip.Tip="捕获" AutomationProperties.Name="打开捕获">
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <local:AaosIcon Width="20" Height="20" IconName="Import" Foreground="{DynamicResource AaosPrimaryBrush}" />
                <TextBlock Text="捕获" VerticalAlignment="Center" IsVisible="False" />
              </StackPanel>
            </Button>
            <Button x:Name="RailEvidenceButton" Classes="rail-button master-nav-button" MinHeight="44" Padding="14,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnEvidenceClick" ToolTip.Tip="证据库" AutomationProperties.Name="打开证据库">
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <local:AaosIcon Width="20" Height="20" IconName="Evidence" Foreground="{DynamicResource AaosPrimaryBrush}" />
                <TextBlock Text="证据库" VerticalAlignment="Center" IsVisible="False" />
              </StackPanel>
            </Button>
            <Button x:Name="RailOriginalsButton" Classes="rail-button master-nav-button" MinHeight="44" Padding="14,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnOriginalEditorClick" ToolTip.Tip="原创" AutomationProperties.Name="打开原创编辑器">
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <local:AaosIcon Width="20" Height="20" IconName="Original" Foreground="{DynamicResource AaosPrimaryBrush}" />
                <TextBlock Text="原创" VerticalAlignment="Center" IsVisible="False" />
              </StackPanel>
            </Button>
            <Button x:Name="RailLearningButton" Classes="rail-button master-nav-button" MinHeight="44" Padding="14,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnLearningNavigationClick" ToolTip.Tip="人类学习" AutomationProperties.Name="打开人类学习">
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <local:AaosIcon Width="20" Height="20" IconName="HumanAi" Foreground="{DynamicResource AaosPrimaryBrush}" />
                <TextBlock Text="人类学习" VerticalAlignment="Center" IsVisible="False" />
              </StackPanel>
            </Button>
            <Button x:Name="RailMachineButton" Classes="rail-button master-nav-button" MinHeight="44" Padding="14,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnMachineGrowthClick" ToolTip.Tip="机器学习" AutomationProperties.Name="打开机器学习">
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <local:AaosIcon Width="20" Height="20" IconName="Connection" Foreground="{DynamicResource AaosPrimaryBrush}" />
                <TextBlock Text="机器学习" VerticalAlignment="Center" IsVisible="False" />
              </StackPanel>
            </Button>
            <Button x:Name="RailWorkspaceTreeButton" Classes="rail-button master-nav-button" MinHeight="44" Padding="14,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnWorkspaceRouteClick" ToolTip.Tip="工作区" AutomationProperties.Name="打开工作区">
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <local:AaosIcon Width="20" Height="20" IconName="Workspace" Foreground="{DynamicResource AaosPrimaryBrush}" />
                <TextBlock Text="工作区" VerticalAlignment="Center" IsVisible="False" />
              </StackPanel>
            </Button>
            <Button x:Name="RailMemoryMapButton" Classes="rail-button master-nav-button" MinHeight="44" Padding="14,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnMemoryMapClick" ToolTip.Tip="记忆地图" AutomationProperties.Name="打开记忆地图">
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <local:AaosIcon Width="20" Height="20" IconName="Memory" Foreground="{DynamicResource AaosPrimaryBrush}" />
                <TextBlock Text="记忆地图" VerticalAlignment="Center" IsVisible="False" />
              </StackPanel>
            </Button>
            <Button x:Name="RailSearchButton" Classes="rail-button master-nav-button" MinHeight="44" Padding="14,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnSearchClick" ToolTip.Tip="搜索" AutomationProperties.Name="打开搜索">
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <local:AaosIcon Width="20" Height="20" IconName="Search" Foreground="{DynamicResource AaosPrimaryBrush}" />
                <TextBlock Text="搜索" VerticalAlignment="Center" IsVisible="False" />
              </StackPanel>
            </Button>
            <Button x:Name="RailReviewButton" Classes="rail-button master-nav-button" MinHeight="44" Padding="14,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnReviewClick" ToolTip.Tip="复习 / FSRS" AutomationProperties.Name="打开复习与 FSRS">
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <local:AaosIcon Width="20" Height="20" IconName="Review" Foreground="{DynamicResource AaosPrimaryBrush}" />
                <TextBlock Text="复习 / FSRS" VerticalAlignment="Center" IsVisible="False" />
              </StackPanel>
            </Button>
            <Expander Header="蓝图" ToolTip.Tip="未来能力 · 待开发" IsExpanded="False" AutomationProperties.Name="展开未来能力蓝图，只读">
              <StackPanel Spacing="6" Margin="10,6,0,8">
                <TextBlock Text="蓝图保留 · 当前不可执行" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                <TextBlock Text="视觉教学 / 仿真 / 空间记忆" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                <TextBlock Text="AI 学习资产 / 模型治理 / 生态互通" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                <TextBlock Text="来源：Capability Atlas V2 · H4–H10" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource AaosMutedBrush}" />
              </StackPanel>
            </Expander>
            <StackPanel IsVisible="False">
              <Button x:Name="RailKnowledgeButton" IsVisible="False" Classes="rail-button master-icon-button" Click="OnLibraryClick" ToolTip.Tip="资料与知识" AutomationProperties.Name="打开资料与知识">
                <local:AaosIcon Width="22" Height="22" IconName="Knowledge" />
              </Button>
              <Button x:Name="RailReaderButton" IsVisible="False" Classes="rail-button master-icon-button" Click="OnSourceReaderClick" ToolTip.Tip="原件阅读" AutomationProperties.Name="打开原件阅读">
                <local:AaosIcon Width="22" Height="22" IconName="Reading" />
              </Button>
              <Button x:Name="RailResearchButton" IsVisible="False" Classes="rail-button master-icon-button" Click="OnResearchClick" ToolTip.Tip="研究" AutomationProperties.Name="打开研究">
                <local:AaosIcon Width="22" Height="22" IconName="Research" />
              </Button>
              <Button x:Name="RailJobsButton" IsVisible="False" Classes="rail-button master-icon-button" Click="OnJobsClick" ToolTip.Tip="任务" AutomationProperties.Name="打开任务">
                <local:AaosIcon Width="22" Height="22" IconName="TaskQueue" />
              </Button>
              <Button x:Name="RailPluginsButton" IsVisible="False" Classes="rail-button master-icon-button" Click="OnPluginsClick" ToolTip.Tip="插件" AutomationProperties.Name="打开插件">
                <local:AaosIcon Width="22" Height="22" IconName="Plugin" />
              </Button>
              <Button x:Name="RailModelsButton" IsVisible="False" Classes="rail-button master-icon-button" Click="OnModelsClick" ToolTip.Tip="模型" AutomationProperties.Name="打开模型">
                <local:AaosIcon Width="22" Height="22" IconName="Chip" />
              </Button>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="8,8,8,4" HorizontalAlignment="Stretch" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="0,1,0,0">
          <Button x:Name="RailSystemButton" Classes="rail-button master-nav-button" MinHeight="44" Padding="14,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnSettingsClick" ToolTip.Tip="设置与恢复" AutomationProperties.Name="打开设置与恢复">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <local:AaosIcon Width="20" Height="20" IconName="Settings" Foreground="{DynamicResource AaosPrimaryBrush}" />
              <TextBlock Text="设置与恢复" VerticalAlignment="Center" IsVisible="False" />
            </StackPanel>
          </Button>
        </Border>
      </Grid>
    </Border>
    <Border x:Name="ContextSidebar" Classes="aaos-glass shell-context-sidebar" Grid.Row="1" Grid.Column="1" Padding="12,20" Background="{DynamicResource AaosGlassBrush}" BorderBrush="{DynamicResource AaosGlassRimBrush}" BorderThickness="0,0,1,0" AutomationProperties.Name="当前空间的二级导航">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14">
          <TextBlock Text="当前位置" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AaosMutedBrush}" />
          <StackPanel x:Name="ContextWorkspaceSubnav" Spacing="7">
            <TextBlock Text="首页" Classes="rail-label" />
            <Button Content="继续工作" AutomationProperties.Name="继续工作" Click="OnHomeClick" HorizontalContentAlignment="Left" />
            <Button Content="最近证据" AutomationProperties.Name="最近证据" Click="OnEvidenceClick" HorizontalContentAlignment="Left" />
          </StackPanel>
          <StackPanel x:Name="ContextCaptureSubnav" IsVisible="False" Spacing="7">
            <TextBlock Text="捕获 · 来源" Classes="rail-label" />
            <Button x:Name="HomeSidebarImportButton" Content="选择资料" AutomationProperties.Name="选择资料" Click="OnImportClick" HorizontalContentAlignment="Left" />
            <Button Content="导入阅读" AutomationProperties.Name="导入阅读" Click="OnSourceReaderClick" HorizontalContentAlignment="Left" />
            <Button Content="转换任务与回执" AutomationProperties.Name="转换任务与回执" Click="OnJobsClick" HorizontalContentAlignment="Left" />
          </StackPanel>
          <StackPanel x:Name="ContextKnowledgeSubnav" IsVisible="False" Spacing="7">
            <TextBlock Text="证据库 · 知识" Classes="rail-label" />
            <Button Content="证据锚点" AutomationProperties.Name="证据锚点" Click="OnEvidenceClick" HorizontalContentAlignment="Left" />
            <Button Content="资料与来源" AutomationProperties.Name="资料与来源" Click="OnLibraryClick" HorizontalContentAlignment="Left" />
            <Button Content="原件阅读" AutomationProperties.Name="原件阅读" Click="OnSourceReaderClick" HorizontalContentAlignment="Left" />
            <Button Content="知识详情与版本" AutomationProperties.Name="知识详情与版本" Click="OnKnowledgeClick" HorizontalContentAlignment="Left" />
          </StackPanel>
          <StackPanel x:Name="ContextOriginalSubnav" IsVisible="False" Spacing="7">
            <TextBlock Text="原创 · 写作" Classes="rail-label" />
            <Button Content="原创编辑" AutomationProperties.Name="原创编辑" Click="OnOriginalEditorClick" HorizontalContentAlignment="Left" />
            <TextBlock Text="持久草稿和版本历史 · 待接 Core" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
          </StackPanel>
          <StackPanel x:Name="ContextLearningSubnav" IsVisible="False" Spacing="7">
            <TextBlock Text="人类学习" Classes="rail-label" />
            <Button Content="学习项目与评估" AutomationProperties.Name="学习项目与评估" Click="OnLearningNavigationClick" HorizontalContentAlignment="Left" />
            <Button Content="复习队列 / FSRS" AutomationProperties.Name="复习队列 / FSRS" Click="OnReviewClick" HorizontalContentAlignment="Left" />
            <TextBlock Text="课件候选：从知识页生成并审阅" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
          </StackPanel>
          <StackPanel x:Name="ContextMachineSubnav" IsVisible="False" Spacing="7">
            <TextBlock Text="机器学习" Classes="rail-label" />
            <Button Content="按 ID 查看任务" AutomationProperties.Name="按 ID 查看任务" Click="OnMachineGrowthClick" HorizontalContentAlignment="Left" />
            <TextBlock Text="选已接受的知识提问，用你的纠正让机器再答一次" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
          </StackPanel>
          <StackPanel x:Name="ContextProjectSubnav" IsVisible="False" Spacing="7">
            <TextBlock Text="工作区 · 项目" Classes="rail-label" />
            <Button Content="工作区概览" AutomationProperties.Name="工作区概览" Click="OnWorkspaceRouteClick" HorizontalContentAlignment="Left" />
            <Button Content="研究 · 暂不可用" AutomationProperties.Name="研究 · 暂不可用" Click="OnResearchClick" HorizontalContentAlignment="Left" />
          </StackPanel>
          <StackPanel x:Name="ContextMemorySubnav" IsVisible="False" Spacing="7">
            <TextBlock Text="记忆 · 知识关联" Classes="rail-label" />
            <Button Content="记忆地图" AutomationProperties.Name="记忆地图" Click="OnMemoryMapClick" HorizontalContentAlignment="Left" />
            <Button Content="知识详情" AutomationProperties.Name="知识详情" Click="OnKnowledgeClick" HorizontalContentAlignment="Left" />
          </StackPanel>
          <StackPanel x:Name="ContextSearchSubnav" IsVisible="False" Spacing="7">
            <TextBlock Text="搜索 · 检索" Classes="rail-label" />
            <Button Content="词法搜索" AutomationProperties.Name="词法搜索" Click="OnSearchClick" HorizontalContentAlignment="Left" />
            <TextBlock Text="语义搜索：已确认知识 · 图谱搜索待开发" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
          </StackPanel>
          <StackPanel x:Name="ContextSystemSubnav" IsVisible="False" Spacing="7">
            <TextBlock Text="系统 · 状态" Classes="rail-label" />
            <Button Content="任务回执" AutomationProperties.Name="任务回执" Click="OnJobsClick" HorizontalContentAlignment="Left" />
            <Button Content="备份与恢复" AutomationProperties.Name="备份与恢复" Click="OnRecoveryClick" HorizontalContentAlignment="Left" />
            <Button Content="设置" AutomationProperties.Name="设置" Click="OnSettingsClick" HorizontalContentAlignment="Left" />
          </StackPanel>
          <Border BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <StackPanel Spacing="5"><TextBlock Text="对象详情 · 三级" Classes="rail-label" /><TextBlock x:Name="ContextObjectPathText" Text="选择来源、知识或任务后查看详情" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" /></StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <ScrollViewer x:Name="WorkspaceScrollViewer" Classes="aaos-route-transition" Grid.Row="1" Grid.Column="2" Padding="32,28" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="22" MaxWidth="1600">
        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" AutomationProperties.Name="当前位置与三级对象路径">
          <Button Content="首页" Click="OnHomeClick" Padding="6,3" AutomationProperties.Name="返回首页" />
          <TextBlock Text="›" VerticalAlignment="Center" Foreground="{DynamicResource AaosMutedBrush}" />
          <Button x:Name="BreadcrumbDomainButton" Content="首页" Click="OnBreadcrumbDomainClick" Padding="6,3" AutomationProperties.Name="返回当前空间" />
          <TextBlock Text="›" VerticalAlignment="Center" Foreground="{DynamicResource AaosMutedBrush}" />
          <TextBlock x:Name="BreadcrumbPageText" Text="概览" VerticalAlignment="Center" Foreground="{DynamicResource AaosMutedBrush}" />
        </StackPanel>
        <Expander x:Name="CompactContextNavigation" Header="空间导航 · 二级" IsVisible="False" IsExpanded="False" AutomationProperties.Name="展开空间导航">
          <WrapPanel Orientation="Horizontal" Margin="0,8,0,4">
            <Button Content="来源" AutomationProperties.Name="来源" Click="OnSourceReaderClick" Margin="0,0,6,6" />
            <Button Content="资料库" AutomationProperties.Name="资料库" Click="OnLibraryClick" Margin="0,0,6,6" />
            <Button Content="知识" AutomationProperties.Name="知识" Click="OnKnowledgeClick" Margin="0,0,6,6" />
            <Button Content="任务回执" AutomationProperties.Name="任务回执" Click="OnJobsClick" Margin="0,0,6,6" />
            <Button Content="原创" AutomationProperties.Name="原创" Click="OnOriginalEditorClick" Margin="0,0,6,6" />
            <Button Content="记忆" AutomationProperties.Name="记忆" Click="OnMemoryMapClick" Margin="0,0,6,6" />
            <Button Content="恢复" AutomationProperties.Name="恢复" Click="OnRecoveryClick" Margin="0,0,6,6" />
          </WrapPanel>
        </Expander>
        <Grid x:Name="WorkspaceHeadingBar" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
          <StackPanel Grid.Column="0" Spacing="5">
            <TextBlock x:Name="WorkspaceHeadingText" Text="首页" Classes="page-title" Focusable="True" IsTabStop="False" AutomationProperties.Name="当前工作区页面" />
            <TextBlock x:Name="HomePageDescription" Text="捕获、证据、原文、记忆、复习，都在同一个知识工作台中。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
          </StackPanel>
          <StackPanel x:Name="HomePageActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="primary-action" Padding="14,8" Click="OnCaptureClick" AutomationProperties.Name="开始捕获">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <local:AaosIcon Width="16" Height="16" IconName="Import" />
                <TextBlock Text="捕获" />
              </StackPanel>
            </Button>
            <Button x:Name="HomeExportOverviewButton" Content="导出今日概览" IsEnabled="False" Padding="14,8" ToolTip.Tip="Core 尚未提供今日概览导出投影" AutomationProperties.Name="导出今日概览暂不可用，等待 Core 投影" />
          </StackPanel>
          <StackPanel x:Name="OriginalEditorPageActions" Grid.Column="1" IsVisible="False" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button IsEnabled="False" Padding="14,8" ToolTip.Tip="Core Original 持久化契约尚未接入" AutomationProperties.Name="保存草稿暂不可用，等待 Core Original 契约">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <local:AaosIcon Width="16" Height="16" IconName="Save" />
                <TextBlock Text="保存草稿" />
              </StackPanel>
            </Button>
            <Button IsEnabled="False" Padding="14,8" ToolTip.Tip="Core Evidence 引用绑定契约尚未接入" AutomationProperties.Name="插入引用暂不可用，等待 Core Evidence 引用契约">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <local:AaosIcon Width="16" Height="16" IconName="Link" />
                <TextBlock Text="插入引用" />
              </StackPanel>
            </Button>
          </StackPanel>
          <Button x:Name="InspectorDrawerButton" Grid.Column="2" IsVisible="False" Content="打开证据检查器" Padding="12,7" Click="OnToggleInspectorDrawerClick" AutomationProperties.Name="打开证据检查器" />
        </Grid>
        <StackPanel x:Name="HomeSurface" Spacing="14">
          <Border x:Name="HomePlanetHero" Height="180" CornerRadius="16" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1" ClipToBounds="True">
            <Border.Background>
              <ImageBrush Source="/Assets/home-planet-hero-20261001.png" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Center" />
            </Border.Background>
            <Grid ColumnDefinitions="*,Auto" Margin="26,22">
              <StackPanel Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="继续探索真实的知识。" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource AaosHeroTextBrush}" />
                <TextBlock Text="从捕获、证据到学习与记忆，每一步都有来源。" Foreground="{DynamicResource AaosHeroMutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="ARCHEAXIS  ·  KNOWLEDGE" FontSize="10" LetterSpacing="2" Foreground="{DynamicResource AaosHeroTextBrush}" VerticalAlignment="Bottom" />
            </Grid>
          </Border>
          <Grid x:Name="HomeStatsSurface" IsVisible="True" ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
            <Border x:Name="HomeStatsSourceCard" Classes="aaos-kpi">
              <StackPanel Spacing="5">
                <TextBlock Text="证据条目" Foreground="{DynamicResource AaosMutedBrush}" />
                <TextBlock x:Name="HomeEvidenceCountText" Text="—" Classes="kpi-value" />
                <TextBlock Text="来自 Core 的证据条目" Foreground="{DynamicResource AaosMutedBrush}" />
              </StackPanel>
            </Border>
            <Border x:Name="HomeStatsKnowledgeCard" Grid.Column="1" Classes="aaos-kpi">
              <StackPanel Spacing="5">
                <TextBlock Text="今日笔记" Foreground="{DynamicResource AaosMutedBrush}" />
                <TextBlock Text="—" Classes="kpi-value" />
                <TextBlock Text="Core 未提供" Foreground="{DynamicResource AaosMutedBrush}" />
              </StackPanel>
            </Border>
            <Border x:Name="HomeStatsLearningCard" Grid.Column="2" Classes="aaos-kpi">
              <StackPanel Spacing="5">
                <TextBlock Text="待复习" Foreground="{DynamicResource AaosMutedBrush}" />
                <TextBlock Text="—" Classes="kpi-value" />
                <TextBlock Text="Core 未提供" Foreground="{DynamicResource AaosMutedBrush}" />
              </StackPanel>
            </Border>
            <Border x:Name="HomeStatsJobsCard" Grid.Column="3" Classes="aaos-kpi">
              <StackPanel Spacing="5">
                <TextBlock Text="本月掌握" Foreground="{DynamicResource AaosMutedBrush}" />
                <TextBlock Text="—" Classes="kpi-value" />
                <TextBlock Text="Core 未提供" Foreground="{DynamicResource AaosMutedBrush}" />
              </StackPanel>
            </Border>
          </Grid>
          <Grid x:Name="HomePrimaryContentGrid" IsVisible="False" ColumnDefinitions="*,*" RowDefinitions="Auto" ColumnSpacing="14" RowSpacing="12">
            <Border x:Name="HomeQuickCaptureCard" Grid.Column="0" IsVisible="True" Classes="aaos-card" Padding="16">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                  <local:AaosIcon Width="18" Height="18" IconName="Capture" Foreground="{DynamicResource AaosPrimaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="快速捕获" Classes="section-heading" VerticalAlignment="Center" />
                  <Button Grid.Column="2" Content="完整捕获面板" Padding="10,6" Click="OnCaptureClick" AutomationProperties.Name="打开完整捕获面板" />
                </Grid>
                <TextBox x:Name="HomeQuickCaptureDraft" MinHeight="62" PlaceholderText="写下想法，或粘贴一个链接。此草稿只保留在当前窗口，尚未保存到 Core。" TextWrapping="Wrap" AcceptsReturn="True" TextChanged="OnHomeQuickCaptureDraftChanged" AutomationProperties.Name="快速捕获草稿；尚未保存到 Core" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock x:Name="HomeQuickCaptureDraftStatus" Text="草稿仅保留在当前窗口；尚未保存到 Core。" TextWrapping="Wrap" FontSize="11" Classes="status-empty" VerticalAlignment="Center" />
                  <TextBlock x:Name="HomeQuickCaptureModeText" Grid.Column="1" Text="文字草稿" FontSize="11" Foreground="{DynamicResource AaosPrimaryBrush}" VerticalAlignment="Center" AutomationProperties.Name="当前捕获类型：文字草稿" />
                </Grid>
                <StackPanel x:Name="HomeQuickCaptureActions" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Stretch">
                  <Button x:Name="HomeQuickCaptureTextModeButton" AutomationProperties.Name="切换到文字捕获草稿" Classes="primary-action" Padding="7,8" Click="OnHomeQuickCaptureTextModeClick" ToolTip.Tip="编辑文字草稿；不会发送到 Core">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                      <local:AaosIcon Width="18" Height="18" IconName="Edit" />
                      <TextBlock Text="文字" FontSize="11" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="HomeQuickCaptureLinkModeButton" AutomationProperties.Name="切换到链接捕获草稿" Padding="7,8" Click="OnHomeQuickCaptureLinkModeClick" ToolTip.Tip="编辑链接草稿；不会发送到 Core">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                      <local:AaosIcon Width="18" Height="18" IconName="Link" />
                      <TextBlock Text="链接" FontSize="11" />
                    </StackPanel>
                  </Button>
                  <Button Classes="primary-action" Padding="7,8" Click="OnImportClick" AutomationProperties.Name="从首页选择文件捕获">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                      <local:AaosIcon Width="18" Height="18" IconName="Import" />
                      <TextBlock Text="文件" FontSize="11" />
                    </StackPanel>
                  </Button>
                  <Button Tag="image" Padding="7,8" Click="OnImportClick" ToolTip.Tip="选择图片并交由 Core 导入" AutomationProperties.Name="从首页选择图片捕获">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                      <local:AaosIcon Width="18" Height="18" IconName="Image" />
                      <TextBlock Text="图片" FontSize="11" />
                    </StackPanel>
                  </Button>
                  <Button Tag="audio" Padding="7,8" Click="OnImportClick" ToolTip.Tip="选择音频并交由 Core 导入" AutomationProperties.Name="从首页选择音频捕获">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                      <local:AaosIcon Width="18" Height="18" IconName="Audio" />
                      <TextBlock Text="语音" FontSize="11" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <TextBlock Text="文件、图片与语音捕获会按 Core 回执显示状态；文字和链接目前只是窗口内草稿。" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
              </StackPanel>
            </Border>
            <Border x:Name="HomeTodayFocusCard" Grid.Column="1" Classes="aaos-card" Padding="16">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                  <local:AaosIcon Width="18" Height="18" IconName="HumanAi" Foreground="{DynamicResource AaosPrimaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="今日学习" Classes="section-heading" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="CORE 状态" Classes="aaos-provenance-tag" VerticalAlignment="Center" />
                </Grid>
                <Border Classes="aaos-card-compact" Padding="11">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" AutomationProperties.Name="今日学习暂不可用；Core 尚未连接">
                    <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                      <local:AaosIcon Width="16" Height="16" IconName="Reading" Foreground="{DynamicResource AaosMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="待学习 / 待复习" Classes="card-heading" FontSize="12" />
                      <TextBlock x:Name="HomeFocusText" Text="Core 尚未连接；目前没有可确认的学习队列。连接后将在此显示真实待办。" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
                    </StackPanel>
                  </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="HomeFocusLearningButton" Classes="primary-action" Content="查看学习队列" IsEnabled="False" Padding="14,8" Click="OnLearningNavigationClick" AutomationProperties.Name="查看 Core 学习队列" />
                  <Button Content="复习 / FSRS" Padding="14,8" Click="OnReviewClick" AutomationProperties.Name="打开复习与 FSRS" />
                </StackPanel>
                <TextBlock x:Name="HomeEvidenceText" Text="本次会话暂无活动回执。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                <Button x:Name="HomeOpenCurrentSourceButton" Content="打开当前来源" HorizontalAlignment="Left" Padding="14,8" Click="OnOpenLatestSourceClick" AutomationProperties.Name="打开当前来源" />
              </StackPanel>
            </Border>
          </Grid>
          <Grid x:Name="HomeEvidenceContentGrid" ColumnDefinitions="1.2*,1*" RowDefinitions="Auto" ColumnSpacing="16">
            <Border x:Name="HomeRecentEvidenceCard" Grid.Column="0" Classes="aaos-card" Padding="16">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="最近证据" Classes="section-heading" />
                  <Button Grid.Column="1" Content="查看全部" Padding="10,6" Click="OnEvidenceClick" AutomationProperties.Name="查看全部持久化证据" />
                </Grid>
                <TextBlock x:Name="HomeRecentEvidenceStatus" Text="尚未读取 Core Evidence anchor。" Classes="status-empty" TextWrapping="Wrap" AutomationProperties.Name="最近证据读取状态" />
                <Border x:Name="HomeRecentEvidenceEmptyState" Classes="aaos-empty-state" Padding="12" MinHeight="88" IsVisible="True">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <Border Width="42" Height="42" CornerRadius="21" BorderThickness="1" BorderBrush="{DynamicResource AaosPrimaryBrush}" Opacity="0.48" Background="Transparent" AutomationProperties.AccessibilityView="Raw" AutomationProperties.IsControlElementOverride="False">
                      <local:AaosIcon Width="20" Height="20" IconName="Evidence" Foreground="{DynamicResource AaosPrimaryBrush}" />
                    </Border>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="暂无最近证据" Classes="card-heading" />
                      <TextBlock Text="Core 返回真实 Evidence anchor 后会显示在这里。" Classes="status-empty" TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <ListBox x:Name="HomeRecentEvidenceList" MaxHeight="300" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AaosIvoryBrush}" AutomationProperties.Name="最近持久化 Evidence anchor">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type views:EvidenceAnchorRow}">
                      <Border Classes="aaos-card-compact" Padding="12" Margin="0,0,0,8">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding TitleDisplay}" Classes="card-heading" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding SourceTitle, StringFormat='来源 · {0}'}" Foreground="{DynamicResource AaosMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding CreatedAtDisplay, StringFormat='保存于 · {0}'}" Foreground="{DynamicResource AaosMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>
            <Border x:Name="HomeTodayProgressCard" Grid.Column="1" Classes="aaos-card" Padding="16">
              <StackPanel Spacing="12">
                <TextBlock Text="今日进度" Classes="section-heading" />
                <Grid x:Name="HomeTodayProgressGrid" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto" ColumnSpacing="10" IsVisible="True">
              <Border Classes="aaos-kpi">
                <StackPanel Spacing="4">
                  <TextBlock Text="捕获" Foreground="{DynamicResource AaosMutedBrush}" />
                  <TextBlock Text="—" Classes="kpi-value" />
                  <TextBlock Text="Core 未提供" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="aaos-kpi">
                <StackPanel Spacing="4">
                  <TextBlock Text="证据" Foreground="{DynamicResource AaosMutedBrush}" />
                  <TextBlock x:Name="HomeProgressEvidenceValue" Text="—" Classes="kpi-value" />
                  <TextBlock Text="最近读取的证据" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="aaos-kpi">
                <StackPanel Spacing="4">
                  <TextBlock Text="复习" Foreground="{DynamicResource AaosMutedBrush}" />
                  <TextBlock Text="—" Classes="kpi-value" />
                  <TextBlock Text="Core 未提供" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="3" Classes="aaos-kpi">
                <StackPanel Spacing="4">
                  <TextBlock Text="产出" Foreground="{DynamicResource AaosMutedBrush}" />
                  <TextBlock Text="—" Classes="kpi-value" />
                  <TextBlock Text="Core 未提供" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                </StackPanel>
              </Border>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
          <Grid x:Name="HomeGraphContentGrid" ColumnDefinitions="1.35*,0.95*" RowDefinitions="Auto" ColumnSpacing="16" IsVisible="True">
            <Border x:Name="HomeMemoryGraphCard" Grid.Column="0" Classes="aaos-card" Padding="18">
              <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                <Border x:Name="HomeHeroAmbientGlow" Grid.RowSpan="3" Classes="aaos-home-ambient-glow" Background="{DynamicResource AaosAmbientGlowBrush}" Opacity="0.14" IsHitTestVisible="False" ZIndex="0" />
                <TextBlock Grid.Row="0" Text="记忆图谱" Classes="section-heading" ZIndex="1" />
                <Viewbox Grid.Row="1" MaxWidth="470" MaxHeight="360" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="1">
                  <local:AaosMemoryGraphView x:Name="HomeHeroVisual" NodeSelected="OnHomeMemoryNodeSelected" />
                </Viewbox>
                <TextBlock x:Name="HomeGraphUnavailableText" Grid.Row="2" Text="Core 尚未提供节点与关系投影；示意图仅表达页面结构。" Classes="status-empty" TextWrapping="Wrap" AutomationProperties.Name="Memory Graph 当前不可用，等待 Core 节点关系投影" ZIndex="1" />
              </Grid>
            </Border>
            <Border x:Name="HomeNodeDetailsCard" Grid.Column="1" Classes="aaos-card" Padding="18">
              <StackPanel Spacing="12">
                <TextBlock Text="节点详情" Classes="section-heading" />
                <TextBlock x:Name="HomeMemoryNodeDetailsText" Text="点击记忆图谱节点查看关联说明。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
                <Border x:Name="HomeTrendCard" Classes="aaos-card-compact" Padding="14">
                  <StackPanel Spacing="8">
                    <TextBlock Text="知识演化" Classes="card-heading" />
                    <Grid x:Name="HomeTrendPlotGrid" MinHeight="150" RowDefinitions="*,*,*,*" Margin="8,4">
                      <Border BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="0,0,0,1" />
                      <Border Grid.Row="1" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="0,0,0,1" />
                      <Border Grid.Row="2" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="0,0,0,1" />
                      <Border Grid.Row="3" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="0,0,0,1" />
                      <Viewbox Grid.RowSpan="4" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.AccessibilityView="Raw">
                        <Canvas x:Name="HomeTrendIllustration" Width="254" Height="92" AutomationProperties.Name="知识演化趋势暂无 Core 数据" AutomationProperties.AccessibilityView="Raw">
                          <Line StartPoint="10,46" EndPoint="244,46" Stroke="{DynamicResource AaosBorderBrush}" StrokeThickness="1" StrokeDashArray="2,4" Opacity="0.7" />
                        </Canvas>
                      </Viewbox>
                    </Grid>
                    <TextBlock x:Name="HomeTrendUnavailableText" Text="Core 尚未提供可信的知识演化时间序列。" Classes="status-empty" TextWrapping="Wrap" AutomationProperties.Name="知识演化趋势暂不可用" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </Grid>
          <StackPanel x:Name="HomeWorkflowDetails" IsVisible="False" Spacing="14">
            <StackPanel Spacing="6">
              <TextBlock Text="工作流状态" Classes="section-heading" />
              <TextBlock Text="显示已确认的进度；尚未读取到的信息会明确标记。" FontSize="12" Foreground="{DynamicResource AaosMutedBrush}" />
            </StackPanel>
            <Grid x:Name="HomeLifecycleGrid" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
              <Border x:Name="HomeLifecycleCaptureCard" Classes="lifecycle-card" Padding="18">
                <StackPanel Spacing="3">
                  <TextBlock Text="捕获" Classes="lifecycle-label" />
                  <TextBlock x:Name="HomeLifecycleCaptureText" Text="空 · 尚无当前会话来源" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
                </StackPanel>
              </Border>
              <Border x:Name="HomeLifecycleSourceCard" Grid.Column="1" Classes="lifecycle-card" Padding="18">
                <StackPanel Spacing="3">
                  <TextBlock Text="来源" Classes="lifecycle-label" />
                  <TextBlock x:Name="HomeLifecycleSourceText" Text="不可用 · 尚未登记来源" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
                </StackPanel>
              </Border>
              <Border x:Name="HomeLifecycleKnowledgeCard" Grid.Column="2" Classes="lifecycle-card" Padding="18">
                <StackPanel Spacing="3">
                  <TextBlock Text="知识" Classes="lifecycle-label" />
                  <TextBlock x:Name="HomeLifecycleKnowledgeText" Text="未关联 · 尚无来源知识记录" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
                </StackPanel>
              </Border>
              <Border x:Name="HomeLifecycleLearningCard" Grid.Column="3" Classes="lifecycle-card" Padding="18">
                <StackPanel Spacing="3">
                  <TextBlock Text="学习" Classes="lifecycle-label" />
                  <TextBlock x:Name="HomeLifecycleLearningText" Text="不可用 · 尚未读取队列" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
                </StackPanel>
              </Border>
              <Border x:Name="HomeLifecycleReviewCard" Grid.Column="4" Classes="lifecycle-card" Padding="18">
                <StackPanel Spacing="3">
                  <TextBlock Text="复习" Classes="lifecycle-label" />
                  <TextBlock x:Name="HomeLifecycleReviewText" Text="不可用 · 工作台尚未读取待复习项" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
                </StackPanel>
              </Border>
            </Grid>
            <Border x:Name="FirstRunReadinessCard" Classes="aaos-card-compact aaos-status" Padding="16">
              <StackPanel Spacing="8">
                <Grid x:Name="FirstRunReadinessGrid" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="3">
                    <TextBlock Text="首次使用准备度" Classes="section-heading" />
                    <TextBlock Text="先检查工作区，再导入第一份资料。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AaosMutedBrush}" />
                  </StackPanel>
                  <Button x:Name="FirstRunImportButton" Classes="primary-action" Grid.Column="1" Content="选择资料并导入" Padding="14,8" Click="OnImportClick" AutomationProperties.Name="选择资料并导入" />
                </Grid>
                <TextBlock x:Name="FirstRunWorkspaceStatusText" Classes="status-empty" Text="工作区：等待读取状态" TextWrapping="Wrap" />
                <Expander Header="连接与处理说明" IsExpanded="False" HorizontalAlignment="Stretch" AutomationProperties.Name="展开连接与处理说明">
                  <StackPanel Spacing="6">
                    <TextBlock x:Name="FirstRunCoreStatusText" Classes="status-info" Text="核心服务：等待启动检查" TextWrapping="Wrap" />
                    <TextBlock x:Name="FirstRunOptionalStatusText" Classes="status-empty" Text="插件、模型和扩展工具的状态暂不可用。" TextWrapping="Wrap" />
                    <TextBlock Text="导入成功不等于转换、知识接受或学习完成。" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
            <StackPanel Spacing="8">
              <TextBlock Text="继续工作" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AaosMutedBrush}" />
              <Border x:Name="HomeContinueReadingCard" Padding="14,12" CornerRadius="10" Background="{DynamicResource AaosSurfaceBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                <Grid x:Name="HomeContinueReadingGrid" ColumnDefinitions="*,Auto" ColumnSpacing="18">
                  <StackPanel Spacing="3">
                    <TextBlock Text="继续阅读" Classes="card-heading" />
                    <TextBlock x:Name="HomeContinueReadingText" Text="当前会话尚无可恢复来源；持久化阅读位置未接入。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
                  </StackPanel>
                  <Button x:Name="HomeContinueReadingButton" Grid.Column="1" Content="打开当前来源" IsEnabled="False" Padding="14,8" VerticalAlignment="Center" Click="OnOpenHomeReadingClick" AutomationProperties.Name="打开当前来源" />
                </Grid>
              </Border>
              <Border Padding="14,12" CornerRadius="10" Background="{DynamicResource AaosSurfaceBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                <Grid x:Name="HomeDeepTutorGrid" ColumnDefinitions="*,Auto" ColumnSpacing="18">
                  <StackPanel Spacing="3">
                    <TextBlock Text="可选 DeepTutor 工作台" Classes="card-heading" />
                    <TextBlock Text="Core 待复习队列请从“今日关注 / Core 学习路径”进入；DeepTutor 仅为可选 sidecar，不写 Core Learning Truth。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
                  </StackPanel>
                  <Button x:Name="HomeDeepTutorButton" Grid.Column="1" Content="打开 DeepTutor 工作台" Padding="14,8" Click="OnOpenLearningWorkbenchClick" VerticalAlignment="Center" AutomationProperties.Name="打开 DeepTutor 工作台" />
                </Grid>
              </Border>
              <Border Padding="14,12" CornerRadius="10" Background="{DynamicResource AaosSurfaceBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                <Grid x:Name="HomeImportGrid" ColumnDefinitions="*,Auto" ColumnSpacing="18">
                  <StackPanel Spacing="3">
                    <TextBlock Text="导入资料" Classes="card-heading" />
                    <TextBlock Text="从 Markdown、PDF、Office、网页或 Canvas 开始。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
                  </StackPanel>
                  <Button x:Name="HomeImportButton" Grid.Column="1" Content="选择资料并导入" Padding="14,8" VerticalAlignment="Center" Click="OnImportClick" AutomationProperties.Name="选择资料并导入" />
                </Grid>
              </Border>
              <Border Padding="14,12" CornerRadius="10" Background="{DynamicResource AaosSurfaceBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                  <StackPanel Spacing="3">
                    <TextBlock Text="资料与知识" Classes="card-heading" />
                    <TextBlock Text="检索来源、知识与提取结果；恢复状态仍由 Core 直接读取。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
                  </StackPanel>
                  <StackPanel x:Name="HomeKnowledgeActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="打开资料库" Padding="14,8" Click="OnLibraryClick" AutomationProperties.Name="打开资料库" />
                    <Button Content="恢复状态" Padding="14,8" Click="OnRecoveryClick" AutomationProperties.Name="打开恢复状态" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="CaptureSurface" IsVisible="False" Spacing="14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <local:AaosCaptureScanSweep x:Name="CaptureScanSweep" Width="18" Height="18" VerticalAlignment="Center" IsVisible="False" />
            <TextBlock Grid.Column="1" Text="网页、文档、链接、图片、语音和快速笔记" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
          </Grid>
          <Grid x:Name="CapturePageGrid" ColumnDefinitions="1.35*,0.95*" ColumnSpacing="16">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" MaxWidth="1040" HorizontalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="13" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                  <local:AaosIcon Width="20" Height="20" IconName="Capture" Foreground="{DynamicResource AaosPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="快速捕获" Classes="section-heading" />
                  <TextBlock Text="选择输入方式；导入结果只以 Core 来源与任务回执为准。" TextWrapping="Wrap" Classes="status-empty" />
                </StackPanel>
              </Grid>
              <Grid x:Name="CaptureTypeGrid" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6" RowDefinitions="Auto" HorizontalAlignment="Left">
                <Border Classes="aaos-card-compact" Padding="9,7" MinHeight="40" ToolTip.Tip="网页捕获写入合同尚未接入 Core">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <local:AaosIcon Width="16" Height="16" IconName="Web" Foreground="{DynamicResource AaosMutedBrush}" />
                    <TextBlock Text="网页 · 暂不可用" FontSize="11" Classes="status-empty" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Button x:Name="CaptureDocumentButton" Tag="document" Padding="10,7" MinHeight="40" HorizontalAlignment="Stretch" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1" CornerRadius="10" Click="OnImportClick" AutomationProperties.Name="选择文档导入">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <local:AaosIcon Width="16" Height="16" IconName="Source" Foreground="{DynamicResource AaosPrimaryBrush}" />
                    <TextBlock Text="文档" FontSize="11" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Border Grid.Column="2" Classes="aaos-card-compact" Padding="9,7" MinHeight="40" ToolTip.Tip="链接捕获写入合同尚未接入 Core">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <local:AaosIcon Width="16" Height="16" IconName="Link" Foreground="{DynamicResource AaosMutedBrush}" />
                    <TextBlock Text="链接 · 暂不可用" FontSize="11" Classes="status-empty" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Button x:Name="CaptureImageButton" Grid.Column="3" Tag="image" Padding="10,7" MinHeight="40" HorizontalAlignment="Stretch" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1" CornerRadius="10" Click="OnImportClick" AutomationProperties.Name="选择图片导入">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <local:AaosIcon Width="16" Height="16" IconName="Image" Foreground="{DynamicResource AaosPrimaryBrush}" />
                    <TextBlock Text="图片" FontSize="11" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="CaptureAudioButton" Grid.Column="4" Tag="audio" Padding="10,7" MinHeight="40" HorizontalAlignment="Stretch" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1" CornerRadius="10" Click="OnImportClick" AutomationProperties.Name="选择音频文件导入">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <local:AaosIcon Width="16" Height="16" IconName="Audio" Foreground="{DynamicResource AaosPrimaryBrush}" />
                    <TextBlock Text="语音" FontSize="11" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Border Grid.Column="5" Classes="aaos-card-compact" Padding="9,7" MinHeight="40" ToolTip.Tip="快速笔记写入合同尚未接入 Core">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <local:AaosIcon Width="16" Height="16" IconName="Note" Foreground="{DynamicResource AaosMutedBrush}" />
                    <TextBlock Text="笔记 · 暂不可用" FontSize="11" Classes="status-empty" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Classes="aaos-card" Padding="14" HorizontalAlignment="Stretch">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="捕获内容" Classes="card-heading" />
                    <TextBlock Grid.Column="1" Text="LOCAL DRAFT · NOT SAVED" Classes="aaos-provenance-tag" VerticalAlignment="Center" />
                  </Grid>
                  <Border Classes="aaos-card-compact" Padding="8" MinHeight="220">
                    <TextBox x:Name="CaptureDraftBox" AcceptsReturn="True" MinHeight="204" TextWrapping="Wrap" PlaceholderText="粘贴文本或写下快速笔记…" AutomationProperties.Name="捕获草稿；尚未保存到 Core" />
                  </Border>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="草稿仅保留在当前界面；Core 写入合同接入前不会伪装成已保存来源。" TextWrapping="Wrap" FontSize="11" Classes="status-empty" VerticalAlignment="Center" />
                    <Button x:Name="CaptureSaveButton" Grid.Column="1" Content="保存到知识库" Classes="primary-action" IsEnabled="False" HorizontalAlignment="Right" Padding="16,8" ToolTip.Tip="Core 尚未提供文本捕获写入接口" AutomationProperties.Name="保存暂不可用；Core 写入接口尚未接入" />
                  </Grid>
                </StackPanel>
              </Border>
              <TextBlock x:Name="CaptureUnavailableModesText" Text="web/link/note 捕获写入尚未接入 Core；文档、图片与音频选择后走真实导入与回执。" IsVisible="False" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="12" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <local:AaosIcon Width="19" Height="19" IconName="Source" Foreground="{DynamicResource AaosPrimaryBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="最近捕获" Classes="section-heading" />
                  <TextBlock Text="仅显示本次运行收到的 Core 回执；不推断跨重启历史。" FontSize="11" TextWrapping="Wrap" Classes="status-empty" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="CURRENT SESSION" Classes="aaos-provenance-tag" VerticalAlignment="Center" />
              </Grid>
              <Grid x:Name="CaptureRecentGrid" ColumnDefinitions="2*,*,Auto" RowDefinitions="Auto" ColumnSpacing="14" RowSpacing="8">
                <TextBlock Text="内容" FontSize="11" Classes="provenance-tag" />
                <TextBlock Grid.Column="1" Text="类型" FontSize="11" Classes="provenance-tag" />
                <TextBlock Grid.Column="2" Text="时间" FontSize="11" Classes="provenance-tag" />
              </Grid>
              <ListBox x:Name="CaptureRecentList" SelectionChanged="OnCaptureContextSelected" MaxHeight="600" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AaosIvoryBrush}" AutomationProperties.Name="最近捕获回执列表">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="{x:Type x:Object}">
                    <Border Padding="12,14" Margin="0,0,0,6" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="0,0,0,1">
                      <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <TextBlock Text="{ReflectionBinding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <Button Grid.Column="1" Content="打开来源" Padding="10,6" Click="OnOpenLatestSourceClick" Tag="{Binding}" AutomationProperties.Name="打开此捕获来源" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="文件" FontSize="11" Classes="status-empty" />
                          <TextBlock Text="{ReflectionBinding JobStateDisplay}" FontSize="11" Classes="provenance-projection" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="Core 未提供" FontSize="11" Classes="status-empty" VerticalAlignment="Center" AutomationProperties.Name="捕获时间未由 Core 暴露" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Border x:Name="CaptureRecentEmptyState" Classes="aaos-empty-state" Padding="22" MinHeight="170" IsVisible="True">
                <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                  <Border Width="52" Height="52" CornerRadius="18" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                    <local:AaosIcon Width="24" Height="24" IconName="Capture" Foreground="{DynamicResource AaosPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="当前会话尚无捕获回执" Classes="card-heading" TextAlignment="Center" />
                  <TextBlock Text="导入成功并收到 Core 回执后，来源会列在这里。空列表不代表历史数据已删除。" TextWrapping="Wrap" Classes="status-empty" TextAlignment="Center" />
                </StackPanel>
              </Border>
              <TextBlock x:Name="CaptureSelectionText" Text="尚未选择资料。" IsVisible="False" />
              <TextBlock x:Name="CaptureImportStatusText" Text="尚未开始导入。" Classes="status-empty" AutomationProperties.Name="捕获导入状态" />
              <Expander x:Name="CaptureDiagnostics" Header="更多信息：导入记录" IsExpanded="False">
                <TextBlock x:Name="CaptureReceiptText" Text="选择资料后可查看已保存的来源与任务记录。" TextWrapping="Wrap" Classes="provenance-projection" />
              </Expander>
              <TextBlock x:Name="CaptureContextText" Text="本次导入上下文：尚未形成 Core 来源。" IsVisible="False" />
              <ListBox x:Name="CaptureContextsList" SelectionChanged="OnCaptureContextSelected" IsVisible="False" AutomationProperties.Name="当前会话捕获来源上下文" />
              <Button x:Name="CaptureImportButton" Content="选择资料" IsVisible="False" Click="OnImportClick" AutomationProperties.Name="选择资料" />
              <StackPanel x:Name="CaptureContextActions" IsVisible="False">
                <Button x:Name="OpenLatestSourceButton" Click="OnOpenLatestSourceClick" AutomationProperties.Name="打开最近来源" />
                <Button x:Name="OpenLatestJobButton" Click="OnOpenLatestJobClick" AutomationProperties.Name="查看最近任务" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </StackPanel>
        <StackPanel x:Name="LibrarySurface" IsVisible="False" Spacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" RowDefinitions="Auto,Auto">
            <StackPanel Spacing="5">
              <TextBlock Text="搜索 Core 已登记的知识与提取结果；搜索命中保留来源类型，不自动构成来源关联。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Classes="provenance-tag" Padding="10,6" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <local:AaosIcon Width="15" Height="15" IconName="Knowledge" Foreground="{DynamicResource AaosPrimaryBrush}" />
                <TextBlock Text="CORE SEARCH" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0" Text="Knowledge 需要人工确认关联；Transform 提取文本不等同于已接受知识。统计字段未由搜索接口提供时显示为不可用。" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
          </Grid>
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
            <Border Classes="aaos-card-compact" Padding="16,13">
              <StackPanel Spacing="7">
                <TextBlock Text="知识条目" FontSize="11" Classes="status-empty" />
                <TextBlock Text="—" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource AaosIvoryBrush}" />
                <TextBlock Text="全库总量 · Core 未提供" FontSize="10" Classes="provenance-projection" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="aaos-card-compact" Padding="16,13">
              <StackPanel Spacing="7">
                <TextBlock Text="提取结果" FontSize="11" Classes="status-empty" />
                <TextBlock Text="—" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource AaosIvoryBrush}" />
                <TextBlock Text="全库总量 · Core 未提供" FontSize="10" Classes="provenance-projection" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="aaos-card-compact" Padding="16,13">
              <StackPanel Spacing="7">
                <TextBlock Text="有效知识" FontSize="11" Classes="status-empty" />
                <TextBlock Text="—" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource AaosIvoryBrush}" />
                <TextBlock Text="全库统计 · Core 未提供" FontSize="10" Classes="provenance-projection" />
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Classes="aaos-card-compact" Padding="16,13">
              <StackPanel Spacing="7">
                <TextBlock Text="来源关联" FontSize="11" Classes="status-empty" />
                <TextBlock Text="—" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource AaosIvoryBrush}" />
                <TextBlock Text="全库统计 · Core 未提供" FontSize="10" Classes="provenance-projection" />
              </StackPanel>
            </Border>
          </Grid>
          <Grid x:Name="LibrarySearchGrid" Classes="aaos-toolbar" ColumnDefinitions="*,Auto" RowDefinitions="Auto" ColumnSpacing="10" RowSpacing="10">
            <TextBox x:Name="LibrarySearchBox" PlaceholderText="搜索知识或提取内容" KeyDown="OnToolbarInputKeyDown" AutomationProperties.Name="资料库搜索输入" />
            <Button x:Name="LibrarySearchButton" Classes="primary-action" Grid.Column="1" Content="搜索" Padding="16,9" Click="OnSearchLibraryClick" AutomationProperties.Name="搜索" />
          </Grid>
          <StackPanel x:Name="LibraryFilterPanel" Orientation="Horizontal" Spacing="10">
            <CheckBox x:Name="LibraryActiveOnlyBox" Content="仅当前有效 Knowledge（Transform 不适用）" VerticalAlignment="Center" AutomationProperties.Name="仅当前有效 Knowledge" />
            <ComboBox x:Name="LibraryKindFilterBox" SelectedIndex="0" Width="150" AutomationProperties.Name="资料类型筛选">
              <ComboBoxItem Content="全部类型" />
              <ComboBoxItem Content="仅 Knowledge" />
              <ComboBoxItem Content="仅 Transform" />
            </ComboBox>
          </StackPanel>
          <Border Classes="aaos-card-compact" Padding="14,10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource AaosSurface2Brush}" VerticalAlignment="Center">
                <local:AaosIcon Width="15" Height="15" IconName="Search" Foreground="{DynamicResource AaosPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock x:Name="LibrarySearchStatusText" Grid.Column="1" Text="尚未读取 Core 搜索结果。输入关键词后，结果会显示在下方列表。" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource AaosMutedBrush}" AutomationProperties.Name="资料库搜索状态" />
            </Grid>
          </Border>
          <Grid x:Name="LibraryWorkspaceGrid" ColumnDefinitions="*" RowDefinitions="Auto,Auto" RowSpacing="12">
            <Border Grid.Row="0" Classes="aaos-card-compact" Padding="20">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="3">
                    <TextBlock Text="搜索结果" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Core 返回的 Knowledge 与 Transform 投影" FontSize="10" Classes="provenance-projection" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="类型　　 条目　　 状态　　 来源" FontSize="10" Classes="status-empty" VerticalAlignment="Center" />
                </Grid>
                <Border x:Name="LibraryEmptyState" Height="148" CornerRadius="10" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1" Padding="18">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="440">
                    <Border Width="36" Height="36" CornerRadius="12" Background="{DynamicResource AaosSurfaceBrush}" HorizontalAlignment="Center">
                      <local:AaosIcon Width="18" Height="18" IconName="Search" Foreground="{DynamicResource AaosPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="查询提示与 Core 回执" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock x:Name="LibraryResultsText" Text="输入关键词后搜索 Core。读取到的真实结果将在此列表中呈现；未返回字段不会推断补齐。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" TextAlignment="Center" />
                  </StackPanel>
                </Border>
                <ListBox x:Name="LibraryResultsList" SelectionChanged="OnLibraryResultSelected" KeyDown="OnDetailListKeyDown" DoubleTapped="OnDetailListDoubleTapped" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AaosIvoryBrush}" AutomationProperties.Name="资料库搜索结果">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type local:LibraryResultRow}">
                      <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="8" Background="{DynamicResource AaosSurfaceBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                          <TextBlock x:Name="LibraryResultKindText" Text="{Binding KindLabel}" FontSize="11" FontWeight="SemiBold" Classes="provenance-evidence" />
                          <TextBlock Grid.Column="1" Text="Core projection" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                          <TextBlock x:Name="LibraryResultHeadText" Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Head}" TextWrapping="Wrap" Foreground="{DynamicResource AaosIvoryBrush}" />
                          <TextBlock x:Name="LibraryResultStatusText" Grid.Row="2" Text="{Binding StatusLabel}" FontSize="11" Classes="status-projection" />
                          <TextBlock x:Name="LibraryResultSourceText" Grid.Row="2" Grid.Column="1" Text="{Binding SourceLabel}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" HorizontalAlignment="Right" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>
            <Border x:Name="LibrarySelectedDetailBorder" Grid.Row="1" Classes="aaos-card" Padding="14" IsVisible="False">
              <StackPanel Spacing="6">
                <TextBlock Text="所选资料" FontSize="14" FontWeight="SemiBold" Classes="provenance-evidence" />
                <TextBlock x:Name="LibrarySelectedSummaryText" TextWrapping="Wrap" Classes="card-heading" />
                <Expander x:Name="LibraryDetailDiagnostics" Header="更多信息：资料身份与处理记录" IsExpanded="False">
                <StackPanel Spacing="6">
                <TextBlock x:Name="LibrarySelectedDetailText" Text="尚未选择搜索结果。" TextWrapping="Wrap" Classes="provenance-projection" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                  <TextBlock Text="类型" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                  <TextBlock x:Name="LibraryDetailKindText" Grid.Column="1" FontSize="11" Classes="provenance-evidence" />
                  <TextBlock Grid.Row="1" Text="标题" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                  <TextBlock x:Name="LibraryDetailHeadText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AaosIvoryBrush}" />
                  <TextBlock Grid.Row="2" Text="状态" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                  <TextBlock x:Name="LibraryDetailStatusText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" FontSize="11" Classes="status-info" />
                  <TextBlock Grid.Row="3" Text="来源" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                  <TextBlock x:Name="LibraryDetailSourceText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" FontSize="11" Classes="provenance-original" />
                  <TextBlock Grid.Row="4" Text="Knowledge" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                  <TextBlock x:Name="LibraryDetailKnowledgeText" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" FontSize="11" Classes="provenance-projection" />
                  <TextBlock Grid.Row="5" Text="Transform" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                  <TextBlock x:Name="LibraryDetailTransformText" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" FontSize="11" Classes="provenance-projection" />
                  <TextBlock Grid.Row="6" Text="引擎" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                  <TextBlock x:Name="LibraryDetailEngineText" Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" FontSize="11" Classes="provenance-machine" />
                </Grid>
                <TextBlock x:Name="LibraryDetailBoundaryText" Text="字段来自 Core 搜索响应；缺失字段不推断。" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
                <TextBlock Text="字段来自 Core 搜索响应；缺失字段不推断为证据、原件或已验证知识。" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
                </StackPanel>
                </Expander>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="读取 Knowledge 详情" Padding="14,8" Click="OnOpenSelectedKnowledgeClick" AutomationProperties.Name="读取 Knowledge 详情" />
                  <Button x:Name="OpenLibrarySourceButton" Content="查看来源成员" IsEnabled="False" Padding="14,8" Click="OnOpenLibrarySourceClick" AutomationProperties.Name="查看来源成员" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
        <StackPanel x:Name="OriginalEditorSurface" IsVisible="False" Spacing="12">
          <Grid x:Name="OriginalEditorPageHeader" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="原创" Classes="section-heading" />
              <TextBlock Text="将可靠来源整理为自己的理解" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Border Classes="aaos-status" Padding="10,6" VerticalAlignment="Center">
                <TextBlock x:Name="OriginalEditorSaveStateText" Text="只读 · 未载入 Original" Classes="status-empty" AutomationProperties.Name="原创编辑保存状态" />
              </Border>
              <Button Content="保存草稿" IsEnabled="False" Padding="14,8" ToolTip.Tip="Core Original 写入契约尚未提供" AutomationProperties.Name="保存草稿暂不可用" />
            </StackPanel>
          </Grid>
          <Grid x:Name="OriginalEditorGrid" ColumnDefinitions="1.35*,0.95*" ColumnSpacing="14" RowSpacing="14">
            <Border x:Name="OriginalDocumentCard" Grid.Column="0" Classes="aaos-card" Padding="18">
              <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                <Border Classes="aaos-toolbar" Padding="7">
                  <Grid x:Name="OriginalEditorFormatToolbar" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="5">
                    <Button Content="H" IsEnabled="False" MinWidth="36" MinHeight="34" Padding="8,5" ToolTip.Tip="标题格式 · 等待 Core Original 写入契约" AutomationProperties.Name="标题格式暂不可用" />
                    <Button Grid.Column="1" Content="B" FontWeight="Bold" IsEnabled="False" MinWidth="36" MinHeight="34" Padding="8,5" ToolTip.Tip="粗体 · 等待 Core Original 写入契约" AutomationProperties.Name="粗体格式暂不可用" />
                    <Button Grid.Column="2" Content="I" FontStyle="Italic" IsEnabled="False" MinWidth="36" MinHeight="34" Padding="8,5" ToolTip.Tip="斜体 · 等待 Core Original 写入契约" AutomationProperties.Name="斜体格式暂不可用" />
                    <Button Grid.Column="3" IsEnabled="False" MinWidth="36" MinHeight="34" Padding="8,5" ToolTip.Tip="引用块 · 等待 Core Original 写入契约" AutomationProperties.Name="引用块格式暂不可用">
                      <local:AaosIcon Width="17" Height="17" IconName="Quote" />
                    </Button>
                    <TextBlock Grid.Column="5" Text="只读预览" Classes="lifecycle-label" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <Button x:Name="OriginalInsertReferenceButton" Grid.Column="6" IsEnabled="False" Padding="10,6" ToolTip.Tip="选择 Original 后，按 Core Evidence 绑定引用" AutomationProperties.Name="插入引用暂不可用">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <local:AaosIcon Width="15" Height="15" IconName="Link" />
                        <TextBlock Text="插入引用" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Border>
                <Border x:Name="OriginalDocumentCanvas" Grid.Row="1" Classes="aaos-card-compact" Padding="26,22" MinHeight="510">
                  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="15">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <Border Width="44" Height="56" CornerRadius="10" Background="{DynamicResource AaosSidebarBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                        <TextBlock Text="AA" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AaosPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="ORIGINAL · PERSONAL KNOWLEDGE" Classes="lifecycle-label" />
                        <TextBlock Text="版本与引用沿来源链保留" Classes="provenance-projection" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="只读" Classes="lifecycle-label" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="8">
                      <TextBlock Text="标题" FontSize="11" Classes="lifecycle-label" />
                      <TextBox x:Name="OriginalTitleBox" IsReadOnly="True" PlaceholderText="开始书写你的思考…" FontSize="26" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" CornerRadius="0" AutomationProperties.Name="原创标题" />
                      <Border Height="1" Margin="0,3,0,0" Background="{DynamicResource AaosBorderBrush}" />
                    </StackPanel>
                    <Grid x:Name="OriginalEditorBodyGrid" Grid.Row="2" MinHeight="370" Margin="0,3,0,0">
                      <StackPanel Spacing="40" Margin="0,2,0,16" IsHitTestVisible="False" AutomationProperties.Name="正文行仅为母版空态纹理；没有模拟原创内容" AutomationProperties.AccessibilityView="Raw">
                        <Border Classes="original-editor-page-line" Height="1" Background="{DynamicResource AaosPrimaryBrush}" Opacity="0.20" />
                        <Border Classes="original-editor-page-line" Height="1" Background="{DynamicResource AaosPrimaryBrush}" Opacity="0.20" />
                        <Border Classes="original-editor-page-line" Height="1" Background="{DynamicResource AaosPrimaryBrush}" Opacity="0.20" />
                        <Border Classes="original-editor-page-line" Height="1" Background="{DynamicResource AaosPrimaryBrush}" Opacity="0.20" />
                        <Border Classes="original-editor-page-line" Height="1" Background="{DynamicResource AaosPrimaryBrush}" Opacity="0.20" />
                        <Border Classes="original-editor-page-line" Height="1" Background="{DynamicResource AaosPrimaryBrush}" Opacity="0.20" />
                        <Border Classes="original-editor-page-line" Height="1" Background="{DynamicResource AaosPrimaryBrush}" Opacity="0.20" />
                        <Border Classes="original-editor-page-line" Height="1" Background="{DynamicResource AaosPrimaryBrush}" Opacity="0.20" />
                        <Border Classes="original-editor-page-line" Height="1" Background="{DynamicResource AaosPrimaryBrush}" Opacity="0.20" />
                        <Border Classes="original-editor-page-line" Height="1" Background="{DynamicResource AaosPrimaryBrush}" Opacity="0.20" />
                      </StackPanel>
                      <TextBox x:Name="OriginalEditorBodyBox" IsReadOnly="True" AcceptsReturn="True" MinHeight="370" VerticalContentAlignment="Top" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" CornerRadius="0" AutomationProperties.Name="原创正文编辑区" />
                    </Grid>
                  </Grid>
                </Border>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="4,0,4,2">
                  <TextBlock Text="正文与版本由 Core Original 提供；当前没有可写入的 Original。" TextWrapping="Wrap" Classes="status-empty" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="从资料库选择" Padding="13,8" Click="OnLibraryClick" AutomationProperties.Name="从资料库选择可追溯内容" />
                </Grid>
              </Grid>
            </Border>
            <StackPanel x:Name="OriginalReferenceRail" Grid.Column="1" Spacing="12">
              <Border Classes="aaos-card" Padding="16">
                <StackPanel Spacing="11">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <local:AaosIcon Width="18" Height="18" IconName="Evidence" Foreground="{DynamicResource AaosPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="引用来源" Classes="section-heading" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="EVIDENCE" Classes="lifecycle-label" VerticalAlignment="Center" />
                  </Grid>
                  <Border Classes="aaos-empty-state" Padding="13" MinHeight="76">
                    <TextBlock Text="尚无关联 Evidence" TextWrapping="Wrap" Classes="status-empty" VerticalAlignment="Center" HorizontalAlignment="Center" />
                  </Border>
                  <ListBox x:Name="OriginalEvidenceReferencesList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AaosIvoryBrush}" AutomationProperties.Name="原创关联证据引用" />
                  <TextBlock Text="引用仅呈现 Core 绑定的 Evidence。" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
                </StackPanel>
              </Border>
              <Border Classes="aaos-card" Padding="16">
                <StackPanel Spacing="11">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <local:AaosIcon Width="18" Height="18" IconName="History" Foreground="{DynamicResource AaosPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="版本历史" Classes="section-heading" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="VERSIONS" Classes="lifecycle-label" VerticalAlignment="Center" />
                  </Grid>
                  <Border Classes="aaos-empty-state" Padding="13" MinHeight="76">
                    <TextBlock Text="载入 Original 后显示真实版本。" TextWrapping="Wrap" Classes="status-empty" VerticalAlignment="Center" HorizontalAlignment="Center" />
                  </Border>
                  <ListBox x:Name="OriginalVersionHistoryList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AaosIvoryBrush}" AutomationProperties.Name="原创版本历史" />
                  <TextBlock Text="比较与冲突处理等待 Core Original 版本契约。" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>
        <views:SourceReaderView x:Name="SourceReaderView" IsVisible="False" />
        <StackPanel x:Name="SearchSurface" IsVisible="False" Spacing="14">
          <TextBlock Text="语义搜索、来源过滤、时间过滤和知识问答。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
          <Border Classes="aaos-card" Padding="18">
            <StackPanel Spacing="10">
              <TextBlock Text="搜索" Classes="card-heading" />
              <Grid x:Name="SearchPageQueryGrid" Classes="aaos-toolbar" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox x:Name="SearchPageQueryBox" MinHeight="48" FontSize="16" BorderBrush="{DynamicResource AaosPrimaryBrush}" BorderThickness="1" PlaceholderText="搜索你的知识、证据、原创或提出问题…" KeyDown="OnSearchPageKeyDown" AutomationProperties.Name="全局知识搜索关键词" />
                <Button x:Name="SearchPageSubmitButton" Grid.Column="1" Classes="primary-action" Click="OnSearchPageClick" Padding="22,12" AutomationProperties.Name="提交全局知识搜索">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <local:AaosIcon Width="16" Height="16" IconName="Search" />
                    <TextBlock Text="搜索" VerticalAlignment="Center" IsVisible="False" />
                  </StackPanel>
                </Button>
              </Grid>
              <StackPanel x:Name="SearchPageFilters" Orientation="Horizontal" HorizontalAlignment="Stretch" Spacing="8" Margin="0,4,0,0">
                <ComboBox x:Name="SearchPageTypeFilter" SelectedIndex="0" MinWidth="138" AutomationProperties.Name="搜索结果类型">
                  <ComboBoxItem Content="全部类型" />
                  <ComboBoxItem Content="仅 Knowledge" />
                  <ComboBoxItem Content="仅 Transform" />
                </ComboBox>
                <CheckBox x:Name="SearchPageActiveOnly" Content="仅当前有效" VerticalAlignment="Center" AutomationProperties.Name="仅当前有效知识" />
                <TextBlock x:Name="SearchPageFiltersStatus" Text="来源 · 主题 · 时间筛选：Core 暂未投影" Classes="status-empty" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ComboBox x:Name="SearchPageSourceFilter" IsVisible="False" IsEnabled="False" MinWidth="112" ToolTip.Tip="Core 尚未公开来源筛选字段" AutomationProperties.Name="来源筛选暂不可用">
                  <ComboBoxItem Content="来源 · 不可用" />
                </ComboBox>
                <ComboBox x:Name="SearchPageTopicFilter" IsVisible="False" IsEnabled="False" MinWidth="112" ToolTip.Tip="Core 尚未公开主题筛选字段" AutomationProperties.Name="主题筛选暂不可用">
                  <ComboBoxItem Content="主题 · 不可用" />
                </ComboBox>
                <ComboBox x:Name="SearchPageTimeFilter" IsVisible="False" IsEnabled="False" MinWidth="112" ToolTip.Tip="Core 尚未公开时间筛选字段" AutomationProperties.Name="时间筛选暂不可用">
                  <ComboBoxItem Content="时间 · 不可用" />
                </ComboBox>
              </StackPanel>
              <TextBlock x:Name="SearchPageStatusText" Text="搜索结果来自 Core；部分筛选项等待字段投影。" TextWrapping="Wrap" Classes="status-empty" />
              <Button x:Name="SearchPageSemanticButton" Content="语义搜索已确认知识" Classes="aaos-compact" HorizontalAlignment="Left" Click="OnSemanticSearchClick" AutomationProperties.Name="显式语义搜索已确认知识" />
              <Expander x:Name="SearchPageDiagnostics" Header="更多信息：搜索处理记录" IsExpanded="False">
                <SelectableTextBlock x:Name="SearchPageDiagnosticsText" TextWrapping="Wrap" />
              </Expander>
            </StackPanel>
          </Border>
          <Border Classes="aaos-card" Padding="14" MinHeight="520">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="结果" Classes="card-heading" />
                <TextBlock x:Name="SearchPageResultCountText" Grid.Column="1" Text="尚未读取搜索结果。" Classes="status-empty" FontSize="11" />
              </Grid>
              <Grid Grid.Row="1" RowDefinitions="Auto,*">
                <Border Classes="aaos-card-compact" Padding="10,8">
                  <Grid x:Name="SearchResultsHeaderGrid" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
                    <TextBlock Text="结果" Classes="lifecycle-label" />
                    <TextBlock Grid.Column="1" Text="类型" Classes="lifecycle-label" />
                    <TextBlock Grid.Column="2" Text="主题" Classes="lifecycle-label" />
                    <TextBlock Grid.Column="3" Text="来源" Classes="lifecycle-label" />
                    <TextBlock Grid.Column="4" Text="更新时间" Classes="lifecycle-label" />
                  </Grid>
                </Border>
                <Grid Grid.Row="1" MinHeight="430">
                  <ListBox x:Name="SearchPageResultsList" SelectionChanged="OnLibraryResultSelected" KeyDown="OnDetailListKeyDown" DoubleTapped="OnDetailListDoubleTapped" MinHeight="430" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AaosIvoryBrush}" AutomationProperties.Name="全局搜索结果">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="{x:Type local:LibraryResultRow}">
                        <Border Padding="10,12" Margin="0,0,0,2" CornerRadius="6" Background="{DynamicResource AaosSurfaceBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="0,0,0,1">
                          <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                            <TextBlock Text="{Binding Head}" Foreground="{DynamicResource AaosIvoryBrush}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding KindLabel}" Classes="provenance-evidence" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding TopicLabel}" Classes="status-empty" FontSize="11" VerticalAlignment="Center" AutomationProperties.Name="主题字段状态" />
                            <TextBlock Grid.Column="3" Text="{Binding SourceLabel}" Foreground="{DynamicResource AaosMutedBrush}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding UpdatedLabel}" Classes="status-empty" FontSize="11" VerticalAlignment="Center" AutomationProperties.Name="更新时间字段状态" />
                            <ScrollViewer Grid.Row="1" Grid.ColumnSpan="5" MaxHeight="220" IsVisible="{Binding HasBody}">
                              <SelectableTextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                            </ScrollViewer>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Border x:Name="SearchPageEmptyState" IsHitTestVisible="False" Classes="aaos-empty-state" Margin="2" Padding="24" VerticalAlignment="Stretch">
                    <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                      <local:AaosIcon Width="34" Height="34" IconName="Search" Foreground="{DynamicResource AaosPrimaryBrush}" HorizontalAlignment="Center" />
                      <TextBlock x:Name="SearchPageEmptyText" Text="输入关键词后读取 Core 搜索结果。" Classes="card-heading" TextAlignment="Center" TextWrapping="Wrap" />
                      <TextBlock Text="结果只显示 Core 返回的数据；未提供的筛选字段不会生成筛选值。" Classes="status-empty" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>
            </Grid>
          </Border>
        </StackPanel>
        <StackPanel x:Name="KnowledgeSurface" IsVisible="False" Spacing="14">
          <TextBlock Text="查看知识内容、来源和复核状态，再选择学习或提出问题。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
          <TextBlock x:Name="KnowledgeStateText" Classes="status-empty" Text="尚未读取 Knowledge V3。" TextWrapping="Wrap" AutomationProperties.Name="知识库状态" />
          <Expander x:Name="KnowledgeLookupDiagnostics" Header="更多信息：按标识读取知识" IsExpanded="False">
          <Grid x:Name="KnowledgeLoadGrid" Classes="aaos-toolbar" ColumnDefinitions="*,Auto" RowDefinitions="Auto" ColumnSpacing="10" RowSpacing="10">
            <TextBox x:Name="KnowledgeIdBox" PlaceholderText="输入 knowledge_id" TextChanged="OnKnowledgeIdChanged" KeyDown="OnToolbarInputKeyDown" AutomationProperties.Name="knowledge_id 输入" />
            <Button x:Name="KnowledgeLoadButton" Classes="primary-action" Grid.Column="1" Content="读取知识" Padding="16,9" Click="OnReadKnowledgeClick" AutomationProperties.Name="读取知识" />
          </Grid>
          </Expander>
          <Border Classes="aaos-card-compact" Padding="14">
            <StackPanel Spacing="8">
              <TextBlock Text="记录个人知识" Classes="card-heading" />
              <TextBlock Text="先保存为待确认条目。请注明资料出处，复核后再接受为知识。" TextWrapping="Wrap" FontSize="11" Classes="status-warning" />
              <TextBlock Text="来源类型（必选；按实际来源标记）" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
              <ComboBox x:Name="KnowledgeDraftSourceTypeBox" SelectedIndex="-1" AutomationProperties.Name="Knowledge 来源类型">
                <ComboBoxItem Content="个人笔记 · personal_note" Tag="personal_note" />
                <ComboBoxItem Content="个人定义 · personal_definition" Tag="personal_definition" />
                <ComboBoxItem Content="个人经验 · personal_experience" Tag="personal_experience" />
                <ComboBoxItem Content="项目观察 · project_observation" Tag="project_observation" />
                <ComboBoxItem Content="外部文档 · external_document" Tag="external_document" />
                <ComboBoxItem Content="权威参考 · authoritative_reference" Tag="authoritative_reference" />
                <ComboBoxItem Content="推导结论 · derived_inference" Tag="derived_inference" />
              </ComboBox>
              <ComboBox x:Name="KnowledgeDraftTypeBox" SelectedIndex="0" AutomationProperties.Name="Knowledge 类型">
                <ComboBoxItem Content="个人定义 · PERSONAL_DEFINITION" Tag="PERSONAL_DEFINITION" />
                <ComboBoxItem Content="个人笔记 · NOTE" Tag="NOTE" />
                <ComboBoxItem Content="观察 · OBSERVATION" Tag="OBSERVATION" />
                <ComboBoxItem Content="观点 · OPINION" Tag="OPINION" />
                <ComboBoxItem Content="问题 · QUESTION" Tag="QUESTION" />
                <ComboBoxItem Content="假设 · HYPOTHESIS" Tag="HYPOTHESIS" />
                <ComboBoxItem Content="事实主张 · FACTUAL_CLAIM" Tag="FACTUAL_CLAIM" />
              </ComboBox>
              <TextBox x:Name="KnowledgeDraftBodyBox" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="写下你要保存的个人知识；如基于资料，请自行注明出处。" AutomationProperties.Name="Knowledge 内容" />
              <TextBlock Text="支持依据与风险" Classes="card-heading" />
              <TextBlock Text="请选择支持依据与风险程度；置信度可以留空。保存后仍需人工复核。" TextWrapping="Wrap" FontSize="11" Classes="status-info" />
              <TextBlock Text="支持级别" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
              <ComboBox x:Name="KnowledgeDraftSupportLevelBox" SelectedIndex="0" AutomationProperties.Name="Knowledge 支持级别">
                <ComboBoxItem Content="未声明支持 · none" Tag="none" />
                <ComboBoxItem Content="弱支持 · weak" Tag="weak" />
                <ComboBoxItem Content="中等支持 · moderate" Tag="moderate" />
                <ComboBoxItem Content="强支持 · strong" Tag="strong" />
                <ComboBoxItem Content="权威支持 · authoritative" Tag="authoritative" />
              </ComboBox>
              <TextBox x:Name="KnowledgeDraftConfidenceBox" PlaceholderText="可留空；0 到 1 的人工记录值" AutomationProperties.Name="Knowledge 置信度（可选，0 到 1）" />
              <TextBlock Text="置信度是记录值，不代表准确率或校准结果。" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" TextWrapping="Wrap" />
              <TextBlock Text="风险级别（必选）" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
              <ComboBox x:Name="KnowledgeDraftRiskLevelBox" SelectedIndex="-1" AutomationProperties.Name="Knowledge 风险级别">
                <ComboBoxItem Content="请选择风险级别" Tag="" IsEnabled="False" />
                <ComboBoxItem Content="低 · low" Tag="low" />
                <ComboBoxItem Content="中 · medium" Tag="medium" />
                <ComboBoxItem Content="高 · high" Tag="high" />
                <ComboBoxItem Content="严重 · critical" Tag="critical" />
              </ComboBox>
              <TextBlock Text="有效时间（可选，统一使用 UTC：YYYY-MM-DDTHH:mm:ssZ）" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <TextBox x:Name="KnowledgeDraftValidFromBox" PlaceholderText="Valid from" AutomationProperties.Name="Knowledge 有效起始时间（UTC，可选）" />
                <TextBox x:Name="KnowledgeDraftValidToBox" Grid.Column="1" PlaceholderText="Valid to" AutomationProperties.Name="Knowledge 有效截止时间（UTC，可选）" />
              </Grid>
              <TextBox x:Name="KnowledgeDraftExternalEvidenceBox" MinHeight="58" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="外部证据引用；每行一项，可留空" AutomationProperties.Name="Knowledge 外部证据引用，每行一项（可选）" />
              <Button x:Name="CreateKnowledgeCandidateButton" Classes="primary-action" Content="保存为待确认条目" HorizontalAlignment="Left" Padding="16,9" Click="OnCreateKnowledgeCandidateClick" AutomationProperties.Name="创建 Knowledge Candidate" />
              <TextBlock x:Name="KnowledgeDraftStatusText" Text="尚未创建 Knowledge。" TextWrapping="Wrap" Classes="status-empty" AutomationProperties.Name="Knowledge 创建状态" />
            </StackPanel>
          </Border>
          <Button x:Name="BackToLibraryFromKnowledgeButton" Content="返回资料库 Evidence Detail" IsEnabled="False" HorizontalAlignment="Left" Padding="14,8" Click="OnBackToLibraryFromKnowledgeClick" AutomationProperties.Name="返回资料库 Evidence Detail" />
          <Button x:Name="OpenKnowledgeSourceButton" Content="查看 Knowledge 来源成员" IsEnabled="False" HorizontalAlignment="Left" Padding="14,8" Click="OnOpenKnowledgeSourceClick" AutomationProperties.Name="查看 Knowledge 来源成员" />
          <Border Classes="aaos-card-compact" Padding="14">
            <StackPanel Spacing="8">
              <TextBlock Text="真人学习" Classes="card-heading" />
              <TextBlock Text="已确认的知识或个人定义可以加入学习。加入后会生成学习题目，已有的复核状态会保留。" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
              <Button x:Name="AddKnowledgeToLearningButton" Classes="primary-action" Content="加入我的学习" IsEnabled="False" HorizontalAlignment="Left" Padding="16,9" Click="OnAddKnowledgeToLearningClick" AutomationProperties.Name="将当前 Knowledge 加入学习" />
              <Button x:Name="GenerateCourseButton" Content="从这条知识生成课件候选" IsEnabled="False" HorizontalAlignment="Left" Padding="16,9" Click="OnGenerateCourseClick" AutomationProperties.Name="从当前已确认知识生成待复核课件" />
              <Button Content="让机器回答这条知识" HorizontalAlignment="Left" Padding="16,9" Click="OnUseKnowledgeForMachineClick" AutomationProperties.Name="使用当前知识提出机器学习问题" />
              <TextBlock x:Name="KnowledgeLearningStatusText" Text="请先选择适合学习的知识。" TextWrapping="Wrap" Classes="status-empty" AutomationProperties.Name="加入学习状态" />
            </StackPanel>
          </Border>
          <Expander x:Name="KnowledgeSourceDiagnostics" Header="更多信息：来源与版本" IsExpanded="False">
          <Border x:Name="KnowledgeEvidenceContextBorder" Classes="aaos-card-compact" Padding="14">
            <StackPanel Spacing="6">
              <TextBlock Text="证据上下文" FontSize="14" FontWeight="SemiBold" Classes="provenance-evidence" />
              <TextBlock x:Name="KnowledgeContextSourceText" Text="来源：未暴露" TextWrapping="Wrap" FontSize="11" Classes="provenance-original" />
              <TextBlock x:Name="KnowledgeContextVersionText" Text="Knowledge 版本：未暴露" TextWrapping="Wrap" FontSize="11" Classes="provenance-projection" />
              <TextBlock x:Name="KnowledgeContextProjectionText" Text="当前投影：未读取" TextWrapping="Wrap" FontSize="11" Classes="status-info" />
              <TextBlock x:Name="KnowledgeContextBoundaryText" Text="字段缺失不推断；Knowledge 状态不等于学习掌握。" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
              <TextBlock x:Name="KnowledgeQualificationText" Text="qualification · 尚未读取" TextWrapping="Wrap" Classes="status-empty" AutomationProperties.Name="Core Knowledge qualification 状态" />
            </StackPanel>
          </Border>
          </Expander>
          <Border x:Name="KnowledgeObjectHeaderBorder" Classes="aaos-card" Padding="16">
            <StackPanel Spacing="5">
              <TextBlock Text="Knowledge 对象" FontSize="14" FontWeight="SemiBold" Classes="provenance-projection" />
              <TextBlock x:Name="KnowledgeObjectTitleText" Text="标题：未读取" Classes="section-heading" TextWrapping="Wrap" />
              <Expander Header="更多信息：知识身份" IsExpanded="False">
                <TextBlock x:Name="KnowledgeObjectMetaText" Text="knowledge_id：未暴露 · owner：未暴露" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" TextWrapping="Wrap" />
              </Expander>
            </StackPanel>
          </Border>
          <Border Padding="20" CornerRadius="10" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
            <StackPanel Spacing="12">
              <Expander x:Name="KnowledgeReadbackDiagnostics" Header="更多信息：读取记录" IsExpanded="False">
                <TextBlock x:Name="KnowledgeResultsText" Text="尚未读取知识。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
              </Expander>
              <Border Classes="aaos-card-compact" Padding="12">
                <StackPanel Spacing="5">
                  <TextBlock Text="正文投影" FontSize="13" FontWeight="SemiBold" Classes="provenance-evidence" />
                  <TextBlock x:Name="KnowledgeBodyText" Text="正文未读取；缺失字段不推断。" TextWrapping="Wrap" Foreground="{DynamicResource AaosIvoryBrush}" />
                  <TextBlock Text="正文来自 Core Knowledge V3 投影，不自动等于已接受 Evidence。" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
                </StackPanel>
              </Border>
              <Grid x:Name="KnowledgeFactsGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                <Border x:Name="KnowledgeStatusCard" Padding="12" CornerRadius="8" Background="{DynamicResource AaosSurfaceBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                  <StackPanel Spacing="3">
                    <TextBlock Text="状态" FontSize="12" Foreground="{DynamicResource AaosMutedBrush}" />
                    <TextBlock x:Name="KnowledgeStatusText" Text="未暴露" Foreground="{DynamicResource AaosIvoryBrush}" />
                  </StackPanel>
                </Border>
                <Border x:Name="KnowledgeSourceCard" Grid.Column="1" Padding="12" CornerRadius="8" Background="{DynamicResource AaosSurfaceBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                  <StackPanel Spacing="3">
                    <TextBlock Text="来源" FontSize="12" Foreground="{DynamicResource AaosMutedBrush}" />
                    <TextBlock x:Name="KnowledgeSourceText" Text="未暴露" Foreground="{DynamicResource AaosIvoryBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border x:Name="KnowledgeTrustCard" Grid.Row="1" Padding="12" CornerRadius="8" Background="{DynamicResource AaosSurfaceBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                  <StackPanel Spacing="3">
                    <TextBlock Text="支持 / 置信 / 风险" FontSize="12" Foreground="{DynamicResource AaosMutedBrush}" />
                    <TextBlock x:Name="KnowledgeTrustText" Text="未暴露" Foreground="{DynamicResource AaosIvoryBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border x:Name="KnowledgeReviewCard" Grid.Row="1" Grid.Column="1" Padding="12" CornerRadius="8" Background="{DynamicResource AaosSurfaceBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                  <StackPanel Spacing="3">
                    <TextBlock Text="需要人工复核" FontSize="12" Foreground="{DynamicResource AaosMutedBrush}" />
                    <TextBlock x:Name="KnowledgeReviewText" Text="未暴露" Foreground="{DynamicResource AaosIvoryBrush}" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border x:Name="KnowledgeHumanReviewBorder" Padding="12" CornerRadius="8" Background="{DynamicResource AaosSurfaceBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                  <TextBlock Text="人工复核" FontSize="13" FontWeight="SemiBold" Classes="provenance-evidence" />
                  <TextBlock x:Name="KnowledgeReviewAvailabilityText" Text="选择知识后检查复核条件。" TextWrapping="Wrap" Classes="status-empty" AutomationProperties.Name="当前知识复核可用状态" />
                  <TextBlock Text="请阅读内容和来源，再决定接受、拒绝或修订。你的决定会保存并重新核验。" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
                  <ComboBox x:Name="KnowledgeReviewActionBox" SelectedIndex="-1" SelectionChanged="OnKnowledgeReviewActionChanged" AutomationProperties.Name="人工复核决定">
                    <ComboBoxItem Content="接受 Candidate" Tag="accepted" />
                    <ComboBoxItem Content="拒绝 Candidate" Tag="rejected" />
                    <ComboBoxItem Content="弃用 Knowledge" Tag="deprecated" />
                    <ComboBoxItem Content="修订并建立后继版本" Tag="modified" />
                  </ComboBox>
                  <TextBox x:Name="KnowledgeReviewActorBox" PlaceholderText="复核人姓名（必填）" TextChanged="OnKnowledgeReviewInputChanged" AutomationProperties.Name="人工复核人姓名" />
                  <TextBox x:Name="KnowledgeReviewNoteBox" PlaceholderText="复核说明（可选）" AutomationProperties.Name="人工复核说明" />
                  <TextBox x:Name="KnowledgeReviewNewBodyBox" IsVisible="False" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="修订后的完整正文（修订动作必填）" AutomationProperties.Name="修订后的 Knowledge 正文" />
                  <Button x:Name="SubmitKnowledgeReviewButton" IsEnabled="False" HorizontalAlignment="Left" Padding="14,8" Content="提交人工复核决定" Click="OnSubmitKnowledgeReviewClick" AutomationProperties.Name="提交 Core 人工复核决定" />
                  <TextBlock x:Name="KnowledgeReviewActionStatusText" Text="读取 Candidate 后开始复核。" TextWrapping="Wrap" Classes="status-empty" AutomationProperties.Name="人工复核提交状态" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          <WrapPanel ItemWidth="190" ItemHeight="42" Orientation="Horizontal">
            <ComboBox x:Name="JobOutputKindBox" SelectedIndex="0" Margin="0,0,8,8" AutomationProperties.Name="读取任务输出类型">
              <ComboBoxItem Content="转换文本" Tag="text" />
              <ComboBoxItem Content="文档结构" Tag="document_structure" />
              <ComboBoxItem Content="损失报告" Tag="loss_report" />
            </ComboBox>
            <Button x:Name="JobReadOutputButton" Content="读取选中任务输出" IsEnabled="False" Margin="0,0,8,8" Padding="14,8" Click="OnReadJobOutputClick" AutomationProperties.Name="读取选中任务输出" />
            <Button x:Name="JobCancelButton" Content="请求取消选中尝试" IsEnabled="False" Margin="0,0,8,8" Padding="14,8" Click="OnCancelJobAttemptClick" AutomationProperties.Name="请求取消当前任务尝试" />
          </WrapPanel>
          <Border Padding="14" CornerRadius="10" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
            <StackPanel Spacing="8">
              <TextBlock Text="任务结果" Classes="card-heading" />
              <TextBlock x:Name="JobUserStatusText" Text="选择任务后查看处理结果。" TextWrapping="Wrap" Classes="status-empty" AutomationProperties.LiveSetting="Polite" />
              <Expander x:Name="JobOutputDiagnostics" Header="更多信息：原始输出与处理记录" IsExpanded="False">
              <StackPanel Spacing="8">
              <TextBlock Text="仅在最新尝试成功且前后身份一致时展示；取消请求需要继续刷新状态，已提交的成功结果不可撤销。" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
              <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="JobOutputText" Text="选择当前会话的任务回执后读取输出。" TextWrapping="Wrap" Classes="status-empty" AutomationProperties.Name="Core 任务输出内容" />
              </ScrollViewer>
              </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel x:Name="LearningSurface" IsVisible="False" Spacing="14">
          <TextBlock x:Name="LearningItemText" IsVisible="False" />
          <StackPanel x:Name="LearningPageHeader" Spacing="4">
            <TextBlock Text="人类学习" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AaosIvoryBrush}" IsVisible="False" />
            <TextBlock Text="学习计划、知识卡片、能力追踪和 FSRS 复习" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
          </StackPanel>
          <Border Classes="aaos-card" Padding="18">
            <StackPanel Spacing="10">
              <TextBlock Text="我的课件候选" Classes="section-heading" />
              <TextBlock x:Name="CourseStatusText" Text="在知识页选择已确认知识，生成课件后可在这里审阅并开始学习。" Classes="status-empty" TextWrapping="Wrap" AutomationProperties.Name="课件候选状态" />
              <StackPanel x:Name="CourseLessonBody" Spacing="8" IsVisible="False">
                <TextBlock x:Name="CourseTitleText" Classes="card-heading" TextWrapping="Wrap" />
                <TextBlock x:Name="CourseSourceText" Classes="provenance-original" TextWrapping="Wrap" />
                <ScrollViewer MaxHeight="380" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <SelectableTextBlock x:Name="CourseLessonText" TextWrapping="Wrap" AutomationProperties.Name="实际课件正文与学习目标" />
                </ScrollViewer>
                <Button x:Name="CourseStartLearningButton" Content="已审阅，开始学习" Classes="primary-action" HorizontalAlignment="Left" IsEnabled="False" Click="OnStartCourseLearningClick" AutomationProperties.Name="审阅课件后显式开始学习" />
              </StackPanel>
              <Expander x:Name="CourseDiagnostics" Header="更多信息：课件读回与诊断" IsExpanded="False">
                <StackPanel Spacing="8">
                  <TextBlock Text="高级读回适用于本入口生成的单条知识课件；会再次核验来源并读取课件，不会开始学习。课程数据和渲染回执仅供诊断。" TextWrapping="Wrap" Classes="status-info" />
                  <TextBox x:Name="CourseIdReadbackBox" PlaceholderText="已保存的 course_id" AutomationProperties.Name="高级课件标识读回" />
                  <Button x:Name="CourseReadbackButton" Content="重新读取课件" HorizontalAlignment="Left" Click="OnReadCourseClick" AutomationProperties.Name="高级操作：重新读取已保存课件" />
                  <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled">
                    <SelectableTextBlock x:Name="CourseDiagnosticsText" TextWrapping="Wrap" />
                  </ScrollViewer>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
          <WrapPanel x:Name="LearningMetricsGrid" ItemWidth="280" ItemHeight="126" HorizontalAlignment="Stretch">
            <Border Classes="aaos-card" Padding="18" Margin="0,0,14,12">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">
                <StackPanel Spacing="5">
                  <TextBlock Text="—" Classes="kpi-value metric-unknown" Foreground="{DynamicResource AaosPrimaryBrush}" />
                  <TextBlock Text="本月掌握" Classes="status-empty" />
                </StackPanel>
                <local:AaosIcon Grid.Column="1" Width="20" Height="20" IconName="Thinking" Foreground="{DynamicResource AaosPrimaryBrush}" Opacity="0.8" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Text="尚无 Core 掌握投影" FontSize="10" Classes="lifecycle-label" />
              </Grid>
            </Border>
            <Border Classes="aaos-card" Padding="18" Margin="0,0,14,12">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">
                <StackPanel Spacing="5">
                  <TextBlock Text="—" Classes="kpi-value metric-unknown" Foreground="{DynamicResource AaosPrimaryBrush}" />
                  <TextBlock Text="学习卡" Classes="status-empty" />
                </StackPanel>
                <local:AaosIcon Grid.Column="1" Width="20" Height="20" IconName="Knowledge" Foreground="{DynamicResource AaosPrimaryBrush}" Opacity="0.8" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Text="等待 Core 学习队列" FontSize="10" Classes="lifecycle-label" />
              </Grid>
            </Border>
            <Border Classes="aaos-card" Padding="18" Margin="0,0,14,12">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">
                <StackPanel Spacing="5">
                  <TextBlock Text="—" Classes="kpi-value metric-unknown" Foreground="{DynamicResource AaosPrimaryBrush}" />
                  <TextBlock Text="待复习" Classes="status-empty" />
                </StackPanel>
                <local:AaosIcon Grid.Column="1" Width="20" Height="20" IconName="Review" Foreground="{DynamicResource AaosPrimaryBrush}" Opacity="0.8" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Text="等待 FSRS 队列读回" FontSize="10" Classes="lifecycle-label" />
              </Grid>
            </Border>
            <Border Classes="aaos-card" Padding="18" Margin="0,0,14,12">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">
                <StackPanel Spacing="5">
                  <TextBlock Text="—" Classes="kpi-value metric-unknown" Foreground="{DynamicResource AaosPrimaryBrush}" />
                  <TextBlock Text="能力轨迹" Classes="status-empty" />
                </StackPanel>
                <local:AaosIcon Grid.Column="1" Width="20" Height="20" IconName="Growth" Foreground="{DynamicResource AaosPrimaryBrush}" Opacity="0.8" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Text="需要带时间戳的学习历史" FontSize="10" Classes="lifecycle-label" />
              </Grid>
            </Border>
          </WrapPanel>
          <Grid x:Name="LearningPlanGrid" ColumnDefinitions="1.25*,2*" ColumnSpacing="14" RowSpacing="14">
            <Border Classes="aaos-card" Padding="20">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="3">
                    <TextBlock Text="学习计划" Classes="section-heading" />
                    <TextBlock Text="学习路径与阶段进度" FontSize="11" Classes="lifecycle-label" />
                  </StackPanel>
                  <Button x:Name="LoadLearningButton" Grid.Column="1" Classes="primary-action" Content="载入学习路径" Padding="12,7" Click="OnLearningClick" AutomationProperties.Name="载入 Core 学习路径" />
                </Grid>
                <Border x:Name="LearningPlanPlaceholderRows" Classes="aaos-empty-state" MinHeight="300" Padding="16">
                  <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                        <local:AaosIcon Width="19" Height="19" IconName="HumanAi" Foreground="{DynamicResource AaosPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Core 学习路径" Classes="card-heading" />
                        <TextBlock x:Name="LearningStatusText" Text="学习路径尚未载入；尚未读取 Core 学习队列。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" AutomationProperties.Name="学习队列状态" />
                      </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource AaosBorderBrush}" />
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <local:AaosIcon Width="16" Height="16" IconName="Knowledge" Foreground="{DynamicResource AaosMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="计划阶段" Classes="status-empty" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="未载入" FontSize="10" Classes="lifecycle-label" VerticalAlignment="Center" />
                      </Grid>
                      <Border Height="8" CornerRadius="4" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1" />
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <local:AaosIcon Width="16" Height="16" IconName="Thinking" Foreground="{DynamicResource AaosMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="学习卡片" Classes="status-empty" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="等待队列" FontSize="10" Classes="lifecycle-label" VerticalAlignment="Center" />
                      </Grid>
                      <Border Height="8" CornerRadius="4" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1" />
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <local:AaosIcon Width="16" Height="16" IconName="Review" Foreground="{DynamicResource AaosMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="复习安排" Classes="status-empty" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="等待 FSRS" FontSize="10" Classes="lifecycle-label" VerticalAlignment="Center" />
                      </Grid>
                      <Border Height="8" CornerRadius="4" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1" />
                    </StackPanel>
                    <ListBox x:Name="LearningQueueList" MaxHeight="180" SelectionChanged="OnLearningQueueSelectionChanged" AutomationProperties.Name="待复习学习队列">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type local:LearningQueueRow}">
                          <Border Classes="aaos-card-compact" Padding="12" Margin="0,0,0,6">
                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="条目、进度和下次复习只来自 Core Learning projection。" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
                  </StackPanel>
                </Border>
                <StackPanel x:Name="LearningEmptyActions" Orientation="Horizontal" Spacing="8" IsVisible="False">
                  <Button Content="去捕获导入" Padding="12,7" Click="OnCaptureClick" AutomationProperties.Name="去捕获导入学习材料" />
                  <Button Content="查看任务状态" Padding="12,7" Click="OnLearningOpenJobsClick" AutomationProperties.Name="查看学习相关任务状态" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border x:Name="LearningGrowthPanel" Grid.Column="1" Classes="aaos-card" Padding="20">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="3">
                    <TextBlock Text="复习与能力增长" Classes="section-heading" />
                    <TextBlock Text="学习进度趋势" Classes="lifecycle-label" />
                  </StackPanel>
                  <local:AaosIcon Grid.Column="1" Width="18" Height="18" IconName="Growth" Foreground="{DynamicResource AaosPrimaryBrush}" VerticalAlignment="Center" />
                </Grid>
                <Border Classes="aaos-card-compact" Padding="12">
                  <Grid MinHeight="300" RowDefinitions="*,*,*,*" Margin="8,2">
                    <Border BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="0,0,0,1" />
                    <Border Grid.Row="1" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="0,0,0,1" />
                    <Border Grid.Row="2" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="0,0,0,1" />
                    <Border Grid.Row="3" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="0,0,0,1" />
                    <StackPanel Grid.RowSpan="4" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Border Width="54" Height="54" CornerRadius="27" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                        <local:AaosIcon Width="24" Height="24" IconName="Growth" Foreground="{DynamicResource AaosPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="趋势暂不可绘制" Classes="card-heading" HorizontalAlignment="Center" />
                      <TextBlock Text="Core 未提供带时间戳的学习历史指标。" TextWrapping="Wrap" TextAlignment="Center" Classes="status-empty" MaxWidth="280" />
                    </StackPanel>
                  </Grid>
                </Border>
                <TextBlock Text="仅展示 Core Learning projection；不会生成示例趋势或掌握度。" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
              </StackPanel>
            </Border>
          </Grid>
          <Expander x:Name="LearningSupportDetails" Header="队列、来源与复习详情" IsExpanded="False" AutomationProperties.Name="展开学习队列来源与复习详情">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <Border Classes="aaos-card" Padding="16">
                  <StackPanel Spacing="8">
                    <TextBlock Text="最近 Capture（未关联）" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AaosMutedBrush}" />
                    <TextBlock x:Name="LearningCaptureContextText" Text="最近 Capture：尚未形成；未证明与当前学习项目关联。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                    <StackPanel x:Name="LearningCaptureActions" Orientation="Horizontal" Spacing="8">
                      <Button x:Name="OpenLearningCaptureSourceButton" Content="打开最近来源" IsEnabled="False" Padding="12,7" Click="OnOpenLatestSourceClick" AutomationProperties.Name="打开最近来源" />
                      <Button x:Name="OpenLearningCaptureJobButton" Content="查看最近任务" IsEnabled="False" Padding="12,7" Click="OnOpenLatestJobClick" AutomationProperties.Name="查看最近任务" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border x:Name="LearningProvenancePanel" Grid.Column="1" Classes="aaos-card" Padding="16">
                  <StackPanel Spacing="8">
                    <TextBlock Text="来源链" Classes="section-heading" />
                    <TextBlock Text="证据" FontSize="12" Foreground="{DynamicResource AaosMutedBrush}" />
                    <TextBlock x:Name="LearningEvidenceText" Classes="provenance-evidence" Text="尚未载入 Core 学习来源。" TextWrapping="Wrap" />
                    <TextBlock Text="原件" FontSize="12" Foreground="{DynamicResource AaosMutedBrush}" />
                    <TextBlock x:Name="LearningOriginalText" Classes="provenance-original" Text="原件正文未从学习投影直接暴露。" TextWrapping="Wrap" />
                    <TextBlock Text="Knowledge / Assessment 版本" FontSize="12" Foreground="{DynamicResource AaosMutedBrush}" />
                    <TextBlock x:Name="LearningVersionText" Classes="provenance-projection" Text="尚未生成" TextWrapping="Wrap" />
                    <Button x:Name="OpenLearningKnowledgeButton" Content="打开当前 Knowledge 详情" IsEnabled="False" HorizontalAlignment="Left" Padding="14,8" Click="OnOpenLearningKnowledgeClick" AutomationProperties.Name="打开当前 Knowledge 详情" />
                    <TextBlock Text="记忆读回" FontSize="12" Classes="provenance-review" />
                    <TextBlock x:Name="LearningMemoryText" Classes="provenance-review" Text="学习记录：未读回" TextWrapping="Wrap" />
                    <TextBlock Text="记忆读回不是掌握度证明。" FontSize="11" Classes="status-empty" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border x:Name="LearningReviewCard" Classes="aaos-card-compact review-card" Padding="20">
                <StackPanel Spacing="10">
                  <TextBlock Text="Review Card · 当前复习" Classes="section-heading" />
                  <TextBlock Text="Learner Answer" FontSize="12" Classes="provenance-original" />
                  <TextBox x:Name="LearningAnswerBox" PlaceholderText="输入你的回答" IsEnabled="False" AutomationProperties.Name="学习回答输入框" />
                  <TextBlock Text="Assessment 判断" FontSize="12" Classes="status-info" />
                  <ComboBox x:Name="ReviewOutcomeBox" Classes="review-control" IsEnabled="False" SelectedIndex="0" AutomationProperties.Name="Core 正确性结果">
                    <ComboBoxItem Content="选择结果" />
                    <ComboBoxItem Content="回答正确" />
                    <ComboBoxItem Content="回答错误" />
                  </ComboBox>
                  <TextBlock Text="复习难度" FontSize="12" Classes="provenance-review" />
                  <TextBlock Text="复习难度只用于 Core 排程；不代表知识已被确认，也不代表掌握度指标，不会自动表示知识已接受。" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
                  <Grid x:Name="ReviewActionsGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <Button x:Name="ReviewAgainButton" Classes="review-grade" Content="Again · 重来" IsEnabled="False" Padding="14,8" Click="OnReviewAgainClick" AutomationProperties.Name="FSRS Again 重来" />
                    <Button x:Name="ReviewHardButton" Classes="review-grade" Grid.Column="1" Content="Hard · 吃力" IsEnabled="False" Padding="14,8" Click="OnReviewHardClick" AutomationProperties.Name="FSRS Hard 吃力" />
                    <Button x:Name="ReviewGoodButton" Classes="review-grade" Grid.Row="1" Content="Good · 正常" IsEnabled="False" Padding="14,8" Click="OnReviewGoodClick" AutomationProperties.Name="FSRS Good 正常" />
                    <Button x:Name="ReviewEasyButton" Classes="review-grade" Grid.Row="1" Grid.Column="1" Content="Easy · 轻松" IsEnabled="False" Padding="14,8" Click="OnReviewEasyClick" AutomationProperties.Name="FSRS Easy 轻松" />
                  </Grid>
                  <Button x:Name="SubmitReviewButton" Classes="primary-action" Content="提交复习结果" IsEnabled="False" HorizontalAlignment="Left" Padding="16,9" Click="OnSubmitReviewClick" AutomationProperties.Name="提交复习结果" />
                  <TextBlock x:Name="LearningReviewStatusText" Text="尚未提交复习；提交结果由 Core 回执决定。" TextWrapping="Wrap" Classes="status-empty" AutomationProperties.Name="复习提交状态" />
                  <Border x:Name="LearningReviewReceiptPanel" Classes="aaos-card-compact" Padding="12">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Core FSRS Receipt" FontSize="12" FontWeight="SemiBold" Classes="provenance-review" />
                      <TextBlock x:Name="LearningReviewReceiptText" Text="排程、下一次复习和 Mastery projection：尚未读取。" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
                      <TextBlock Text="排程字段来自 Core；Mastery projection 不等于 Knowledge Truth。" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </Expander>
        </StackPanel>
        <StackPanel x:Name="ReviewSurface" IsVisible="False" Spacing="14">
          <TextBlock Text="记忆调度、复习队列和掌握投影；FSRS 状态以 Core 回执为准。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
          <WrapPanel x:Name="ReviewMetricsGrid" Orientation="Horizontal" ItemWidth="250" ItemHeight="148" HorizontalAlignment="Stretch">
            <Border Classes="aaos-kpi" Padding="12,10" Margin="0,0,12,12">
              <StackPanel Spacing="4">
                <TextBlock Text="今日复习" Foreground="{DynamicResource AaosMutedBrush}" />
                <TextBlock Text="—" Classes="kpi-value metric-unknown" />
                <TextBlock Text="Core 尚未提供复习 KPI 与历史趋势" Classes="status-empty" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Classes="aaos-kpi" Padding="12,10" Margin="0,0,12,12">
              <StackPanel Spacing="4">
                <TextBlock Text="记忆率" Foreground="{DynamicResource AaosMutedBrush}" />
                <TextBlock Text="—" Classes="kpi-value metric-unknown" />
                <TextBlock Text="Core projection" Classes="status-empty" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Classes="aaos-kpi" Padding="12,10" Margin="0,0,12,12">
              <StackPanel Spacing="4">
                <TextBlock Text="稳定度" Foreground="{DynamicResource AaosMutedBrush}" />
                <TextBlock Text="—" Classes="kpi-value metric-unknown" />
                <TextBlock Text="Core projection" Classes="status-empty" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Classes="aaos-kpi" Padding="12,10" Margin="0,0,12,12">
              <StackPanel Spacing="4">
                <TextBlock Text="本周完成" Foreground="{DynamicResource AaosMutedBrush}" />
                <TextBlock Text="—" Classes="kpi-value metric-unknown" />
                <TextBlock Text="Core projection" Classes="status-empty" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </WrapPanel>
          <Grid x:Name="ReviewPageContentGrid" ColumnDefinitions="1.1*,0.9*" ColumnSpacing="14">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="复习队列" Classes="card-heading" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="primary-action" Content="载入今日队列" Padding="14,8" Click="OnLearningClick" AutomationProperties.Name="载入 Core 复习队列" />
              </Grid>
              <TextBlock x:Name="ReviewPageStatusText" Text="尚未读取 Core 复习队列。" Classes="status-empty" TextWrapping="Wrap" />
              <Border Classes="aaos-card" Padding="18">
                <Grid MinHeight="96">
                  <Border x:Name="ReviewQueueEmptyState" Classes="aaos-empty-state" Padding="14" AutomationProperties.Name="复习队列空状态">
                    <StackPanel Spacing="6" VerticalAlignment="Center">
                      <TextBlock x:Name="ReviewQueueEmptyTitle" Text="尚未载入复习队列" Classes="card-heading" HorizontalAlignment="Center" />
                      <TextBlock x:Name="ReviewQueueEmptyDescription" Text="载入 Core 今日队列后，这里会显示待复习卡片。" Classes="status-empty" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <ListBox x:Name="ReviewQueueList" SelectionChanged="OnLearningQueueSelectionChanged" MinHeight="96" MaxHeight="210" Background="Transparent" BorderThickness="0" IsVisible="False" AutomationProperties.Name="FSRS 待复习队列">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="{x:Type local:LearningQueueRow}">
                        <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="8" Background="{DynamicResource AaosSurface2Brush}">
                          <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
              <Border x:Name="ReviewCardSurface" Classes="aaos-card review-card" Padding="28" MinHeight="250" IsVisible="False">
                <Grid x:Name="ReviewCardFlipTransform" RenderTransformOrigin="50%,50%">
                  <Grid.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                  </Grid.RenderTransform>
                  <StackPanel x:Name="ReviewQuestionFace" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <TextBlock Text="QUESTION · 当前问题" Classes="lifecycle-label" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ReviewPagePromptText" Text="载入 Core 复习队列后显示当前 Assessment 问题。" TextWrapping="Wrap" Classes="section-heading" FontSize="26" HorizontalAlignment="Center" TextAlignment="Center" />
                    <Button x:Name="ReviewRevealButton" Classes="primary-action" IsEnabled="False" Content="展开复习" HorizontalAlignment="Center" Padding="22,12" Click="OnReviewRevealClick" AutomationProperties.Name="展开复习回答区" />
                  </StackPanel>
                  <StackPanel x:Name="ReviewAnswerFace" IsVisible="False" Spacing="12">
                    <TextBlock Text="RECALL · 先回想，再记录" Classes="lifecycle-label" />
                    <TextBox x:Name="ReviewPageAnswerBox" PlaceholderText="写下你的回答" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" IsEnabled="False" AutomationProperties.Name="FSRS 复习回答" />
                    <Expander x:Name="ReviewPageDiagnostics" Header="更多信息：来源与排程" IsExpanded="False">
                      <TextBlock x:Name="ReviewPageReceiptText" Text="评分、Evidence、Knowledge 版本和排程以 Core 回执为准。" TextWrapping="Wrap" Classes="provenance-projection" Margin="0,10,0,0" />
                    </Expander>
                    <TextBlock Text="Assessment 判断" Classes="lifecycle-label" />
                    <ComboBox x:Name="ReviewPageOutcomeBox" Classes="review-control" IsEnabled="False" SelectedIndex="0" SelectionChanged="OnReviewPageOutcomeChanged" AutomationProperties.Name="复习回答正确性">
                      <ComboBoxItem Content="选择结果" />
                      <ComboBoxItem Content="回答正确" />
                      <ComboBoxItem Content="回答错误" />
                    </ComboBox>
                    <Grid x:Name="ReviewActionsGrid2" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                      <Button x:Name="ReviewAgainButton2" Classes="review-grade" Content="Again" IsEnabled="False" Padding="14,9" Click="OnReviewAgainClick" AutomationProperties.Name="FSRS Again" />
                      <Button x:Name="ReviewHardButton2" Grid.Column="1" Classes="review-grade" Content="Hard" IsEnabled="False" Padding="14,9" Click="OnReviewHardClick" AutomationProperties.Name="FSRS Hard" />
                      <Button x:Name="ReviewGoodButton2" Grid.Column="2" Classes="review-grade" Content="Good" IsEnabled="False" Padding="14,9" Click="OnReviewGoodClick" AutomationProperties.Name="FSRS Good" />
                      <Button x:Name="ReviewEasyButton2" Grid.Column="3" Classes="review-grade" Content="Easy" IsEnabled="False" Padding="14,9" Click="OnReviewEasyClick" AutomationProperties.Name="FSRS Easy" />
                    </Grid>
                    <Button x:Name="SubmitReviewButton2" Classes="primary-action" Content="提交复习结果" IsEnabled="False" HorizontalAlignment="Left" Padding="16,9" Click="OnSubmitReviewClick" AutomationProperties.Name="提交 FSRS 复习结果" />
                    <TextBlock x:Name="ReviewPageCommitStatusText" Text="复习提交尚未开始。" TextWrapping="Wrap" Classes="status-empty" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
            <Border Grid.Column="1" Classes="aaos-card" Padding="18">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="记忆调度" Classes="card-heading" />
                  <TextBlock Grid.Column="1" Text="Core projection" Classes="lifecycle-label" />
                </Grid>
                <local:AaosReviewScheduleChart MinHeight="340" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
        <StackPanel x:Name="MachineKnowledgeSurface" IsVisible="False" Spacing="14">
          <Border Classes="aaos-card" Padding="22">
            <StackPanel Spacing="16">
              <TextBlock Text="一起改进回答" Classes="section-heading" />
              <TextBlock Text="选择已接受的知识，提出问题；发现错误时，用你的纠正让机器再答一次。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
              <Border Classes="aaos-card-compact" Padding="14">
                <StackPanel Spacing="8">
                  <TextBlock Text="1 · 选择知识并提问" Classes="card-heading" />
                  <TextBlock x:Name="MachineKnowledgePreviewText" Text="从知识库打开一条知识，点击“让机器回答这条知识”。" TextWrapping="Wrap" MaxHeight="180" />
                  <Button Content="前往知识库" Click="OnKnowledgeClick" HorizontalAlignment="Left" Padding="14,8" AutomationProperties.Name="前往知识库选择已接受知识" />
                  <TextBox x:Name="MachineQuestionBox" PlaceholderText="针对这条知识，你想问什么？" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="180" AutomationProperties.Name="机器学习问题" />
                  <Button x:Name="MachineAskButton" Content="回答问题" Classes="primary-action" Click="OnMachineAnswerClick" HorizontalAlignment="Left" Padding="18,10" AutomationProperties.Name="使用已接受知识请求模型回答" />
                </StackPanel>
              </Border>
              <Border Classes="aaos-card-compact aaos-animated-surface" Padding="14">
                <StackPanel Spacing="9">
                  <TextBlock Text="2 · 检查回答，写下纠正" Classes="card-heading" />
                  <TextBlock x:Name="MachineAskedQuestionText" Text="先选择知识，再提出一个具体问题。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
                  <SelectableTextBlock x:Name="MachineAnswerText" Text="回答会显示在这里，请对照知识自行判断。" TextWrapping="Wrap" />
                  <TextBox x:Name="MachineErrorNoteBox" PlaceholderText="具体哪一处有错误？" IsEnabled="False" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" AutomationProperties.Name="真人发现的具体错误" />
                  <TextBox x:Name="MachineCorrectedAnswerBox" PlaceholderText="写下你认为正确的回答" IsEnabled="False" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" AutomationProperties.Name="真人纠正后的回答" />
                  <Button x:Name="MachineCorrectButton" Content="记录我的纠正" IsEnabled="False" Click="OnMachineCorrectionClick" HorizontalAlignment="Left" Padding="18,10" AutomationProperties.Name="保存真人纠正为待复核候选" />
                </StackPanel>
              </Border>
              <Border Classes="aaos-card-compact" Padding="14">
                <StackPanel Spacing="9">
                  <TextBlock Text="3 · 复核纠正，再答原题" Classes="card-heading" />
                  <TextBlock x:Name="MachineCorrectionPreviewText" Text="发现错误后，写下原因和你认为正确的回答。" TextWrapping="Wrap" />
                  <WrapPanel Orientation="Horizontal">
                    <Button x:Name="MachineAcceptCorrectionButton" Content="接受这条纠正" IsEnabled="False" Click="OnMachineAcceptCorrectionClick" Margin="0,0,8,8" Padding="18,10" AutomationProperties.Name="真人接受已显示的纠正候选" />
                    <Button x:Name="MachineRetestButton" Content="使用纠正重答原题" Classes="primary-action" IsEnabled="False" Click="OnMachineRetestClick" Margin="0,0,0,8" Padding="18,10" AutomationProperties.Name="链接失败任务重新回答原题" />
                  </WrapPanel>
                  <SelectableTextBlock x:Name="MachineRetestAnswerText" Text="接受纠正后，再次回答同一个问题。" TextWrapping="Wrap" />
                  <TextBlock Text="比较两次回答，判断纠正是否有帮助。保存记录不会自动训练模型。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" FontSize="12" />
                  <Button x:Name="MachineJourneyReadbackButton" Content="重新读取已保存记录" IsEnabled="False" Click="OnMachineJourneyReadbackClick" HorizontalAlignment="Left" Padding="14,8" AutomationProperties.Name="重新读取已保存的机器学习旅程" />
                </StackPanel>
              </Border>
              <ProgressBar x:Name="MachineJourneyProgress" IsIndeterminate="True" IsVisible="False" Height="4" AutomationProperties.Name="机器学习请求正在执行" />
              <TextBlock x:Name="MachineJourneyWaitingText" Text="正在处理，请稍候…" IsVisible="False" Classes="status-info" AutomationProperties.LiveSetting="Polite" />
              <TextBlock x:Name="MachineJourneyStatusText" Text="等待选择知识和问题。" TextWrapping="Wrap" Classes="status-empty" AutomationProperties.LiveSetting="Polite" />
              <Expander Header="查看更早轮次的回答与纠正" IsExpanded="False">
                <SelectableTextBlock x:Name="MachineJourneyHistoryText" Text="尚无更早轮次。" TextWrapping="Wrap" Margin="0,10,0,0" />
              </Expander>
              <Expander x:Name="MachineJourneyDiagnostics" Header="更多信息：身份与请求诊断" IsExpanded="False">
                <StackPanel Spacing="10" Margin="0,10,0,0">
                  <TextBlock Text="可从知识库带入条目，也可手动指定已接受知识。" TextWrapping="Wrap" />
                  <TextBox x:Name="MachineKnowledgeIdBox" PlaceholderText="knowledge_id" AutomationProperties.Name="高级机器学习知识标识" />
                  <SelectableTextBlock x:Name="MachineJourneyIdentityText" Text="尚无持久化身份。" TextWrapping="Wrap" />
                  <SelectableTextBlock x:Name="MachineJourneyDiagnosticsText" Text="尚未发送请求。" TextWrapping="Wrap" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
          <Expander Header="更多信息：知识供给与模型指标" IsExpanded="False">
            <StackPanel Spacing="14" Margin="0,10,0,0">
          <WrapPanel x:Name="MachineMetricGrid" Orientation="Horizontal" ItemWidth="250" ItemHeight="126" HorizontalAlignment="Stretch">
            <Border Classes="aaos-kpi" Padding="12,10" Margin="0,0,12,12" AutomationProperties.Name="知识模块指标，等待 Core 汇总">
              <StackPanel Spacing="4">
                <TextBlock Text="知识模块" Foreground="{DynamicResource AaosMutedBrush}" TextWrapping="Wrap" />
                <TextBlock Text="—" Classes="kpi-value" />
                <TextBlock Text="Core 尚未提供总量" Classes="status-empty" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Classes="aaos-kpi" Padding="12,10" Margin="0,0,12,12" AutomationProperties.Name="模型指标，等待 Core 汇总">
              <StackPanel Spacing="4">
                <TextBlock Text="模型" Foreground="{DynamicResource AaosMutedBrush}" TextWrapping="Wrap" />
                <TextBlock Text="—" Classes="kpi-value" />
                <TextBlock Text="尚无 Registry 汇总" Classes="status-empty" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Classes="aaos-kpi" Padding="12,10" Margin="0,0,12,12" AutomationProperties.Name="标签指标，等待 Core 汇总">
              <StackPanel Spacing="4">
                <TextBlock Text="标签" Foreground="{DynamicResource AaosMutedBrush}" TextWrapping="Wrap" />
                <TextBlock Text="—" Classes="kpi-value" />
                <TextBlock Text="Core 尚未提供总量" Classes="status-empty" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Classes="aaos-kpi" Padding="12,10" Margin="0,0,12,12" AutomationProperties.Name="知识关联率指标，等待 Core 汇总">
              <StackPanel Spacing="4">
                <TextBlock Text="关联率" Foreground="{DynamicResource AaosMutedBrush}" TextWrapping="Wrap" />
                <TextBlock Text="—" Classes="kpi-value" />
                <TextBlock Text="Core 尚未提供覆盖率" Classes="status-empty" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </WrapPanel>
          <Grid x:Name="MachineLearningPanels" ColumnDefinitions="0.89*,1*" ColumnSpacing="14">
            <Border Classes="aaos-card" Padding="18" MinHeight="512">
              <StackPanel Spacing="18">
                <TextBlock Text="知识供给" Classes="card-heading" />
                <Border MinHeight="53" Padding="18,12" CornerRadius="8" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="Embedding" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Core 未暴露" Classes="status-empty" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                </Border>
                <Border MinHeight="53" Padding="18,12" CornerRadius="8" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="LLM Context" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Core 未暴露" Classes="status-empty" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                </Border>
                <Border MinHeight="53" Padding="18,12" CornerRadius="8" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="Auto Tagging" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Core 未暴露" Classes="status-empty" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                </Border>
                <Border MinHeight="53" Padding="18,12" CornerRadius="8" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="Topic Graph" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Core 未暴露" Classes="status-empty" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                </Border>
                <Border MinHeight="53" Padding="18,12" CornerRadius="8" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="Summarizer" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Core 未暴露" Classes="status-empty" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="aaos-card" Padding="18" MinHeight="512">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="模型理解趋势" Classes="card-heading" />
                  <TextBlock Grid.Column="1" Text="Core 投影" Classes="lifecycle-label" ToolTip.Tip="趋势来源为 Core；当前未提供历史指标" />
                </Grid>
                <Grid x:Name="MachineTrendChart" MinHeight="420" RowDefinitions="*,*,*,*" AutomationProperties.Name="等待 Core 历史指标的机器学习趋势图网格">
                  <Border Grid.Row="0" Classes="machine-trend-gridline" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="0,0,0,1" />
                  <Border Grid.Row="1" Classes="machine-trend-gridline" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="0,0,0,1" />
                  <Border Grid.Row="2" Classes="machine-trend-gridline" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="0,0,0,1" />
                  <Border Grid.Row="3" Classes="machine-trend-gridline" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="0,0,0,1" />
                  <Border Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource AaosSurfaceBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7">
                    <TextBlock x:Name="MachineTrendStatusText" Text="趋势暂不可用 · Core 尚未提供历史指标" TextWrapping="Wrap" FontSize="13" Classes="status-empty" HorizontalAlignment="Center" AutomationProperties.Name="机器学习趋势等待 Core 指标" />
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
            </StackPanel>
          </Expander>
          <Expander x:Name="MachineTaskReceiptDetails" Header="恢复记录与任务诊断" IsExpanded="False" AutomationProperties.Name="展开机器任务收据查询">
            <StackPanel Spacing="12" Margin="0,10,0,0">
              <TextBlock Text="读取指定机器任务收据。回执是测量事实，不代表模型已训练或知识已自动升级。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
              <Grid x:Name="MachineTaskGrid" Classes="aaos-toolbar" ColumnDefinitions="*,Auto" RowDefinitions="Auto" ColumnSpacing="10" RowSpacing="10">
                <TextBox x:Name="MachineTaskIdBox" PlaceholderText="输入 task_id" KeyDown="OnToolbarInputKeyDown" AutomationProperties.Name="task_id 输入" />
                <Button x:Name="MachineTaskLoadButton" Grid.Column="1" Content="读取任务收据" Padding="16,9" Click="OnReadMachineTaskClick" AutomationProperties.Name="读取任务收据" />
              </Grid>
              <Border Padding="20" CornerRadius="10" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                  <TextBlock x:Name="MachineTaskStatusText" Classes="status-empty" Text="empty · 输入 task_id 后读取 Core。" TextWrapping="Wrap" AutomationProperties.Name="机器任务收据读取状态" AutomationProperties.LiveSetting="Polite" />
                  <TextBlock x:Name="MachineTaskResultsText" Text="尚未读取机器任务收据。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" AutomationProperties.Name="机器任务收据内容" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Expander>
        </StackPanel>
        <StackPanel x:Name="RecoverySurface" IsVisible="False" Spacing="16">
          <Border Classes="aaos-card" Padding="20,18" Background="{DynamicResource AaosSurface2Brush}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
              <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource AaosSidebarBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                <local:AaosIcon Width="23" Height="23" IconName="Import" Foreground="{DynamicResource AaosPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="恢复与数据边界" Classes="section-heading" />
                <TextBlock Text="RECOVERY · READ ONLY" Classes="provenance-tag" FontSize="11" />
                <TextBlock Text="读取 Core 运行版本与工作区对象计数。此信息用于确认当前边界，不等于备份清单或可恢复性证明。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
              </StackPanel>
            </Grid>
          </Border>
          <WrapPanel x:Name="RecoverySummaryGrid" Orientation="Horizontal" ItemWidth="236" ItemHeight="138" HorizontalAlignment="Stretch">
            <Border Classes="aaos-card" Margin="0,0,12,12" Padding="16" Background="{DynamicResource AaosSurface2Brush}">
              <StackPanel Spacing="8">
                <local:AaosIcon Width="20" Height="20" IconName="Info" Foreground="{DynamicResource AaosPrimaryBrush}" />
                <TextBlock Text="运行合同" Classes="card-heading" />
                <TextBlock Text="Runtime、Contract、Schema 由 Core 版本端点回读。" Classes="status-empty" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Classes="aaos-card" Margin="0,0,12,12" Padding="16" Background="{DynamicResource AaosSurface2Brush}">
              <StackPanel Spacing="8">
                <local:AaosIcon Width="20" Height="20" IconName="Source" Foreground="{DynamicResource AaosPrimaryBrush}" />
                <TextBlock Text="工作区计数" Classes="card-heading" />
                <TextBlock Text="仅展示 Core 返回的来源和锚点计数；不代表文件备份完整性。" Classes="status-empty" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Classes="aaos-card" Margin="0,0,12,12" Padding="16" Background="{DynamicResource AaosSurface2Brush}">
              <StackPanel Spacing="8">
                <local:AaosIcon Width="20" Height="20" IconName="Connection" Foreground="{DynamicResource AaosMutedBrush}" />
                <TextBlock Text="恢复点与执行" Classes="card-heading" />
                <TextBlock Text="Core 尚未公开恢复点清单；本页没有执行、预演或模拟恢复。" Classes="status-empty" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </WrapPanel>
          <Border Classes="aaos-card" Padding="18">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="Core 边界回读" Classes="section-heading" />
                  <TextBlock Text="状态只来自当前 Core 响应；未读取前不会显示推测值。" Classes="status-empty" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="ReadRecoveryStatusButton" Grid.Column="1" Classes="primary-action" Content="读取当前边界" Padding="16,9" Click="OnReadRecoveryStatusClick" AutomationProperties.Name="读取恢复边界状态" ToolTip.Tip="读取 /api/v1/system/version 与 /api/v1/workspaces/info；不会执行恢复" />
              </Grid>
              <Border Padding="16" CornerRadius="10" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                <Expander x:Name="RecoveryDiagnostics" Header="更多信息：恢复检查记录" IsExpanded="False">
                  <TextBlock x:Name="RecoveryResultsText" Classes="status-empty" Text="empty · 点击读取 Core 状态。" TextWrapping="Wrap" AutomationProperties.Name="Core 恢复边界回读" AutomationProperties.LiveSetting="Polite" />
                </Expander>
              </Border>
              <TextBlock Text="执行恢复仍需 Core 备份清单、目标版本校验、授权确认、事务结果及回滚回执；这些合同当前未接入。" Classes="status-warning" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
        <views:EvidenceCenterView x:Name="EvidenceCenterView" IsVisible="False" RefreshRequested="OnEvidenceRefreshRequested" AnchorSelected="OnEvidenceAnchorSelected" DetailModeChanged="OnEvidenceDetailModeChanged" OpenCaptureRequested="OnEvidenceOpenCaptureRequested" OpenJobsRequested="OnEvidenceOpenJobsRequested" OpenSourceRequested="OnEvidenceOpenSourceRequested" />
        <StackPanel x:Name="MemoryMapSurface" IsVisible="False" Spacing="14">
          <TextBlock Text="记忆地图 · 搜索 · 复习" Classes="section-heading" />
          <Grid x:Name="MemoryMapVisualGrid" ColumnDefinitions="1.35*,0.95*" ColumnSpacing="16" RowSpacing="14">
            <Border x:Name="MemoryMapGraphCard" Classes="aaos-card" Padding="18">
              <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
                <TextBlock Text="记忆地图  Memory Map" Classes="section-heading" VerticalAlignment="Center" />
                <Viewbox x:Name="MemoryMapIllustration" Grid.Row="1" MaxWidth="560" MaxHeight="420" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <local:AaosMemoryGraphView x:Name="MemoryMapMotherGraph" NodeSelected="OnMemoryMapNodeSelected" />
                </Viewbox>
                <TextBlock Grid.Row="2" Text="示意网络不代表 Core 知识条目或真实关系；真实图谱投影尚未提供。" Classes="status-empty" TextWrapping="Wrap" />
                <Expander Grid.Row="3" Header="高级：图谱控制与知识关系查询" IsExpanded="False" AutomationProperties.Name="展开记忆地图图谱控制与知识关系查询">
                  <StackPanel Spacing="10" Margin="0,8,0,0">
                    <TextBlock x:Name="MemoryMapStatusText" Classes="status-empty" Text="尚未读取 Core 的知识谱系。Core 尚未提供记忆图谱的节点与关系投影。" TextWrapping="Wrap" AutomationProperties.Name="记忆地图状态；图形元素不代表实时 Core 数据" />
                    <Grid x:Name="MemoryMapToolbar" Classes="aaos-toolbar" ColumnDefinitions="*,Auto" RowDefinitions="Auto" ColumnSpacing="8" RowSpacing="8">
                      <TextBox x:Name="MemoryMapKnowledgeIdBox" PlaceholderText="knowledge_id" KeyDown="OnToolbarInputKeyDown" AutomationProperties.Name="记忆地图 knowledge_id 输入" />
                      <Button x:Name="MemoryMapLoadButton" Classes="primary-action" Grid.Column="1" Content="读取谱系" Padding="12,9" Click="OnMemoryMapLoadClick" AutomationProperties.Name="读取 Knowledge 谱系" />
                    </Grid>
                    <TextBlock x:Name="MemoryMapNodeDetailsText" Text="选择示意节点；真实关联详情等待 Core Graph projection。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
                    <Expander x:Name="MemoryMapDiagnostics" Header="更多信息：知识关系记录" IsExpanded="False">
                      <TextBlock x:Name="MemoryMapResultsText" Text="输入 knowledge_id 后读取 Core。" TextWrapping="Wrap" Classes="provenance-projection" AutomationProperties.Name="Knowledge 谱系结果" />
                    </Expander>
                    <TextBlock Text="谱系不等于记忆图谱；当前不展示随机关系或未绑定来源的结论。" TextWrapping="Wrap" FontSize="11" Classes="status-empty" />
                  </StackPanel>
                </Expander>
              </Grid>
            </Border>
            <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="16">
              <Border x:Name="MemoryMapSearchCard" Grid.Row="0" Classes="aaos-card" Padding="20" MinHeight="210">
                <StackPanel Spacing="15">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <local:AaosIcon Width="22" Height="22" IconName="Search" Foreground="{DynamicResource AaosPrimaryBrush}" />
                    <TextBlock Text="搜索  Search" Classes="section-heading" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="MemoryMapSearchBox" MinHeight="46" PlaceholderText="搜索你的知识…" KeyDown="OnMemoryMapSearchKeyDown" AutomationProperties.Name="从记忆地图搜索 Core 知识" />
                    <Button x:Name="MemoryMapSearchButton" Grid.Column="1" Classes="primary-action" Padding="16,8" Content="搜索" Click="OnMemoryMapSearchClick" AutomationProperties.Name="打开搜索并提交 Core 查询" />
                  </Grid>
                  <TextBlock Text="语义搜索 · 跨源检索 · AI 问答 · 精确定位：可用范围以搜索页 Core 状态为准。" Classes="status-empty" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border x:Name="MemoryMapReviewCard" Grid.Row="1" Classes="aaos-card" Padding="20" MinHeight="230">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="15">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <local:AaosIcon Width="22" Height="22" IconName="Calendar" Foreground="{DynamicResource AaosPrimaryBrush}" />
                      <TextBlock Text="复习 / FSRS  Review" Classes="section-heading" />
                    </StackPanel>
                    <TextBlock Text="基于遗忘曲线的智能复习。让真实的知识，在一次次回忆中沉淀。" FontSize="17" TextWrapping="Wrap" Foreground="{DynamicResource AaosIvoryBrush}" />
                    <Button x:Name="MemoryMapStartReviewButton" Classes="primary-action" Content="开始复习" Padding="18,10" HorizontalAlignment="Left" Click="OnReviewClick" AutomationProperties.Name="打开真实 Core 复习队列" />
                    <TextBlock Text="队列与排程由 Core 读取；未提供统计时不显示示例柱形图。" Classes="status-empty" TextWrapping="Wrap" />
                  </StackPanel>
                  <local:AaosIcon Grid.Column="1" Width="42" Height="42" IconName="Calendar" Foreground="{DynamicResource AaosPrimaryBrush}" VerticalAlignment="Bottom" AutomationProperties.AccessibilityView="Raw" />
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </StackPanel>
        <StackPanel x:Name="WorkspaceSurface" IsVisible="False" Spacing="14">
          <TextBlock Text="项目空间、资料、任务、协作与长期知识资产。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
          <Grid x:Name="WorkspacePageGrid" ColumnDefinitions="0.29*,0.71*" ColumnSpacing="24">
            <Border x:Name="WorkspaceTreePanel" Classes="aaos-card" Padding="20" MinHeight="620">
              <Grid RowDefinitions="Auto,*" RowSpacing="16">
                <StackPanel Spacing="5">
                  <TextBlock Text="空间" Classes="section-heading" />
                  <TextBlock Text="等待 Core 空间树投影" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Grid Grid.Row="1">
                  <TreeView x:Name="WorkspaceTreeView" Background="Transparent" BorderThickness="0" AutomationProperties.Name="工作区空间树；等待 Core 投影" />
                  <Border Classes="aaos-empty-state" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340" IsHitTestVisible="False" AutomationProperties.Name="工作区空间树空状态；等待 Core 提供真实空间">
                    <StackPanel Spacing="11" HorizontalAlignment="Center">
                      <local:AaosIcon Width="32" Height="32" IconName="Workspace" Foreground="{DynamicResource AaosPrimaryBrush}" HorizontalAlignment="Center" />
                      <TextBlock Text="空间树暂不可用" Classes="empty-title" TextAlignment="Center" />
                      <TextBlock Text="Core 尚未提供空间目录投影。连接后将在这里显示真实空间，不展示演示目录。" TextWrapping="Wrap" Classes="status-empty" TextAlignment="Center" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>
            </Border>
            <Border x:Name="WorkspaceFilesPanel" Grid.Column="1" Classes="aaos-card" Padding="20" MinHeight="620">
              <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="4">
                    <TextBlock Text="文件与知识资产" Classes="card-heading" />
                    <TextBlock Text="等待选择 Core 空间" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="新建文档" IsEnabled="False" ToolTip.Tip="Core 尚未提供工作区写入合同" AutomationProperties.Name="新建文档暂不可用" />
                  <Button Grid.Column="2" IsEnabled="False" ToolTip.Tip="等待工作区文件投影" AutomationProperties.Name="文件视图暂不可用">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Text="列表" VerticalAlignment="Center" />
                      <local:AaosIcon Width="14" Height="14" IconName="ChevronDown" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="2*,*,*,Auto" ColumnSpacing="12" Margin="0,4,0,0">
                  <TextBlock Text="名称" Classes="table-header" />
                  <TextBlock Grid.Column="1" Text="类型" Classes="table-header" />
                  <TextBlock Grid.Column="2" Text="更新时间" Classes="table-header" />
                  <TextBlock Grid.Column="3" Text="成员" Classes="table-header" />
                </Grid>
                <Border x:Name="WorkspaceFilesEmptyState" Grid.Row="2" Classes="aaos-card-compact" Padding="24" VerticalAlignment="Stretch">
                  <StackPanel Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="尚无可显示的空间内容" Classes="empty-title" TextAlignment="Center" />
                    <TextBlock Text="Core 当前未暴露工作区文件、类型与更新时间投影。这里不会填入母版截图中的演示目录或样例文件。" TextWrapping="Wrap" Classes="status-empty" TextAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </StackPanel>
        <StackPanel x:Name="UnavailableSurface" IsVisible="False" Spacing="16">
          <Border Classes="aaos-card" Padding="20,18" Background="{DynamicResource AaosSurface2Brush}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
              <Border Width="50" Height="50" CornerRadius="15" Background="{DynamicResource AaosSidebarBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                <local:AaosIcon x:Name="UnavailableSurfaceIcon" Width="24" Height="24" IconName="Thinking" Foreground="{DynamicResource AaosPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <TextBlock x:Name="UnavailableSurfaceTitle" Text="暂不可用" Classes="section-heading" />
                <TextBlock x:Name="UnavailableSurfaceStateText" Text="状态 · Core contract unavailable" Classes="status-disabled" FontSize="12" AutomationProperties.Name="功能状态" />
                <TextBlock x:Name="UnavailableSurfaceText" Text="该工作区尚未接入 Core 读模型。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
              </StackPanel>
            </Grid>
          </Border>
          <Grid x:Name="UnavailableCapabilityGrid" ColumnDefinitions="*,*,*" RowDefinitions="Auto" ColumnSpacing="14">
            <Border Classes="aaos-card" Padding="18" Background="{DynamicResource AaosSurface2Brush}">
              <StackPanel Spacing="12">
                <local:AaosIcon Width="23" Height="23" IconName="Source" Foreground="{DynamicResource AaosPrimaryBrush}" />
                <StackPanel Spacing="5">
                  <TextBlock x:Name="UnavailableCapabilityOneTitle" Text="来源与任务" Classes="card-heading" />
                  <TextBlock x:Name="UnavailableCapabilityOneText" Text="来源绑定、任务状态与处理记录" TextWrapping="Wrap" Classes="status-empty" />
                </StackPanel>
                <TextBlock Text="等待权威 Core projection" Classes="provenance-tag" FontSize="10" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="aaos-card" Padding="18" Background="{DynamicResource AaosSurface2Brush}">
              <StackPanel Spacing="12">
                <local:AaosIcon Width="23" Height="23" IconName="Connection" Foreground="{DynamicResource AaosPrimaryBrush}" />
                <StackPanel Spacing="5">
                  <TextBlock x:Name="UnavailableCapabilityTwoTitle" Text="能力目录" Classes="card-heading" />
                  <TextBlock x:Name="UnavailableCapabilityTwoText" Text="权威注册、版本与依赖状态" TextWrapping="Wrap" Classes="status-empty" />
                </StackPanel>
                <TextBlock Text="无本地推测或合成状态" Classes="provenance-tag" FontSize="10" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="aaos-card" Padding="18" Background="{DynamicResource AaosSurface2Brush}">
              <StackPanel Spacing="12">
                <local:AaosIcon Width="23" Height="23" IconName="Info" Foreground="{DynamicResource AaosPrimaryBrush}" />
                <StackPanel Spacing="5">
                  <TextBlock x:Name="UnavailableCapabilityThreeTitle" Text="运行状态" Classes="card-heading" />
                  <TextBlock x:Name="UnavailableCapabilityThreeText" Text="只展示可验证的 Core 回读" TextWrapping="Wrap" Classes="status-empty" />
                </StackPanel>
                <TextBlock Text="动作保持禁用" Classes="provenance-tag" FontSize="10" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
          <Grid ColumnDefinitions="1.2*,0.8*" ColumnSpacing="14" RowSpacing="14">
            <Border Classes="aaos-card" Padding="18">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <local:AaosIcon Width="18" Height="18" IconName="Info" Foreground="{DynamicResource AaosPrimaryBrush}" />
                  <TextBlock Grid.Column="1" Text="数据与能力边界" Classes="section-heading" />
                </Grid>
                <Border Classes="aaos-card-compact" Padding="12">
                  <StackPanel Spacing="5">
                    <TextBlock Text="可读字段" Classes="provenance-tag" FontSize="10" />
                    <TextBlock Text="此页面尚无对应的正式读模型；不会把配置文件、环境变量或缓存猜测成运行状态。" TextWrapping="Wrap" Classes="status-empty" />
                  </StackPanel>
                </Border>
                <Border Classes="aaos-card-compact" Padding="12">
                  <StackPanel Spacing="5">
                    <TextBlock Text="交互状态" Classes="provenance-tag" FontSize="10" />
                    <TextBlock Text="写入、启停、创建和提交动作保持禁用，直到 Core 提供权限、验证、错误及回读合同。" TextWrapping="Wrap" Classes="status-empty" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="aaos-card" Padding="18">
              <StackPanel Spacing="12">
                <TextBlock Text="接入要求" Classes="section-heading" />
                <Border Classes="aaos-card-compact" Padding="12">
                  <StackPanel Spacing="6">
                    <TextBlock x:Name="UnavailableSurfaceBoundaryText" Text="当前界面保持只读；不创建合成数据、随机状态或第二套真相。" TextWrapping="Wrap" FontSize="12" Classes="status-empty" AutomationProperties.Name="功能边界" />
                    <TextBlock x:Name="UnavailableSurfaceNextStepText" Text="需要对应的 Core 读模型或写入契约。" TextWrapping="Wrap" FontSize="12" Classes="status-empty" AutomationProperties.Name="功能下一步" />
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="返回工作台" Padding="12,7" Click="OnUnavailableHomeClick" AutomationProperties.Name="返回工作台" />
                  <Button x:Name="UnavailableSettingsButton" Content="查看系统边界" Padding="12,7" Click="OnUnavailableSettingsClick" AutomationProperties.Name="查看系统边界" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
        <StackPanel x:Name="SettingsSurface" IsVisible="False" Spacing="14">
          <TextBlock Text="本地数据、模型、同步、隐私、个性化和导出" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
          <Border Classes="aaos-card settings-master-card" Padding="20">
            <StackPanel Spacing="20">
              <TextBlock Text="设置" Classes="card-heading" />
              <Grid x:Name="SettingsControlsGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="60" RowSpacing="40">
                <Border Classes="aaos-card" Padding="28" MinHeight="120" Background="{DynamicResource AaosSurface2Brush}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                      <TextBlock Text="本地数据" Classes="section-heading" />
                      <TextBlock Text="Core 尚未提供本地数据设置的读写接口。" Classes="status-empty" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center" HorizontalAlignment="Center">
                      <Border Classes="settings-availability" Padding="7,3">
                        <TextBlock Text="CORE 未接入" FontSize="9" />
                      </Border>
                      <ToggleSwitch Width="62" Height="32" IsEnabled="False" IsChecked="{x:Null}" IsThreeState="True" OffContent="" OnContent="" ToolTip.Tip="不可更改：Core 尚未提供本地数据设置的读写合同。" AutomationProperties.Name="本地数据设置不可用，Core 未公开读写合同" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Grid.Column="1" Classes="aaos-card" Padding="28" MinHeight="120" Background="{DynamicResource AaosSurface2Brush}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                      <TextBlock Text="模型与提供方" Classes="section-heading" />
                      <TextBlock Text="Core 尚未提供模型配置的读写接口。" Classes="status-empty" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center" HorizontalAlignment="Center">
                      <Border Classes="settings-availability" Padding="7,3">
                        <TextBlock Text="CORE 未接入" FontSize="9" />
                      </Border>
                      <ToggleSwitch Width="62" Height="32" IsEnabled="False" IsChecked="{x:Null}" IsThreeState="True" OffContent="" OnContent="" ToolTip.Tip="不可更改：Core 尚未提供模型与提供方设置的读写合同。" AutomationProperties.Name="模型与提供方设置不可用，Core 未公开读写合同" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Grid.Row="1" Classes="aaos-card" Padding="28" MinHeight="120" Background="{DynamicResource AaosSurface2Brush}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                      <TextBlock Text="同步" Classes="section-heading" />
                      <TextBlock Text="Core 尚未提供同步设置的读写接口。" Classes="status-empty" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center" HorizontalAlignment="Center">
                      <Border Classes="settings-availability" Padding="7,3">
                        <TextBlock Text="CORE 未接入" FontSize="9" />
                      </Border>
                      <ToggleSwitch Width="62" Height="32" IsEnabled="False" IsChecked="{x:Null}" IsThreeState="True" OffContent="" OnContent="" ToolTip.Tip="不可更改：Core 尚未提供同步设置的读写合同。" AutomationProperties.Name="同步设置不可用，Core 未公开读写合同" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Classes="aaos-card" Padding="28" MinHeight="120" Background="{DynamicResource AaosSurface2Brush}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                      <TextBlock Text="隐私" Classes="section-heading" />
                      <TextBlock Text="Core 尚未提供隐私设置的读写接口。" Classes="status-empty" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center" HorizontalAlignment="Center">
                      <Border Classes="settings-availability" Padding="7,3">
                        <TextBlock Text="CORE 未接入" FontSize="9" />
                      </Border>
                      <ToggleSwitch Width="62" Height="32" IsEnabled="False" IsChecked="{x:Null}" IsThreeState="True" OffContent="" OnContent="" ToolTip.Tip="不可更改：Core 尚未提供隐私设置的读写合同。" AutomationProperties.Name="隐私设置不可用，Core 未公开读写合同" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Grid.Row="2" Classes="aaos-card" Padding="28" MinHeight="120" Background="{DynamicResource AaosSurface2Brush}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                      <TextBlock Text="导入导出" Classes="section-heading" />
                      <TextBlock Text="Core 尚未提供导入导出设置的读写接口。" Classes="status-empty" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center" HorizontalAlignment="Center">
                      <Border Classes="settings-availability" Padding="7,3">
                        <TextBlock Text="CORE 未接入" FontSize="9" />
                      </Border>
                      <ToggleSwitch Width="62" Height="32" IsEnabled="False" IsChecked="{x:Null}" IsThreeState="True" OffContent="" OnContent="" ToolTip.Tip="不可更改：Core 尚未提供导入导出设置的读写合同。" AutomationProperties.Name="导入导出设置不可用，Core 未公开读写合同" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border x:Name="SettingsAppearanceCard" Grid.Row="2" Grid.Column="1" Classes="aaos-card" Padding="24" MinHeight="120" Background="{DynamicResource AaosSurface2Brush}">
                  <Grid ColumnDefinitions="*,190" ColumnSpacing="16">
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                      <TextBlock Text="外观" Classes="section-heading" />
                      <TextBlock Text="选择深空、白色或黑色主题。" Classes="status-empty" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="SettingsThemePaletteBox" Grid.Column="1" SelectedIndex="0" MinHeight="44" VerticalAlignment="Center" AutomationProperties.Name="界面主题选择" ToolTip.Tip="切换主题配色；页面结构保持母版一致">
                      <ComboBoxItem Content="深空主题（默认）" />
                      <ComboBoxItem Content="白色主题" />
                      <ComboBoxItem Content="黑色主题" />
                    </ComboBox>
                  </Grid>
                </Border>
                <Border Grid.Row="3" Classes="aaos-card" Padding="28" MinHeight="120" Background="{DynamicResource AaosSurface2Brush}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                      <TextBlock Text="快捷键" Classes="section-heading" />
                      <TextBlock Text="Core 尚未提供快捷键设置的读写接口。" Classes="status-empty" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center" HorizontalAlignment="Center">
                      <Border Classes="settings-availability" Padding="7,3">
                        <TextBlock Text="CORE 未接入" FontSize="9" />
                      </Border>
                      <ToggleSwitch Width="62" Height="32" IsEnabled="False" IsChecked="{x:Null}" IsThreeState="True" OffContent="" OnContent="" ToolTip.Tip="不可更改：Core 尚未提供快捷键设置的读写合同。" AutomationProperties.Name="快捷键设置不可用，Core 未公开读写合同" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Grid.Row="3" Grid.Column="1" Classes="aaos-card" Padding="28" MinHeight="120" Background="{DynamicResource AaosSurface2Brush}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                      <TextBlock Text="实验功能" Classes="section-heading" />
                      <TextBlock Text="Core 尚未提供实验功能设置的读写接口。" Classes="status-empty" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center" HorizontalAlignment="Center">
                      <Border Classes="settings-availability" Padding="7,3">
                        <TextBlock Text="CORE 未接入" FontSize="9" />
                      </Border>
                      <ToggleSwitch Width="62" Height="32" IsEnabled="False" IsChecked="{x:Null}" IsThreeState="True" OffContent="" OnContent="" ToolTip.Tip="不可更改：Core 尚未提供实验功能设置的读写合同。" AutomationProperties.Name="实验功能设置不可用，Core 未公开读写合同" />
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
              <Border Padding="12,9" CornerRadius="8" Background="{DynamicResource AaosSurfaceBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                  <local:AaosIcon Width="16" Height="16" IconName="Info" Foreground="{DynamicResource AaosMutedBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="除外观主题外，其余选项在 Core 提供持久化读写合同前保持禁用；此页不会显示或写入虚构状态。" Classes="status-empty" TextWrapping="Wrap" />
                </Grid>
              </Border>
              <Expander Header="Core 运行状态" IsExpanded="False" AutomationProperties.Name="展开 Core 运行状态与工作区状态">
                <StackPanel Spacing="10" Margin="0,10,0,0">
                  <Button x:Name="SettingsRefreshButton" Content="读取当前 Core 状态" HorizontalAlignment="Left" Padding="14,8" Click="OnSettingsRefreshClick" AutomationProperties.Name="读取当前 Core 状态" />
                  <TextBlock x:Name="SettingsStateText" Classes="status-empty" Text="尚未读取 Core 状态。" TextWrapping="Wrap" AutomationProperties.Name="系统状态" />
                  <Border Padding="20" CornerRadius="10" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                      <TextBlock x:Name="SettingsCoreStatusText" Text="尚未读取" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
                      <TextBlock x:Name="SettingsWorkspaceStatusText" Text="工作区：尚未读取" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
                      <TextBlock x:Name="SettingsCapabilityBoundaryText" Text="插件、模型、Sidecar 未接入权威 readiness 投影。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel x:Name="JobsSurface" IsVisible="False" Spacing="16">
          <Border Classes="aaos-card" Padding="20,18" Background="{DynamicResource AaosSurface2Brush}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
              <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource AaosSidebarBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                <local:AaosIcon Width="23" Height="23" IconName="Notifications" Foreground="{DynamicResource AaosPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="任务回执" Classes="section-heading" />
                <TextBlock Text="JOBS · CORE RECEIPTS" Classes="provenance-tag" FontSize="11" />
                <TextBlock Text="查看本次会话的资料导入进度和失败原因。历史任务可通过高级查询读取。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Classes="aaos-card" Padding="18">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <local:AaosIcon Width="18" Height="18" IconName="Search" Foreground="{DynamicResource AaosPrimaryBrush}" />
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="高级任务查询" Classes="section-heading" />
                  <TextBlock Text="通过保存的任务标识读取详细记录。" Classes="status-empty" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <Expander x:Name="JobLookupAdvanced" Header="高级：按任务标识读取" IsExpanded="False">
              <Grid x:Name="JobLookupGrid" Classes="aaos-toolbar" ColumnDefinitions="*,Auto" RowDefinitions="Auto" ColumnSpacing="10" RowSpacing="10">
                <TextBox x:Name="JobLookupIdBox" PlaceholderText="输入 job_id 读取回执" KeyDown="OnToolbarInputKeyDown" AutomationProperties.Name="job_id 输入" />
                <Button x:Name="JobLookupButton" Grid.Column="1" Classes="primary-action" Content="读取任务回执" Padding="16,9" Click="OnReadJobReceiptClick" AutomationProperties.Name="读取指定任务回执" />
              </Grid>
              </Expander>
              <Border Padding="14" CornerRadius="9" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                <Expander x:Name="JobLookupDiagnostics" Header="更多信息：任务读取记录" IsExpanded="False">
                  <TextBlock x:Name="JobLookupResultsText" Classes="status-empty" Text="empty · 未读取指定任务回执。" TextWrapping="Wrap" AutomationProperties.Name="指定任务回执结果" AutomationProperties.LiveSetting="Polite" />
                </Expander>
              </Border>
            </StackPanel>
          </Border>
          <Border Classes="aaos-card" Padding="18">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="本次会话任务" Classes="section-heading" />
                  <TextBlock Text="真实回执来自 Core；列表只覆盖当前桌面会话，不代表历史归档。" Classes="status-empty" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="刷新回执" Padding="14,8" Click="OnRefreshJobsClick" AutomationProperties.Name="刷新本次导入任务回执" ToolTip.Tip="重新读取当前会话已知任务的 Core 回执" />
              </Grid>
              <WrapPanel Orientation="Horizontal" ItemWidth="230" ItemHeight="48">
                <ComboBox x:Name="JobsStateFilterBox" SelectedIndex="0" Margin="0,0,10,8" HorizontalAlignment="Stretch" SelectionChanged="OnJobsStateFilterChanged" AutomationProperties.Name="本次会话任务状态筛选">
                  <ComboBoxItem Content="全部状态" />
                  <ComboBoxItem Content="处理中" />
                  <ComboBoxItem Content="成功" />
                  <ComboBoxItem Content="需关注" />
                </ComboBox>
                <Border Padding="10,7" Margin="0,0,10,8" CornerRadius="8" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <local:AaosIcon Width="15" Height="15" IconName="Info" Foreground="{DynamicResource AaosMutedBrush}" />
                    <TextBlock Text="筛选仅作用于本次会话回执" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </WrapPanel>
              <Border Padding="16" CornerRadius="10" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                  <TextBlock x:Name="JobsResultsText" Text="本次会话尚无可显示任务。" TextWrapping="Wrap" Foreground="{DynamicResource AaosMutedBrush}" AutomationProperties.Name="本次会话任务筛选状态" />
                  <ListBox x:Name="JobsResultsList" MinHeight="180" SelectionChanged="OnJobReceiptSelected" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AaosIvoryBrush}" AutomationProperties.Name="任务回执结果">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="14,12" Margin="0,0,0,8" CornerRadius="9" Background="{DynamicResource AaosSurfaceBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AaosSurface2Brush}" VerticalAlignment="Top">
                              <local:AaosIcon Width="17" Height="17" IconName="Import" Foreground="{DynamicResource AaosPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="5">
                              <TextBlock Text="本次会话的导入任务" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                              <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource AaosIvoryBrush}" />
                              <TextBlock Text="不代表持久历史任务" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Border x:Name="InspectorPanel" Classes="aaos-animated-surface aaos-glass inspector-drawer" Grid.Row="1" Grid.Column="3" Padding="18,24" Background="{DynamicResource AaosGlassBrush}" BorderBrush="{DynamicResource AaosGlassRimBrush}" BorderThickness="1,0,0,0" Focusable="True" AutomationProperties.Name="来源与证据检查器">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18">
          <TextBlock Text="来源与证据" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AaosMutedBrush}" />
          <Border Padding="10,8" CornerRadius="8" Background="{DynamicResource AaosSurface2Brush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
            <StackPanel Spacing="4">
              <TextBlock Text="当前对象层级" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
              <TextBlock x:Name="InspectorLayerText" Classes="provenance-projection aaos-provenance-tag" Text="平台数据 · 类型暂不可用" FontSize="13" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <Border Padding="14" CornerRadius="10" Background="{DynamicResource AaosSurfaceBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
            <StackPanel Spacing="7">
              <TextBlock Text="当前上下文" FontSize="12" Foreground="{DynamicResource AaosMutedBrush}" />
              <TextBlock x:Name="InspectorSectionText" Text="首页" Classes="section-heading" AutomationProperties.Name="当前上下文" />
              <Expander x:Name="InspectorIdentityDiagnostics" Header="更多信息：对象身份与来源" IsExpanded="False">
              <StackPanel Spacing="7">
              <TextBlock x:Name="InspectorObjectText" Text="未选择对象" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AaosIvoryBrush}" AutomationProperties.Name="当前对象" />
              <TextBlock x:Name="InspectorDetailsText" Text="对象来源、版本和证据将在选择具体对象后显示。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AaosMutedBrush}" AutomationProperties.Name="对象详情" />
              <TextBlock Text="结构化来源字段" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AaosMutedBrush}" Margin="0,8,0,0" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="5">
                <TextBlock Text="来源" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                <TextBlock x:Name="InspectorSourceText" Grid.Column="1" Text="未暴露" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AaosIvoryBrush}" AutomationProperties.Name="对象来源" />
                <TextBlock Grid.Row="1" Text="版本" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                <TextBlock x:Name="InspectorVersionText" Grid.Row="1" Grid.Column="1" Text="未暴露" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AaosIvoryBrush}" />
                <TextBlock Grid.Row="2" Text="状态" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                <TextBlock x:Name="InspectorStatusText" Grid.Row="2" Grid.Column="1" Text="未暴露" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AaosIvoryBrush}" />
                <TextBlock Grid.Row="3" Text="边界" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
                <TextBlock x:Name="InspectorBoundaryText" Grid.Row="3" Grid.Column="1" Text="字段缺失不推断" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
              </Grid>
              <Border Classes="aaos-card-compact" Padding="10" Margin="0,8,0,0">
                <StackPanel x:Name="InspectorSourceChain" Classes="aaos-source-chain">
                  <TextBlock Text="来源链摘要" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AaosMutedBrush}" />
                  <TextBlock x:Name="InspectorChainSourceText" Classes="provenance-projection" Text="来源 → 未暴露" TextWrapping="Wrap" FontSize="11" />
                  <TextBlock x:Name="InspectorChainVersionText" Classes="provenance-projection" Text="版本 → 未暴露" TextWrapping="Wrap" FontSize="11" />
                  <TextBlock x:Name="InspectorChainProjectionText" Classes="provenance-projection" Text="当前投影 → 未暴露" TextWrapping="Wrap" FontSize="11" />
                </StackPanel>
              </Border>
              <TextBlock x:Name="InspectorProvenanceText" Text="未选择对象；来源链未加载。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AaosMutedBrush}" AutomationProperties.Name="对象来源链" />
              </StackPanel>
              </Expander>
              <StackPanel x:Name="InspectorActionPanel" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button x:Name="InspectorOpenSourceButton" Content="打开来源" IsEnabled="False" Padding="12,7" Click="OnInspectorOpenSourceClick" AutomationProperties.Name="打开来源" />
                <Button x:Name="InspectorOpenKnowledgeButton" Content="打开 Knowledge" IsEnabled="False" Padding="12,7" Click="OnInspectorOpenKnowledgeClick" AutomationProperties.Name="打开 Knowledge" />
                <Button x:Name="InspectorBackLibraryButton" Content="返回资料库" IsEnabled="False" Padding="12,7" Click="OnInspectorBackLibraryClick" AutomationProperties.Name="返回资料库" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Padding="14" CornerRadius="10" Background="{DynamicResource AaosSurfaceBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="1">
            <StackPanel Spacing="7">
              <TextBlock Text="上下文活动" FontSize="12" Foreground="{DynamicResource AaosMutedBrush}" />
              <TextBlock Text="回执已移至底部活动坞" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AaosIvoryBrush}" />
              <TextBlock Text="这里只保留当前对象的证据摘要；任务状态不伪装成持久历史。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AaosMutedBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Border x:Name="ActivityDock" Classes="aaos-animated-surface aaos-glass" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Padding="18,2" Background="{DynamicResource AaosGlassBrush}" BorderBrush="{DynamicResource AaosGlassRimBrush}" BorderThickness="0,1,0,0">
      <Grid x:Name="ActivityDockGrid" RowDefinitions="Auto">
        <Border x:Name="ActivityDockBrandFooter" Padding="0" IsVisible="True">
          <TextBlock Text="ArcheAxis · PRODUCT UI · LOCAL KNOWLEDGE WORKSPACE" FontSize="10" Foreground="{DynamicResource AaosMutedBrush}" VerticalAlignment="Center" />
        </Border>
        <Grid x:Name="ActivityDockMainContent" Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="False">
          <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
              <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{DynamicResource AaosPrimaryBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="活动回执" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AaosIvoryBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" x:Name="ActivityDockText" Text="本次会话暂无导入任务。" FontSize="12" Foreground="{DynamicResource AaosMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.Name="本次会话暂无导入任务。" />
            </Grid>
            <TextBlock x:Name="ActivityDockStatusText" Classes="status-empty" IsVisible="False" Text="empty · 本次会话暂无 Core 回执" TextWrapping="Wrap" FontSize="11" AutomationProperties.Name="活动回执状态" />
            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsVisible, ElementName=ActivityDockDetailsText}" AutomationProperties.Name="活动回执详情滚动区域">
              <TextBlock x:Name="ActivityDockDetailsText" Classes="aaos-animated-surface" IsVisible="False" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" AutomationProperties.Name="当前会话没有可展开的 Core 回执。" />
            </ScrollViewer>
            <ListBox x:Name="ActivityDockReceiptList" Classes="aaos-animated-surface" IsVisible="False" MaxHeight="150" Background="Transparent" BorderThickness="0" SelectionChanged="OnActivityDockReceiptSelected" AutomationProperties.Name="活动回执列表">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="6" Background="{DynamicResource AaosSurfaceBrush}">
                    <TextBlock Text="{Binding}" Foreground="{DynamicResource AaosIvoryBrush}" />
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
          <StackPanel x:Name="ActivityDockActions" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="ActivityDockToggleButton" Content="展开详情" Padding="12,6" Click="OnToggleActivityDockClick" AutomationProperties.Name="展开活动回执详情" />
            <Button Content="打开任务回执" Padding="12,6" Click="OnJobsClick" AutomationProperties.Name="打开任务回执" />
            <Button Content="刷新回执" Padding="12,6" Click="OnRefreshJobsClick" AutomationProperties.Name="刷新活动回执" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
    <Border x:Name="MobileRail" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" IsVisible="False" Padding="12,5" Background="{DynamicResource AaosSidebarBrush}" BorderBrush="{DynamicResource AaosBorderBrush}" BorderThickness="0,1,0,0" AutomationProperties.Name="移动端主导航">
      <Grid ColumnDefinitions="*,*,*,*,*,*,*" HorizontalAlignment="Stretch">
        <Button x:Name="MobileWorkspaceButton" Grid.Column="0" Classes="rail-button master-icon-button active" Width="48" Height="44" HorizontalAlignment="Center" Click="OnHomeClick" ToolTip.Tip="首页" AutomationProperties.Name="打开首页">
          <local:AaosIcon Width="22" Height="22" IconName="Home" />
        </Button>
        <Button x:Name="MobileCaptureButton" Grid.Column="1" Classes="rail-button master-icon-button" Width="48" Height="44" HorizontalAlignment="Center" Click="OnCaptureClick" ToolTip.Tip="捕获" AutomationProperties.Name="打开捕获">
          <local:AaosIcon Width="22" Height="22" IconName="Capture" />
        </Button>
        <Button x:Name="MobileEvidenceButton" Grid.Column="2" Classes="rail-button master-icon-button" Width="48" Height="44" HorizontalAlignment="Center" Click="OnEvidenceClick" ToolTip.Tip="证据库" AutomationProperties.Name="打开证据库">
          <local:AaosIcon Width="22" Height="22" IconName="Evidence" />
        </Button>
        <Button x:Name="MobileLearningButton" Grid.Column="3" Classes="rail-button master-icon-button" Width="48" Height="44" HorizontalAlignment="Center" Click="OnReviewClick" ToolTip.Tip="复习 / FSRS" AutomationProperties.Name="打开复习与 FSRS">
          <local:AaosIcon Width="22" Height="22" IconName="Review" />
        </Button>
        <Button x:Name="MobileMachineButton" Grid.Column="4" Classes="rail-button master-icon-button" Width="48" Height="44" HorizontalAlignment="Center" Click="OnMachineGrowthClick" ToolTip.Tip="机器学习" AutomationProperties.Name="打开机器学习">
          <local:AaosIcon Width="22" Height="22" IconName="Chip" />
        </Button>
        <Button x:Name="MobileSearchButton" Grid.Column="5" Classes="rail-button master-icon-button" Width="48" Height="44" HorizontalAlignment="Center" Click="OnSearchClick" ToolTip.Tip="搜索" AutomationProperties.Name="打开搜索">
          <local:AaosIcon Width="22" Height="22" IconName="Search" />
        </Button>
        <Button x:Name="MobileSystemButton" Grid.Column="6" Classes="rail-button master-icon-button" Width="48" Height="44" HorizontalAlignment="Center" Click="OnSettingsClick" ToolTip.Tip="设置" AutomationProperties.Name="打开设置">
          <local:AaosIcon Width="22" Height="22" IconName="Settings" />
        </Button>
        <StackPanel IsVisible="False">
          <Button x:Name="MobileKnowledgeButton" Click="OnLibraryClick" AutomationProperties.Name="打开资料与知识" />
          <Button x:Name="MobileReaderButton" Click="OnSourceReaderClick" AutomationProperties.Name="打开原件阅读" />
          <Button x:Name="MobileResearchButton" Click="OnResearchClick" AutomationProperties.Name="打开研究" />
          <Button x:Name="MobileJobsButton" Click="OnJobsClick" AutomationProperties.Name="打开任务" />
          <Button x:Name="MobilePluginsButton" Click="OnPluginsClick" AutomationProperties.Name="打开插件" />
          <Button x:Name="MobileModelsButton" Click="OnModelsClick" AutomationProperties.Name="打开模型" />
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="ToastSurface" Classes="aaos-animated-surface aaos-card-compact" Grid.RowSpan="4" Grid.ColumnSpan="4" IsVisible="False" ZIndex="20" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" MaxWidth="420" IsHitTestVisible="False" Padding="14,10" Opacity="0" RenderTransformOrigin="50%,100%">
      <Border.Transitions>
        <Transitions />
      </Border.Transitions>
      <Border.RenderTransform>
        <TransformGroup>
          <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
          <TranslateTransform Y="12" />
        </TransformGroup>
      </Border.RenderTransform>
      <TextBlock x:Name="ToastText" TextWrapping="Wrap" Foreground="{DynamicResource AaosIvoryBrush}" AutomationProperties.Name="临时操作提示" AutomationProperties.LiveSetting="Polite" />
    </Border>
    <Border x:Name="CommandPaletteOverlay" Classes="aaos-animated-surface" Grid.RowSpan="4" Grid.ColumnSpan="4" IsVisible="False" ZIndex="10" Background="{DynamicResource AaosOverlayBrush}" Padding="24">
      <Border Classes="aaos-card" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,72,0,0" Padding="20">
        <StackPanel Spacing="10">
          <TextBlock Text="命令面板" Classes="section-heading" />
          <TextBlock Text="Ctrl+K 打开 · Esc 关闭 · Enter 执行" FontSize="11" Foreground="{DynamicResource AaosMutedBrush}" />
          <TextBox x:Name="CommandPaletteBox" PlaceholderText="输入：首页 / 捕获 / 资料库 / 原件阅读 / 知识库 / 原件编辑 / 记忆地图 / 学习 / 证据中心 / 研究 / 机器学习 / 任务 / 插件 / 模型 / 恢复 / 设置" KeyDown="OnCommandPaletteKeyDown" TextChanged="OnCommandPaletteTextChanged" AutomationProperties.Name="命令面板输入" />
          <ListBox x:Name="CommandPaletteResultsList" MaxHeight="240" Background="Transparent" BorderThickness="0" SelectionChanged="OnCommandPaletteSelectionChanged" KeyDown="OnCommandPaletteKeyDown" DoubleTapped="OnCommandPaletteResultDoubleTapped" AutomationProperties.Name="命令面板结果">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="10,8" Margin="0,0,0,4" CornerRadius="6" Background="{DynamicResource AaosSurface2Brush}">
                  <TextBlock Text="{Binding}" Foreground="{DynamicResource AaosIvoryBrush}" />
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="CommandPaletteStatusText" Text="输入命令后按 Enter；命令只切换现有页面，不创建新状态。" TextWrapping="Wrap" Classes="provenance-projection" AutomationProperties.Name="命令面板状态" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
