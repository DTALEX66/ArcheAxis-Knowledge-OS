<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <SolidColorBrush x:Key="AaosBackgroundBrush" Color="#061118" />
        <SolidColorBrush x:Key="AaosSidebarBrush" Color="#091821" />
        <SolidColorBrush x:Key="AaosSurfaceBrush" Color="#0C1C26" />
        <SolidColorBrush x:Key="AaosSurface2Brush" Color="#102630" />
        <SolidColorBrush x:Key="AaosBorderBrush" Color="#1D5055" />
        <SolidColorBrush x:Key="AaosPrimaryBrush" Color="#1FC8C5" />
        <SolidColorBrush x:Key="AaosPrimaryTextBrush" Color="#061118" />
        <SolidColorBrush x:Key="AaosGoldBrush" Color="#E6BE73" />
        <SolidColorBrush x:Key="AaosSuccessBrush" Color="#37C99A" />
        <SolidColorBrush x:Key="AaosErrorBrush" Color="#E56464" />
        <SolidColorBrush x:Key="AaosInfoBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="AaosWarningBrush" Color="#E6BE73" />
        <SolidColorBrush x:Key="AaosApprovalBrush" Color="#B8E986" />
        <SolidColorBrush x:Key="AaosDisabledBrush" Color="#5B6B73" />
        <SolidColorBrush x:Key="AaosReviewBrush" Color="#E6BE73" />
        <SolidColorBrush x:Key="AaosIvoryBrush" Color="#F3EFE6" />
        <SolidColorBrush x:Key="AaosMutedBrush" Color="#96AAB4" />
        <SolidColorBrush x:Key="AaosOverlayBrush" Color="#99061118" />
        <LinearGradientBrush x:Key="AaosPrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1FC8C5" Offset="0" />
            <GradientStop Color="#2CA9BE" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AaosAmbientGlowBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1FC8C5" Offset="0" />
            <GradientStop Color="#123C4A" Offset="0.58" />
            <GradientStop Color="#E6BE73" Offset="1" />
        </LinearGradientBrush>
        <x:Double x:Key="AaosSpace4">4</x:Double>
        <x:Double x:Key="AaosSpace8">8</x:Double>
        <x:Double x:Key="AaosSpace12">12</x:Double>
        <x:Double x:Key="AaosSpace16">16</x:Double>
        <x:Double x:Key="AaosSpace24">24</x:Double>
        <x:Double x:Key="AaosSpace32">32</x:Double>
        <x:Double x:Key="AaosSpace48">48</x:Double>
        <x:Double x:Key="AaosSpace64">64</x:Double>
        <x:Double x:Key="AaosRadius4">4</x:Double>
        <x:Double x:Key="AaosRadius12">12</x:Double>
        <x:Double x:Key="AaosRadius18">18</x:Double>
        <x:Double x:Key="AaosRadius24">24</x:Double>
        <x:Double x:Key="AaosDensityDefault">56</x:Double>
        <x:Double x:Key="AaosDensityCompact">44</x:Double>
        <x:Double x:Key="AaosFontCaption">11</x:Double>
        <x:Double x:Key="AaosFontBody">12</x:Double>
        <x:Double x:Key="AaosFontControl">13</x:Double>
        <x:Double x:Key="AaosFontSection">14</x:Double>
        <x:Double x:Key="AaosFontHeading">18</x:Double>
        <x:Double x:Key="AaosFontPageTitle">26</x:Double>
        <x:Double x:Key="AaosFontHero">30</x:Double>
        <x:Double x:Key="AaosFontSubheading">24</x:Double>
        <x:Double x:Key="AaosFontBrand">24</x:Double>
        <x:Double x:Key="AaosFontLead">15</x:Double>
        <x:Double x:Key="AaosFontWorkspace">16</x:Double>
        <x:Double x:Key="AaosFontKpi">26</x:Double>
        <x:Double x:Key="AaosFontEmptyTitle">22</x:Double>
        <x:Double x:Key="AaosInspectorBreakpoint">1440</x:Double>
        <x:Double x:Key="AaosNarrowActionsBreakpoint">1280</x:Double>
        <x:Double x:Key="AaosTabletBreakpoint">1024</x:Double>
        <x:Double x:Key="AaosMobileBreakpoint">840</x:Double>
        <x:Double x:Key="AaosSourceReaderStackBreakpoint">1200</x:Double>
        <x:Double x:Key="AaosMotionFastMs">120</x:Double>
        <x:Double x:Key="AaosMotionStandardMs">180</x:Double>
        <x:Double x:Key="AaosMotionEmphasisMs">280</x:Double>
        <x:Double x:Key="AaosMotionRevealMs">420</x:Double>
        <x:Double x:Key="AaosMotionAmbientMs">4200</x:Double>
        <x:String x:Key="AaosCommandPaletteGesture">Ctrl+K</x:String>
    </Styles.Resources>

    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource AaosSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AaosIvoryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="{DynamicResource AaosFontControl}" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="MinHeight" Value="{DynamicResource AaosDensityCompact}" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.primary-action">
        <Setter Property="Background" Value="{DynamicResource AaosPrimaryGradientBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AaosPrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary-action:pointerover">
        <Setter Property="Background" Value="{DynamicResource AaosPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosPrimaryTextBrush}" />
    </Style>
    <Style Selector="Button.aaos-compact">
        <Setter Property="MinHeight" Value="{DynamicResource AaosDensityCompact}" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="{DynamicResource AaosFontBody}" />
    </Style>
    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource AaosSurface2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource AaosIvoryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosPrimaryBrush}" />
        <Setter Property="Opacity" Value="0.96" />
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource AaosSurface2Brush}" />
        <Setter Property="Opacity" Value="0.86" />
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Background" Value="{DynamicResource AaosSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AaosDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosBorderBrush}" />
        <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="Button.review-grade.selected">
        <Setter Property="Background" Value="{DynamicResource AaosPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosIvoryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AaosPrimaryTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Grid.reduced-motion Button">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <Style Selector="Control.aaos-animated-surface">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.aaos-ambient-glow">
        <Setter Property="Background" Value="{DynamicResource AaosAmbientGlowBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Opacity" Value="0.14" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.42" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Grid.reduced-motion Border.aaos-ambient-glow">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <Style Selector="Grid.reduced-motion Control.aaos-animated-surface">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <Style Selector="ScrollViewer.aaos-route-transition">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Grid.reduced-motion ScrollViewer.aaos-route-transition">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <Style Selector="Button:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AaosPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.aaos-card">
        <Setter Property="Background" Value="{DynamicResource AaosSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Border.aaos-card:pointerover">
        <Setter Property="Background" Value="{DynamicResource AaosSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosPrimaryBrush}" />
    </Style>
    <Style Selector="Border.aaos-card-compact">
        <Setter Property="Background" Value="{DynamicResource AaosSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.aaos-kpi">
        <Setter Property="Background" Value="{DynamicResource AaosSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.aaos-status">
        <Setter Property="Background" Value="{DynamicResource AaosSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Grid.aaos-toolbar">
        <Setter Property="ColumnSpacing" Value="10" />
        <Setter Property="RowSpacing" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.aaos-empty-state">
        <Setter Property="Background" Value="{DynamicResource AaosSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <Style Selector="TextBlock.aaos-provenance-tag">
        <Setter Property="Foreground" Value="{DynamicResource AaosPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource AaosFontCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.review-card">
        <Setter Property="BorderBrush" Value="{DynamicResource AaosPrimaryBrush}" />
    </Style>
    <Style Selector="Border.toast-success">
        <Setter Property="BorderBrush" Value="{DynamicResource AaosSuccessBrush}" />
    </Style>
    <Style Selector="Border.toast-error">
        <Setter Property="BorderBrush" Value="{DynamicResource AaosErrorBrush}" />
    </Style>
    <Style Selector="Border.toast-info">
        <Setter Property="BorderBrush" Value="{DynamicResource AaosInfoBrush}" />
    </Style>
    <Style Selector="Border.toast-review">
        <Setter Property="BorderBrush" Value="{DynamicResource AaosReviewBrush}" />
    </Style>
    <Style Selector="Border.toast-warning">
        <Setter Property="BorderBrush" Value="{DynamicResource AaosWarningBrush}" />
    </Style>
    <Style Selector="Border.lifecycle-card">
        <Setter Property="Background" Value="{DynamicResource AaosSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.lifecycle-card:pointerover">
        <Setter Property="Background" Value="{DynamicResource AaosSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.lifecycle-label">
        <Setter Property="Foreground" Value="{DynamicResource AaosMutedBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource AaosFontCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.provenance-tag">
        <Setter Property="Foreground" Value="{DynamicResource AaosPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.detail-section">
        <Setter Property="Foreground" Value="{DynamicResource AaosIvoryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="{DynamicResource AaosFontPageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AaosIvoryBrush}" />
    </Style>
    <Style Selector="TextBlock.page-hero">
        <Setter Property="FontSize" Value="{DynamicResource AaosFontHero}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AaosIvoryBrush}" />
    </Style>
    <Style Selector="TextBlock.page-subheading">
        <Setter Property="FontSize" Value="{DynamicResource AaosFontSubheading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AaosIvoryBrush}" />
    </Style>
    <Style Selector="TextBlock.section-heading">
        <Setter Property="FontSize" Value="{DynamicResource AaosFontHeading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AaosIvoryBrush}" />
    </Style>
    <Style Selector="TextBlock.card-heading">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AaosIvoryBrush}" />
    </Style>
    <Style Selector="TextBlock.brand-title">
        <Setter Property="FontSize" Value="{DynamicResource AaosFontBrand}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AaosIvoryBrush}" />
    </Style>
    <Style Selector="TextBlock.workspace-title">
        <Setter Property="FontSize" Value="{DynamicResource AaosFontWorkspace}" />
        <Setter Property="Foreground" Value="{DynamicResource AaosMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.lead-copy">
        <Setter Property="FontSize" Value="{DynamicResource AaosFontLead}" />
        <Setter Property="Foreground" Value="{DynamicResource AaosMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.kpi-value">
        <Setter Property="FontSize" Value="{DynamicResource AaosFontKpi}" />
        <Setter Property="Foreground" Value="{DynamicResource AaosIvoryBrush}" />
    </Style>
    <Style Selector="TextBlock.empty-title">
        <Setter Property="FontSize" Value="{DynamicResource AaosFontEmptyTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AaosIvoryBrush}" />
    </Style>
    <Style Selector="TextBlock.rail-label">
        <Setter Property="FontSize" Value="{DynamicResource AaosFontHeading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AaosIvoryBrush}" />
    </Style>
    <Style Selector="StackPanel.aaos-source-chain">
        <Setter Property="Spacing" Value="4" />
    </Style>
    <Style Selector="Button.rail-button">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AaosMutedBrush}" />
        <Setter Property="MinHeight" Value="{DynamicResource AaosDensityCompact}" />
    </Style>
    <Style Selector="Button.rail-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource AaosSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AaosIvoryBrush}" />
    </Style>
    <Style Selector="Button.rail-button.active">
        <Setter Property="Background" Value="{DynamicResource AaosSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AaosIvoryBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource AaosSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource AaosSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosBorderBrush}" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource AaosIvoryBrush}" />
    </Style>
    <Style Selector="ListBoxItem:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AaosPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource AaosSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AaosIvoryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="{DynamicResource AaosFontControl}" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="MinHeight" Value="{DynamicResource AaosDensityCompact}" />
    </Style>
    <Style Selector="TextBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AaosPrimaryBrush}" />
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AaosPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBox:disabled">
        <Setter Property="Foreground" Value="{DynamicResource AaosDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosBorderBrush}" />
        <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="ComboBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AaosPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ComboBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AaosPrimaryBrush}" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource AaosSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AaosIvoryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="{DynamicResource AaosFontControl}" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="MinHeight" Value="{DynamicResource AaosDensityCompact}" />
    </Style>
    <Style Selector="ComboBox:disabled">
        <Setter Property="Foreground" Value="{DynamicResource AaosDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AaosBorderBrush}" />
        <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource AaosIvoryBrush}" />
        <Setter Property="Background" Value="{DynamicResource AaosSurfaceBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource AaosIvoryBrush}" />
        <Setter Property="Background" Value="{DynamicResource AaosSurface2Brush}" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource AaosIvoryBrush}" />
    </Style>
    <Style Selector="CheckBox:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource AaosPrimaryBrush}" />
    </Style>
    <Style Selector="CheckBox:focus">
        <Setter Property="Foreground" Value="{DynamicResource AaosPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.status-success">
        <Setter Property="FontSize" Value="{DynamicResource AaosFontBody}" />
        <Setter Property="Foreground" Value="{DynamicResource AaosSuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.status-error">
        <Setter Property="Foreground" Value="{DynamicResource AaosErrorBrush}" />
    </Style>
    <Style Selector="TextBlock.status-warning">
        <Setter Property="Foreground" Value="{DynamicResource AaosWarningBrush}" />
    </Style>
    <Style Selector="TextBlock.status-approval">
        <Setter Property="Foreground" Value="{DynamicResource AaosApprovalBrush}" />
    </Style>
    <Style Selector="TextBlock.status-disabled">
        <Setter Property="Foreground" Value="{DynamicResource AaosDisabledBrush}" />
    </Style>
    <Style Selector="TextBlock.status-info">
        <Setter Property="Foreground" Value="{DynamicResource AaosInfoBrush}" />
    </Style>
    <Style Selector="TextBlock.status-unknown">
        <Setter Property="Foreground" Value="{DynamicResource AaosInfoBrush}" />
    </Style>
    <Style Selector="TextBlock.status-review">
        <Setter Property="Foreground" Value="{DynamicResource AaosReviewBrush}" />
    </Style>
    <Style Selector="TextBlock.status-loading">
        <Setter Property="Foreground" Value="{DynamicResource AaosInfoBrush}" />
    </Style>
    <Style Selector="TextBlock.status-empty">
        <Setter Property="Foreground" Value="{DynamicResource AaosMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.status-permission">
        <Setter Property="Foreground" Value="{DynamicResource AaosReviewBrush}" />
    </Style>
    <Style Selector="TextBlock.status-version">
        <Setter Property="Foreground" Value="{DynamicResource AaosPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.provenance-original">
        <Setter Property="Foreground" Value="{DynamicResource AaosIvoryBrush}" />
    </Style>
    <Style Selector="TextBlock.provenance-evidence">
        <Setter Property="Foreground" Value="{DynamicResource AaosGoldBrush}" />
    </Style>
    <Style Selector="TextBlock.provenance-machine">
        <Setter Property="Foreground" Value="{DynamicResource AaosInfoBrush}" />
    </Style>
    <Style Selector="TextBlock.provenance-projection">
        <Setter Property="Foreground" Value="{DynamicResource AaosPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.provenance-review">
        <Setter Property="Foreground" Value="{DynamicResource AaosReviewBrush}" />
    </Style>
    <Style Selector="ComboBox.review-control">
        <Setter Property="BorderBrush" Value="{DynamicResource AaosReviewBrush}" />
    </Style>
</Styles>
