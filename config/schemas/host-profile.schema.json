{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://archeaxis.local/schemas/host-profile.schema.json",
  "title": "HostProfile",
  "description": "host-profile.local.yaml 的 schema：单机外置能力仓现场档案（由 scripts/host_inventory.py 生成）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["machine_id", "os", "arch", "paths", "toolchains", "last_audit"],
  "properties": {
    "machine_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{12}$",
      "description": "hostname 的 sha256 前 12 位（不写主机名明文）"
    },
    "os": {
      "type": "string",
      "enum": ["windows", "linux", "macos", "unknown"]
    },
    "os_release": {
      "type": "string",
      "minLength": 1
    },
    "arch": {
      "type": "string",
      "minLength": 1,
      "description": "platform.machine()，如 AMD64"
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_dir", "toolchains_dir", "runtimes_dir", "cache_dir", "logs_dir"],
      "properties": {
        "registry_dir":     { "type": ["string", "null"], "description": "00-registry 注册表目录" },
        "toolchains_dir":   { "type": ["string", "null"], "description": "工具链目录" },
        "runtimes_dir":     { "type": ["string", "null"], "description": "运行时目录" },
        "engines_dir":      { "type": ["string", "null"], "description": "引擎目录（30-engines，未建为 null）" },
        "models_dir":       { "type": ["string", "null"], "description": "模型目录（40-models，未建为 null）" },
        "plugins_dir":      { "type": ["string", "null"], "description": "插件目录（50-plugins，未建为 null）" },
        "cache_dir":        { "type": ["string", "null"], "description": "缓存目录（uv-cache / 60-cache）" },
        "logs_dir":         { "type": ["string", "null"], "description": "日志目录（logs/）" },
        "workspace_root":   { "type": ["string", "null"], "description": "项目仓根（ArcheAxis-Knowledge-OS）" }
      }
    },
    "toolchains": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "description": "工具链名 → 探测到的版本字符串（缺失工具不出现或记 missing）"
    },
    "last_audit": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T",
      "description": "ISO-8601 审计时间"
    }
  }
}
