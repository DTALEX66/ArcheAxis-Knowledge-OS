{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archeaxis.project-handoff-preview/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "archeaxis.project-handoff-preview/v1"
    },
    "checked_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "proposal": {
      "allOf": [
        {
          "$ref": "project-handoff.schema.json"
        },
        {
          "properties": {
            "payload": {
              "properties": {
                "kind": {
                  "const": "context"
                }
              }
            }
          }
        }
      ]
    },
    "proposal_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference_state": {
      "enum": [
        "CURRENT",
        "STALE",
        "NOT_FOUND"
      ]
    },
    "source_authentication": {
      "const": "UNVERIFIED"
    },
    "authority": {
      "const": "REFERENCE_METADATA_ONLY"
    },
    "navigation": {
      "const": "UNAVAILABLE"
    },
    "grants_execution": {
      "const": false
    },
    "grants_knowledge_acceptance": {
      "const": false
    }
  },
  "required": [
    "schema",
    "checked_at_ms",
    "expires_at_ms",
    "proposal",
    "proposal_sha256",
    "reference_state",
    "source_authentication",
    "authority",
    "navigation",
    "grants_execution",
    "grants_knowledge_acceptance"
  ]
}
