{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archeaxis.project-handoff/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "archeaxis.project-handoff/v1"
    },
    "protocol": {
      "const": "archeaxis.project-observer/v1"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "producer": {
      "$ref": "#/$defs/ProducerIdentity"
    },
    "consumer": {
      "$ref": "#/$defs/ConsumerIdentity"
    },
    "created_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "authority": {
      "const": "PREPARATION_ONLY"
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "#/$defs/Context"
        },
        {
          "$ref": "#/$defs/TaskProposal"
        },
        {
          "$ref": "#/$defs/AssetManifest"
        },
        {
          "$ref": "#/$defs/KnowledgeCandidate"
        },
        {
          "$ref": "#/$defs/Receipt"
        }
      ]
    }
  },
  "required": [
    "schema",
    "protocol",
    "idempotency_key",
    "producer",
    "consumer",
    "created_at_ms",
    "expires_at_ms",
    "authority",
    "payload"
  ],
  "$defs": {
    "ProducerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "const": "archeaxis"
        },
        "workspace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "restore_epoch": {
          "type": "string",
          "pattern": "^(initial|[0-9a-f]{32})$"
        }
      },
      "required": [
        "namespace",
        "workspace_id",
        "restore_epoch"
      ]
    },
    "ConsumerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "enum": [
            "work-lab",
            "design-lab"
          ]
        },
        "instance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      "required": [
        "namespace",
        "instance_id"
      ]
    },
    "ObjectReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "document_id",
        "version",
        "content_sha256"
      ]
    },
    "Selection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "whole_object"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "text_range"
            },
            "block_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            "start_utf16": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end_utf16": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "block_id",
            "start_utf16",
            "end_utf16"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "page_range"
            },
            "first_page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "last_page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "first_page",
            "last_page"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "time_range"
            },
            "start_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "start_ms",
            "end_ms"
          ]
        }
      ]
    },
    "SelectedReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "$ref": "#/$defs/ObjectReference"
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "selection_qualification": {
          "const": "UNVERIFIED"
        }
      },
      "required": [
        "reference",
        "selection",
        "selection_qualification"
      ]
    },
    "CapabilityLink": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "enum": [
            "CAP-0010",
            "CAP-0020",
            "CAP-0030",
            "CAP-0040",
            "CAP-0050",
            "CAP-0060",
            "CAP-0070",
            "CAP-0080",
            "CAP-0090",
            "CAP-0100",
            "CAP-0110",
            "CAP-0120",
            "CAP-0130",
            "CAP-0140",
            "CAP-0150",
            "CAP-0160"
          ]
        },
        "contribution_point": {
          "enum": [
            "format_conversion",
            "template",
            "learning_activity",
            "graph_visual",
            "model_service",
            "tool_protocol"
          ]
        },
        "manifest_identity": {
          "const": "UNKNOWN"
        }
      },
      "required": [
        "capability_id",
        "contribution_point",
        "manifest_identity"
      ]
    },
    "LossEvidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "UNKNOWN"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "RECEIPT_REFERENCE"
            },
            "reference": {
              "$ref": "#/$defs/ObjectReference"
            }
          },
          "required": [
            "state",
            "reference"
          ]
        }
      ]
    },
    "AssetEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "$ref": "#/$defs/ObjectReference"
        },
        "source_reference": {
          "$ref": "#/$defs/ObjectReference"
        },
        "relationship": {
          "enum": [
            "ORIGINAL",
            "DERIVED"
          ]
        },
        "format": {
          "enum": [
            "text",
            "pdf",
            "office",
            "html",
            "image",
            "audio",
            "video",
            "canvas",
            "unknown"
          ]
        },
        "format_qualification": {
          "const": "UNVERIFIED"
        },
        "loss": {
          "$ref": "#/$defs/LossEvidence"
        }
      },
      "required": [
        "reference",
        "source_reference",
        "relationship",
        "format",
        "format_qualification",
        "loss"
      ]
    },
    "ProposalReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "proposal_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "context",
            "task_proposal",
            "asset_manifest",
            "knowledge_candidate"
          ]
        }
      },
      "required": [
        "idempotency_key",
        "proposal_sha256",
        "kind"
      ]
    },
    "Context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "context"
        },
        "source": {
          "$ref": "#/$defs/SelectedReference"
        },
        "purpose": {
          "enum": [
            "learning",
            "research",
            "conversion",
            "visualization"
          ]
        },
        "authorization_scope": {
          "const": "REFERENCE_METADATA_ONLY"
        }
      },
      "required": [
        "kind",
        "source",
        "purpose",
        "authorization_scope"
      ]
    },
    "TaskProposal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "task_proposal"
        },
        "target": {
          "$ref": "#/$defs/ObjectReference"
        },
        "context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SelectedReference"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "goal": {
          "enum": [
            "prepare_learning_activity",
            "prepare_research_plan",
            "prepare_format_conversion",
            "prepare_graph_view"
          ]
        },
        "capability": {
          "$ref": "#/$defs/CapabilityLink"
        },
        "execution_authority": {
          "const": "NOT_GRANTED"
        }
      },
      "required": [
        "kind",
        "target",
        "context",
        "goal",
        "capability",
        "execution_authority"
      ]
    },
    "AssetManifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "asset_manifest"
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetEntry"
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "required": [
        "kind",
        "assets"
      ]
    },
    "KnowledgeCandidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "knowledge_candidate"
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "candidate_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "claim_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "basis": {
          "$ref": "#/$defs/ObjectReference"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SelectedReference"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "review_state": {
          "const": "PENDING_HUMAN_REVIEW"
        },
        "evidence_support": {
          "const": "NOT_ASSESSED"
        }
      },
      "required": [
        "kind",
        "candidate_id",
        "candidate_revision",
        "claim_sha256",
        "basis",
        "evidence",
        "review_state",
        "evidence_support"
      ]
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "receipt"
        },
        "proposal": {
          "$ref": "#/$defs/ProposalReference"
        },
        "state": {
          "enum": [
            "PREPARED",
            "REJECTED",
            "UNKNOWN",
            "CONFLICT"
          ]
        },
        "reason": {
          "enum": [
            "NONE",
            "UNOBSERVED",
            "TIMEOUT",
            "DISCONNECTED",
            "EXPIRED",
            "STALE_REFERENCE",
            "IDENTITY_MISMATCH",
            "UNSUPPORTED",
            "IDEMPOTENCY_CONFLICT"
          ]
        }
      },
      "required": [
        "kind",
        "proposal",
        "state",
        "reason"
      ]
    }
  }
}
