{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archeaxis.expression/v1",
  "title": "Inert authored expression metadata in Document attrs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema": {
      "const": "archeaxis.expression/v1"
    },
    "nodes": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/ExpressionNode"
      },
      "x-uniqueBy": "id"
    },
    "edges": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/ExpressionEdge"
      },
      "x-uniqueBy": "id",
      "x-endpointsIn": "nodes.id"
    },
    "context": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExpressionContext"
        },
        {
          "type": "null"
        }
      ]
    },
    "capability_metadata": {
      "anyOf": [
        {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Inert1"
          },
          "x-maxSerializedUtf8Bytes": 16384,
          "x-maxDepth": 4
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "Inert4": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 4096,
          "x-maxUtf8Bytes": 4096
        },
        {
          "type": "array",
          "maxItems": 0
        },
        {
          "type": "object",
          "maxProperties": 0
        }
      ]
    },
    "Inert3": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 4096,
          "x-maxUtf8Bytes": 4096
        },
        {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/Inert4"
          }
        },
        {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Inert4"
          }
        }
      ]
    },
    "Inert2": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 4096,
          "x-maxUtf8Bytes": 4096
        },
        {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/Inert3"
          }
        },
        {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Inert3"
          }
        }
      ]
    },
    "Inert1": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 4096,
          "x-maxUtf8Bytes": 4096
        },
        {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/Inert2"
          }
        },
        {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Inert2"
          }
        }
      ]
    },
    "Inert0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 4096,
          "x-maxUtf8Bytes": 4096
        },
        {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/Inert1"
          }
        },
        {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Inert1"
          }
        }
      ]
    },
    "ExpressionMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "sha256",
        "media_type"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp",
            "audio/mpeg",
            "audio/wav",
            "video/mp4",
            "video/webm"
          ]
        }
      }
    },
    "ExpressionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "x",
        "y",
        "width",
        "height",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
        },
        "type": {
          "enum": [
            "text",
            "media"
          ]
        },
        "x": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "y": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 10000
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 10000
        },
        "text": {
          "type": "string",
          "maxLength": 16384,
          "x-maxUtf8Bytes": 16384
        },
        "media": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExpressionMedia"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "media"
              }
            }
          },
          "then": {
            "required": [
              "media"
            ],
            "properties": {
              "media": {
                "$ref": "#/$defs/ExpressionMedia"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "properties": {
              "media": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "ExpressionContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "knowledge_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "course_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "teaching_record_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ExpressionEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fromNode",
        "toNode",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
        },
        "fromNode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
        },
        "toNode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
        },
        "label": {
          "type": "string",
          "maxLength": 1024,
          "x-maxUtf8Bytes": 1024
        }
      }
    },
    "ExpressionDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "nodes",
        "edges"
      ],
      "properties": {
        "schema": {
          "const": "archeaxis.expression/v1"
        },
        "nodes": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/ExpressionNode"
          },
          "x-uniqueBy": "id"
        },
        "edges": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/ExpressionEdge"
          },
          "x-uniqueBy": "id",
          "x-endpointsIn": "nodes.id"
        },
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExpressionContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "capability_metadata": {
          "anyOf": [
            {
              "type": "object",
              "maxProperties": 32,
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/Inert1"
              },
              "x-maxSerializedUtf8Bytes": 16384,
              "x-maxDepth": 4
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "x-documentContainer": "editor_json.attrs.archeaxis_expression",
  "x-stateValidation": "Same Core transaction: CAS hash/header MIME and typed context. Metadata is inert; read paths preserve unknown historical attrs.",
  "x-mediaMaxUniqueBytes": 67108864,
  "x-mediaMaxObjectBytes": 33554432
}
