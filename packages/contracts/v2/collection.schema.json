{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archeaxis:contracts:v2:collection",
  "title": "Collection persisted definition and Core projection",
  "$ref": "#/$defs/Collection",
  "$defs": {
    "JSONValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      ]
    },
    "ObjectReferenceDto": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "document"
            },
            "document_id": {
              "type": "string"
            },
            "version": {
              "type": "integer"
            },
            "block_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "document_id",
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "source"
            },
            "source_id": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "source_id",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "knowledge"
            },
            "knowledge_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "knowledge_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "BoundedFormula": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "literal"
            },
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "property"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
            }
          },
          "required": [
            "op",
            "key"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "add",
                "subtract",
                "multiply",
                "divide",
                "concat",
                "equal"
              ]
            },
            "left": {
              "$ref": "#/$defs/BoundedFormula"
            },
            "right": {
              "$ref": "#/$defs/BoundedFormula"
            }
          },
          "required": [
            "op",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "if"
            },
            "condition": {
              "$ref": "#/$defs/BoundedFormula"
            },
            "then": {
              "$ref": "#/$defs/BoundedFormula"
            },
            "otherwise": {
              "$ref": "#/$defs/BoundedFormula"
            }
          },
          "required": [
            "op",
            "condition",
            "then",
            "otherwise"
          ],
          "additionalProperties": false
        }
      ]
    },
    "FormulaDefinition": {
      "type": "object",
      "properties": {
        "dialect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expression": {
          "$ref": "#/$defs/JSONValue"
        },
        "original_expression": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        },
        "output_type": {
          "enum": [
            "text",
            "number",
            "boolean",
            "date",
            "select",
            "relation",
            "formula"
          ]
        },
        "engine_version": {
          "type": "string",
          "maxLength": 128
        },
        "source_payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/JSONValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "dialect",
        "expression",
        "dependencies",
        "output_type",
        "engine_version"
      ],
      "additionalProperties": false
    },
    "CollectionProperty": {
      "type": "object",
      "properties": {
        "property_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "kind": {
          "enum": [
            "text",
            "number",
            "boolean",
            "date",
            "select",
            "relation",
            "formula"
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 64,
          "default": []
        },
        "formula": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormulaDefinition"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/JSONValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "property_id",
        "name",
        "kind"
      ],
      "additionalProperties": false
    },
    "CollectionRecord": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
        },
        "reference": {
          "$ref": "#/$defs/ObjectReferenceDto"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        "source_payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/JSONValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "record_id",
        "reference",
        "values"
      ],
      "additionalProperties": false
    },
    "CollectionFilter": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "equal"
            },
            "property_id": {
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/JSONValue"
            }
          },
          "required": [
            "op",
            "property_id",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "contains"
            },
            "property_id": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "property_id",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "greater_than"
            },
            "property_id": {
              "type": "string"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "op",
            "property_id",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "and",
                "or"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CollectionFilter"
              },
              "maxItems": 32,
              "minItems": 1
            }
          },
          "required": [
            "op",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "not"
            },
            "item": {
              "$ref": "#/$defs/CollectionFilter"
            }
          },
          "required": [
            "op",
            "item"
          ],
          "additionalProperties": false
        }
      ]
    },
    "CollectionSort": {
      "type": "object",
      "properties": {
        "property_id": {
          "type": "string"
        },
        "descending": {
          "type": "boolean"
        }
      },
      "required": [
        "property_id",
        "descending"
      ],
      "additionalProperties": false
    },
    "CollectionView": {
      "type": "object",
      "properties": {
        "view_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "kind": {
          "enum": [
            "table",
            "list",
            "board",
            "calendar",
            "gallery"
          ]
        },
        "filter": {
          "anyOf": [
            {
              "$ref": "#/$defs/CollectionFilter"
            },
            {
              "type": "null"
            }
          ]
        },
        "sort": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CollectionSort"
          },
          "maxItems": 8,
          "default": []
        },
        "group_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "date_property": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "view_id",
        "name",
        "kind"
      ],
      "additionalProperties": false
    },
    "Collection": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "archeaxis.collection/v1"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CollectionProperty"
          },
          "maxItems": 64
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CollectionRecord"
          },
          "maxItems": 500
        },
        "views": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CollectionView"
          },
          "maxItems": 16
        },
        "source_payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/JSONValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema",
        "properties",
        "records",
        "views"
      ],
      "additionalProperties": false
    },
    "FormulaProjection": {
      "type": "object",
      "properties": {
        "property_id": {
          "type": "string"
        },
        "dialect": {
          "type": "string"
        },
        "engine_version": {
          "type": "string"
        },
        "declared_engine_version": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "numeric_semantics": {
          "const": "finite_ieee754_f64"
        },
        "qualification": {
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "error",
            "computed"
          ]
        },
        "result": {
          "$ref": "#/$defs/JSONValue"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "property_id",
        "dialect",
        "engine_version",
        "declared_engine_version",
        "dependencies",
        "numeric_semantics",
        "qualification",
        "error_code",
        "status",
        "result",
        "error"
      ],
      "additionalProperties": false
    },
    "CollectionRow": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/ObjectReferenceDto"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        "formula_errors": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "formulas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FormulaProjection"
          }
        }
      },
      "required": [
        "record_id",
        "reference",
        "values",
        "formula_errors",
        "formulas"
      ],
      "additionalProperties": false
    },
    "CollectionQueryDto": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "archeaxis.collection-projection/v1"
        },
        "document_id": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "content_sha256": {
          "type": "string"
        },
        "engine_version": {
          "type": "string"
        },
        "view": {
          "$ref": "#/$defs/CollectionView"
        },
        "definition": {
          "$ref": "#/$defs/Collection"
        },
        "total": {
          "type": "integer"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CollectionRow"
          }
        },
        "group_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "next_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "canonical_writer": {
          "const": "Document"
        },
        "full_media_package": {
          "const": false
        }
      },
      "required": [
        "schema",
        "document_id",
        "version",
        "content_sha256",
        "engine_version",
        "view",
        "definition",
        "total",
        "items",
        "group_counts",
        "next_offset",
        "canonical_writer",
        "full_media_package"
      ],
      "additionalProperties": false
    }
  },
  "$comment": "Serde shape contract; optional Option fields accept omitted or null; options/sort default to [] without normalization. Core enforces byte budgets, actual refs, typed values, valid Gregorian dates, AST/dependency/view semantics. Unsupported dialect expression is inert JSON. No external platform numeric equivalence.",
  "x-maxObjectReferences": 2048
}
