{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archeaxis.provider-learning/v1",
  "description": "Core-owned, human learning observations. Provider identity, question identity and scoring remain client-declared and unverified; no FSRS or mastery authority is granted.",
  "$defs": {
    "token": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$"},
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["document_id", "version", "content_sha256"],
      "properties": {
        "document_id": {"$ref": "#/$defs/token"},
        "version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "provider_material_grant": {
      "description": "Stored in a Core Document attribute; restore fences the old grant identity. This grant does not itself start or qualify a provider.",
      "type": "object", "additionalProperties": false,
      "required": ["schema", "purpose", "consumer", "operations", "material", "authorization_basis", "expires_at", "state"],
      "properties": {
        "schema": {"const": "archeaxis.provider-material-grant/v1"},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 1024, "description": "Core additionally enforces a 1024-byte UTF-8 maximum."},
        "consumer": {"const": "deeptutor"},
        "operations": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "practice"}},
        "material": {"$ref": "#/$defs/snapshot"},
        "authorization_basis": {"type": "string", "maxLength": 16384, "description": "Core additionally enforces a 16384-byte UTF-8 maximum and a nonblank granted basis."},
        "expires_at": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 253402300799}]},
        "state": {"enum": ["granted", "revoked"]}
      }
    },
    "activity": {
      "type": "object", "additionalProperties": false,
      "required": ["activity_id", "material", "provider", "question", "grant"],
      "properties": {
        "activity_id": {"$ref": "#/$defs/token"},
        "material": {"$ref": "#/$defs/snapshot"},
        "provider": {
          "type": "object", "additionalProperties": false, "required": ["id", "version"],
          "properties": {"id": {"enum": ["openmaic", "deeptutor"]}, "version": {"enum": ["1.3.0", "1.7.1"]}}
        },
        "question": {
          "type": "object", "additionalProperties": false, "required": ["question_id", "question_version"],
          "properties": {
            "question_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_-]+$"},
            "question_version": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_.:-]+$"}
          }
        },
        "grant": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/snapshot"}]}
      },
      "oneOf": [
        {"properties": {"provider": {"properties": {"id": {"const": "openmaic"}, "version": {"const": "1.3.0"}}}, "grant": {"type": "null"}}},
        {"properties": {"provider": {"properties": {"id": {"const": "deeptutor"}, "version": {"const": "1.7.1"}}}, "grant": {"$ref": "#/$defs/snapshot"}}}
      ]
    },
    "start": {"type": "object", "additionalProperties": false, "required": ["attempt_id"], "properties": {"attempt_id": {"$ref": "#/$defs/token"}}},
    "submission": {
      "type": "object", "additionalProperties": false,
      "required": ["client_event_id", "answer", "provider_correct", "self_report", "rating"],
      "properties": {
        "client_event_id": {"$ref": "#/$defs/token"},
        "answer": {"type": "string", "maxLength": 20000, "description": "Core also enforces a 20000-byte UTF-8 limit."},
        "provider_correct": {"type": ["boolean", "null"], "description": "Must be null for a locally played OpenMAIC course. DeepTutor values remain unverified client reports."},
        "self_report": {"type": "boolean"},
        "rating": {"enum": ["again", "hard", "good", "easy", null]}
      }
    },
    "cancel": {"type": "object", "additionalProperties": false, "required": ["client_cancel_id"], "properties": {"client_cancel_id": {"$ref": "#/$defs/token"}}}
  }
}
