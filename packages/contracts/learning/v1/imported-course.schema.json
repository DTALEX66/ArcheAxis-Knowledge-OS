{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archeaxis.local/contracts/learning/v1/imported-course.schema.json",
  "title": "External unverified course candidate saved in a Core Document",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "status", "grounding", "human_review_required", "title", "scenes", "report", "provenance"],
  "properties": {
    "schema": {"const": "archeaxis.imported-course/v1"},
    "status": {"const": "candidate"},
    "grounding": {"const": "external_unverified"},
    "human_review_required": {"const": true},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "report": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "maxLength": 1000}},
    "scenes": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/scene"}},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "upstream_commit", "file_name", "source_id", "sha256", "byte_length"],
      "properties": {
        "adapter": {"const": "openmaic-manifest/v1"},
        "upstream_commit": {"const": "6b83751a87896df99c47e98c20cea40cec09efb4"},
        "file_name": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[^\\u0000-\\u001f/\\\\]+$"},
        "source_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 262144}
      }
    }
  },
  "$defs": {
    "scene": {
      "type": "object", "additionalProperties": false, "required": ["title", "order", "questions"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 240},
        "order": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "questions": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/question"}}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "question"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "type": {"enum": ["single", "multiple", "short_answer"]},
        "question": {"type": "string", "minLength": 1, "maxLength": 16000},
        "options": {"type": "array", "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false, "required": ["label", "value"],
          "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 4000}, "value": {"type": "string", "minLength": 1, "maxLength": 512}}
        }},
        "answer": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 16000}},
        "analysis": {"type": "string", "maxLength": 16000},
        "commentPrompt": {"type": "string", "maxLength": 16000},
        "hasAnswer": {"type": "boolean"},
        "points": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  },
  "$comment": "Structural envelope only. The adapter additionally enforces total question budget, unique scene order and per-scene question IDs, valid answer references, original SHA/bytes and complete readback. Ordinary Core Document storage preserves attrs; it does not promote the external content into accepted knowledge."
}
