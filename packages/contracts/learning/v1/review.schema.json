{
  "$id": "archeaxis.learning-review/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Core-owned FSRS review request",
  "description": "POST /api/v1/learning/reviews. Human identity required. Core loads and appends the card state; callers cannot supply authoritative schedule state. Committed retries replay their receipt without running the scheduler again. The separate legacy /learning/events path reports its request identity scope explicitly.",
  "type": "object",
  "additionalProperties": false,
  "required": ["item_key", "client_event_id", "correct"],
  "properties": {
    "item_key": {"type": "string", "pattern": "\\S"},
    "client_event_id": {"type": "string", "pattern": "\\S"},
    "correct": {"type": "boolean"},
    "rating": {"type": ["integer", "null"], "minimum": 1, "maximum": 4},
    "schedule_reset": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["mode", "reason", "expected_latest_event_id"],
      "properties": {
        "mode": {"const": "start_new"},
        "reason": {"type": "string", "pattern": "\\S", "maxLength": 512},
        "expected_latest_event_id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "now": {
      "type": ["string", "null"],
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "answer": {"type": ["string", "null"], "pattern": "\\S"},
    "assessment_id": {"type": ["string", "null"], "pattern": "\\S"},
    "question_version": {"type": ["string", "null"]},
    "knowledge_version": {"type": ["string", "null"]},
    "exposure_id": {"type": ["string", "null"]},
    "assist_strategy": {"type": ["string", "null"]},
    "rating_version": {"type": ["string", "null"]},
    "correction_id": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {
        "required": ["answer"],
        "properties": {"answer": {"type": "string"}}
      },
      "then": {"required": ["assessment_id"]}
    }
  ],
  "if": {"properties": {"correct": {"const": true}}},
  "then": {"properties": {"rating": {"enum": [2, 3, 4, null]}}},
  "else": {"properties": {"rating": {"enum": [1, null]}}}
}
