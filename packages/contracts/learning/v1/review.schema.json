{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Core-owned FSRS review request",
  "description": "POST /api/v1/learning/reviews. Human identity required. Core loads and appends the card state; callers cannot supply authoritative schedule state. The legacy /learning/events endpoint retains its original receipt contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["item_key", "client_event_id", "correct"],
  "properties": {
    "item_key": {"type": "string", "pattern": "\\S"},
    "client_event_id": {"type": "string", "pattern": "\\S"},
    "correct": {"type": "boolean"},
    "rating": {"type": ["integer", "null"], "minimum": 1, "maximum": 4},
    "now": {
      "type": ["string", "null"],
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "if": {"properties": {"correct": {"const": true}}},
  "then": {"properties": {"rating": {"enum": [2, 3, 4, null]}}},
  "else": {"properties": {"rating": {"enum": [1, null]}}}
}
