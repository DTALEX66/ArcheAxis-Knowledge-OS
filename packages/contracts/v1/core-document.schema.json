      },
      "required": [
        "source_id",
        "source_revision",
        "sha256",
        "original_name",
        "imported_at"
      ],
      "additionalProperties": true
    },
    "OriginalDto": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "content_base64": {
          "type": "string"
