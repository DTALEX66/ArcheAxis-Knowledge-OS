      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceDto"
          }
        }
      },
      "required": [
        "sources"
      ],
      "additionalProperties": true
    },
    "SourceListDto": {
      "$ref": "#/$defs/SourcesListDto"
    },
    "DocumentsListDto": {
      "type": "object",
      "properties": {
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
