        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocumentSummaryDto"
          }
        }
      },
      "required": [
        "documents",
        "next_cursor",
        "snapshot_count"
      ],
      "additionalProperties": true
    },
    "DocumentListDto": {
      "$ref": "#/$defs/DocumentsListDto"
    },
    "AnchorsListDto": {
      "type": "object",
      "properties": {
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnchorDto"
          }
        }
      },
      "required": [
        "anchors"
      ],
      "additionalProperties": true
    },
