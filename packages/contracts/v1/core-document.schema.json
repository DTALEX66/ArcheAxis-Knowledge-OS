        "kind": {
          "type": "string"
        },
        "ordinal": {
          "type": "integer"
        },
        "node_json": {},
        "text_projection": {
          "type": "string"
        },
        "codec_status": {
          "enum": [
            "known",
            "preserved_unknown"
          ]
        }
      },
      "required": [
        "block_id",
        "kind",
        "ordinal",
        "node_json",
        "text_projection",
        "codec_status"
      ],
      "additionalProperties": true
    },
    "DocumentDto": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string"
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "editor_json": {},
        "text_projection": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BlockDto"
          }
        },
        "revision_basis": {}
      },
      "required": [
        "document_id",
        "source_id",
        "source_revision",
        "title",
        "version",
        "editor_json",
        "text_projection",
        "content_sha256",
        "blocks"
