        "transform_count": {
          "type": "integer"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocumentSearchDto"
          }
        },
        "document_count": {
          "type": "integer"
        }
      },
      "required": [
        "items",
        "transforms",
        "count",
        "transform_count"
      ],
      "additionalProperties": true
