      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "knowledge_id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "head": {
                "type": "string"
              },
              "active": {
                "type": "boolean"
              }
