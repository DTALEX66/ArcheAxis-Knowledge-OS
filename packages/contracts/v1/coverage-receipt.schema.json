{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archeaxis.local/contracts/v1/coverage-receipt.schema.json",
  "title": "ArcheAxis Verification Coverage Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "receipt_id", "run_id", "claim_revision_id", "scope",
    "providers", "dedup", "coverage", "assessment", "reproducibility",
    "stop", "receipt_payload_sha256"
  ],
  "properties": {
    "schema": {"const": "archeaxis.coverage-receipt/v1"},
    "receipt_id": {"type": "string"},
    "run_id": {"type": "string"},
    "claim_revision_id": {"type": "string"},
    "supersedes_receipt_id": {"type": ["string", "null"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "languages", "query_families", "required_source_roles"],
      "properties": {
        "question": {"type": "string", "minLength": 1},
        "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "time_window": {"type": "object"},
        "jurisdictions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "query_families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "required_source_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider_id", "index_family", "queries", "returned", "retrieved", "blocked", "failed"],
        "properties": {
          "provider_id": {"type": "string"},
          "index_family": {"type": "string"},
          "queries": {"type": "integer", "minimum": 0},
          "returned": {"type": "integer", "minimum": 0},
          "retrieved": {"type": "integer", "minimum": 0},
          "blocked": {"type": "integer", "minimum": 0},
          "failed": {"type": "integer", "minimum": 0}
        }
      }
    },
    "dedup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_results", "canonical_urls", "document_clusters", "assertion_origin_groups", "evidence_generation_groups", "independence_unknown"],
      "properties": {
        "raw_results": {"type": "integer", "minimum": 0},
        "canonical_urls": {"type": "integer", "minimum": 0},
        "document_clusters": {"type": "integer", "minimum": 0},
        "assertion_origin_groups": {"type": "integer", "minimum": 0},
        "evidence_generation_groups": {"type": "integer", "minimum": 0},
        "independence_unknown": {"type": "integer", "minimum": 0}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "planned_query_families", "executed_query_families", "primary_candidates_found", "primary_sources_retrieved", "contradiction_search_executed", "earliest_origin_checked", "inaccessible_sources", "unresolved_gaps"],
      "properties": {
        "status": {"enum": ["PLANNED_COMPLETE", "PARTIAL", "INSUFFICIENT"]},
        "planned_query_families": {"type": "integer", "minimum": 0},
        "executed_query_families": {"type": "integer", "minimum": 0},
        "primary_candidates_found": {"type": "integer", "minimum": 0},
        "primary_sources_retrieved": {"type": "integer", "minimum": 0},
        "contradiction_search_executed": {"type": "boolean"},
        "earliest_origin_checked": {"type": "boolean"},
        "inaccessible_sources": {"type": "array", "items": {"type": "string"}},
        "unresolved_gaps": {"type": "array", "items": {"type": "string"}}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_status", "test_status", "rumor_status", "forecast_status", "human_review_required", "rationale"],
      "properties": {
        "evidence_status": {"$ref": "assessment-vocabulary.schema.json#/$defs/evidence_status"},
        "test_status": {"$ref": "assessment-vocabulary.schema.json#/$defs/test_status"},
        "rumor_status": {"$ref": "assessment-vocabulary.schema.json#/$defs/rumor_status"},
        "forecast_status": {"$ref": "assessment-vocabulary.schema.json#/$defs/forecast_status"},
        "human_review_required": {"type": "boolean"},
        "rationale": {"type": "string"}
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_plan_sha256", "provider_registry_version", "dedup_profile_version", "extractor_version", "model_id", "prompt_sha256", "schema_version", "snapshot_sha256"],
      "properties": {
        "query_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provider_registry_version": {"type": "string"},
        "dedup_profile_version": {"type": "string"},
        "extractor_version": {"type": "string"},
        "model_id": {"type": "string"},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_version": {"type": "string"},
        "snapshot_sha256": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "stopped_at"],
      "properties": {
        "reason": {"enum": ["SUFFICIENT", "DIMINISHING_RETURNS", "BUDGET", "TIMEOUT", "BLOCKED"]},
        "stopped_at": {"type": "string", "format": "date-time"}
      }
    },
    "receipt_payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of RFC 8785 canonical JSON after removing this field; never a self-hash."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "coverage": {
            "properties": {"status": {"const": "PLANNED_COMPLETE"}},
            "required": ["status"]
          }
        },
        "required": ["coverage"]
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "executed_query_families": {"minimum": 1},
              "contradiction_search_executed": {"const": true},
              "earliest_origin_checked": {"const": true},
              "unresolved_gaps": {"maxItems": 0}
            }
          }
        }
      }
    }
  ]
}
